# Cron (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# AiSensy WhatsApp (WHATSAPP_API_* deprecated — unused)
AISENSY_API_KEY=
AISENSY_CAMPAIGN_CHECKIN_DUE=
AISENSY_CAMPAIGN_MISSED_CHECKIN=
AISENSY_CAMPAIGN_PLAN_READY=
AISENSY_CAMPAIGN_COACH_REPLIED=
AISENSY_CAMPAIGN_ACCOUNT_SETUP=
AISENSY_CAMPAIGN_ONBOARDING_REMINDER=
# Membership renewals — template vars: firstName, endsLabel, daysRemaining, renewUrl
AISENSY_CAMPAIGN_MEMBERSHIP_RENEWAL=

# Transactional email (server only)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
# Where storefront consultation form submissions are emailed (defaults to piyushfitness44@gmail.com)
TALK_TO_COACH_NOTIFY_EMAIL=
# Where affiliate / partner code conversions are emailed (falls back to TALK_TO_COACH_NOTIFY_EMAIL)
AFFILIATE_NOTIFY_EMAIL=

# Public storefront demo (/try). Server-only password for public-demo@trial.test.local
PUBLIC_DEMO_CLIENT_PASSWORD=

# Canonical app URL used in recovery/reminder links
NEXT_PUBLIC_APP_URL=

# Meta Conversions API (server only; pixel ID may match the public browser pixel)
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_CONVERSIONS_API_VERSION=v22.0

# Anthropic rollback only (server only). Production uses OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_FALLBACK_MODEL=
ANTHROPIC_MAX_ATTEMPTS=3

# OpenAI (server only) — production plan generation
OPENAI_API_KEY=
OPENAI_MODEL_TERRA=gpt-5.6-terra
OPENAI_MODEL_LUNA=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-luna
OPENAI_MAX_ATTEMPTS=2
AI_PLAN_PROVIDER=openai

# Meta Pixel (public browser-side ID)
NEXT_PUBLIC_META_PIXEL_ID=

# Server-only salt for one-way checkout acknowledgement IP hashes.
# Generate a long random value; never prefix with NEXT_PUBLIC_.
POLICY_ACK_IP_SALT=

# First-timer checkout discount code (default WELCOME).
# Offers ₹200 / ₹300 / ₹400 off 3 / 6 / 12 month plans for emails with no prior purchase.
FIRST_TIMER_DISCOUNT_CODE=WELCOME

# MuscleWiki paid API key (server only). Used to show form videos/cues in the
# client workout tracker. Never used for plan generation. Leave blank to hide
# demos; clients still see coach notes.
MUSCLEWIKI_API_KEY=

# Fitbit Web API (server only). Leave blank to keep Fitbit as a manual import
# source. Register a redirect URI of {NEXT_PUBLIC_APP_URL}/api/wearables/fitbit/callback
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# LURVOX AI Marketing OS (server only — never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Meta Marketing API (Ads Manager). Required for live campaign sync/writes.
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
META_ADS_API_VERSION=v22.0
# Required to create Meta ad creatives (Facebook Page ID linked to the ad account)
META_ADS_PAGE_ID=
# Optional default destination URL for link ads (else funnel.landing_page)
META_ADS_DEFAULT_LINK_URL=https://www.lurvox.in
# Hard safety: even at autonomy 3/4, ACTIVE Meta spend/activation stays off until this is true.
# PAUSED creative + test object creation can still run after human approval when credentials exist.
LIVE_META_EXECUTION_ENABLED=false
# Instagram Login (organic Graph). Uses INSTAGRAM_ACCESS_TOKEN → graph.instagram.com.
# Do NOT reuse META_ADS_ACCESS_TOKEN here — Ads stay on META_ADS_* / graph.facebook.com.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Optional API version override (defaults to META_ADS_API_VERSION or v22.0)
# INSTAGRAM_API_VERSION=v22.0
# Hard safety: approved Instagram publish/delete still will not call Graph unless true.
LIVE_INSTAGRAM_PUBLISHING_ENABLED=false
# Optional image model override for static creatives
OPENAI_IMAGE_MODEL=gpt-image-1
# Optional future UGC/video providers
UGC_VIDEO_PROVIDER=
VIDEO_EDIT_PROVIDER=

# ---------------------------------------------------------------------------
# LURVOX JARVIS — AI Business Operator (server only)
# ---------------------------------------------------------------------------
JARVIS_DAILY_AI_BUDGET_USD=10
JARVIS_MONTHLY_AI_BUDGET_USD=200
JARVIS_PER_TASK_BUDGET_USD=1
JARVIS_PER_RESEARCH_BUDGET_USD=0.5
JARVIS_PER_CHAT_BUDGET_USD=0.75
JARVIS_MAX_TOKENS_PER_TASK=50000
JARVIS_MAX_SEARCHES_PER_RESEARCH=10
JARVIS_MAX_TOOL_CALLS_PER_TASK=12
JARVIS_AUTONOMY_ENABLED=true
JARVIS_BACKGROUND_ENABLED=true

# Phase 11 — Realtime voice (push-to-talk). OFF by default.
# OPENAI_API_KEY alone does NOT enable voice — set JARVIS_REALTIME_ENABLED=true explicitly.
# Provider: openai (Whisper STT + TTS) or mock (tests only).
JARVIS_REALTIME_ENABLED=false
JARVIS_REALTIME_PROVIDER=openai
JARVIS_REALTIME_MODEL=
JARVIS_REALTIME_TTS_MODEL=tts-1
JARVIS_REALTIME_MAX_SESSION_MINUTES=20
JARVIS_REALTIME_MAX_AUDIO_SECONDS=60
JARVIS_REALTIME_MAX_COST_USD=1

# Phase 12 — Controlled execution (safe defaults)
# Unset JARVIS_EXECUTION_ENABLED keeps approved writes working.
# Set JARVIS_EXECUTION_ENABLED=false OR JARVIS_EXECUTION_KILL_SWITCH=true to stop all external writes.
# JARVIS_EXECUTION_ENABLED=
JARVIS_EXECUTION_KILL_SWITCH=false
JARVIS_EXECUTION_MODE=approval
JARVIS_DRY_RUN=false
JARVIS_SHADOW_MODE=false
JARVIS_CANARY_MODE=false
JARVIS_SHOPIFY_WRITES_ENABLED=true
JARVIS_VIDEO_PUBLISH_ENABLED=false
JARVIS_MAX_AUTO_ACTION_COST_USD=0.5
JARVIS_MAX_AUTO_DAILY_ACTION_COST_USD=5
JARVIS_MAX_AUTO_MONTHLY_ACTION_COST_USD=50
JARVIS_MAX_AUTO_ACTIONS_PER_HOUR=20
JARVIS_MAX_AUTO_ACTIONS_PER_DAY=100
JARVIS_APPROVAL_TTL_HOURS=24
# Phase 13 — event storm caps (optional)
JARVIS_EVENTS_PER_MINUTE=30
JARVIS_EVENTS_PER_HOUR=200
JARVIS_EVENT_INVESTIGATIONS_PER_HOUR=20
# Live flags remain OFF unless explicitly enabled by an admin outside Jarvis:
# LIVE_META_EXECUTION_ENABLED=false
# LIVE_INSTAGRAM_PUBLISHING_ENABLED=false

# Optional research web search (otherwise synthesis uses memory + model only)
# Server-side only — do NOT prefix with NEXT_PUBLIC_
JARVIS_WEB_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
JARVIS_BRAVE_SEARCH_COST_USD=0.02
JARVIS_BRAVE_SEARCH_TIMEOUT_MS=12000
# Rough cost model for governor estimates
JARVIS_COST_PER_M_INPUT_TOKENS=2.5
JARVIS_COST_PER_M_OUTPUT_TOKENS=10

# Video editing — Shotstack (REAL) or stub/test
# VIDEO_EDIT_WEBHOOK_URL must be the Next.js app host (app.lurvox.in), NOT www.lurvox.in (Shopify).
VIDEO_EDIT_PROVIDER=stub
VIDEO_EDIT_WEBHOOK_URL=https://app.lurvox.in/api/admin/jarvis/video-webhook
VIDEO_EDIT_STATUS_URL=
VIDEO_EDIT_API_KEY=
# Quote if the value contains # $ & — otherwise dotenv truncates at #.
VIDEO_EDIT_WEBHOOK_SECRET=
SHOTSTACK_ENV=v1
SHOTSTACK_COST_PER_MINUTE_USD=0.35

# Video intelligence (Phase 4) — separate from Shotstack render
# auto | stub | test | shotstack | openai
VIDEO_INTELLIGENCE_PROVIDER=auto
# off | openai — Whisper only when explicitly enabled (costs money)
VIDEO_INTELLIGENCE_TRANSCRIPTION=off
# true enables optional LLM segment classification when OPENAI_API_KEY is set
VIDEO_INTELLIGENCE_LLM_CLASSIFY=false

# Shopify Admin API — client credentials (server only, never NEXT_PUBLIC_)
SHOPIFY_SHOP=9uwyq1-0j
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
