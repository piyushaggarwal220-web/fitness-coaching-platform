{%- comment -%} lurvox-carousel-fix lurvox-photo-carousel-autoplay-v3 2026-07-25T08:09:39.549Z {%- endcomment -%}
{% doc %}
  @prompt
    Create a premium horizontal member wins carousel.
    
    IMPORTANT:
    
    This is NOT a gallery.
    This is NOT a vertical stack.
    This is NOT a testimonial section.
    This is NOT a masonry layout.
    
    Create a compact horizontal carousel only.
    
    ━━━━━━━━━━━━━━
    
    Section height:
    420px maximum.
    
    Never exceed 420px.
    
    ━━━━━━━━━━━━━━
    
    Header row:
    
    Left side:
    
    REAL PEOPLE, REAL RESULTS
    
    Below:
    
    Member messages & reviews.
    
    Right side:
    
    Two premium circular arrows.
    
    Previous arrow.
    Next arrow.
    
    Arrow size:
    56px
    
    Transparent background.
    
    Border:
    1px solid rgba(255,255,255,0.12)
    
    ━━━━━━━━━━━━━━
    
    Carousel:
    
    Horizontal only.
    
    Show:
    
    1 full screenshot card
    
    plus
    
    15% of next card.
    
    Never stack cards vertically.
    
    Never create multiple rows.
    
    Never create a grid.
    
    ━━━━━━━━━━━━━━
    
    Cards:
    
    White background.
    
    Border radius:
    28px
    
    Thin border:
    1px solid rgba(255,255,255,0.08)
    
    Padding:
    0px
    
    Overflow hidden.
    
    ━━━━━━━━━━━━━━
    
    Images:
    
    Screenshots themselves are the content.
    
    No captions.
    
    No descriptions.
    
    No avatars.
    
    No labels.
    
    No text blocks.
    
    No placeholders.
    
    No upload containers.
    
    No white frames around screenshots.
    
    Image fills card directly.
    
    Use:
    
    object-fit: contain;
    width: 100%;
    height: 100%;
    
    ━━━━━━━━━━━━━━
    
    Section style:
    
    Background:
    #050505
    
    Thin premium border:
    1px solid rgba(255,255,255,0.06)
    
    Border radius:
    32px
    
    Padding:
    24px
    
    No shadows.
    
    No gradients.
    
    No glow.
    
    ━━━━━━━━━━━━━━
    
    Visual inspiration:
    
    Premium SaaS testimonial carousel.
    Apple editorial cards.
    Stripe customer stories.
    
    The result must feel compact, premium and horizontally scrollable.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-member-wins-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    max-height: 420px;
  }

  .ai-member-wins-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
    gap: 16px;
  }

  .ai-member-wins-header-text-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-member-wins-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 4px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-member-wins-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
  }

  .ai-member-wins-nav-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }

  .ai-member-wins-nav-button-{{ ai_gen_id }} {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    border-radius: 50%;
    background-color: transparent;
    border: 1px solid {{ block.settings.arrow_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .ai-member-wins-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_bg }};
    border-color: {{ block.settings.arrow_hover_border }};
  }

  .ai-member-wins-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-member-wins-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.arrow_color }};
    stroke-width: 2;
  }

  .ai-member-wins-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-member-wins-carousel-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-member-wins-carousel-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-member-wins-card-{{ ai_gen_id }} {
    flex: 0 0 calc(100% - 15%);
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    border: 1px solid {{ block.settings.card_border_color }};
    overflow: hidden;
    padding: 0;
    height: 300px;
  }

  .ai-member-wins-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ai-member-wins-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-member-wins-card-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-member-wins-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #999;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-member-wins-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-member-wins-header-{{ ai_gen_id }} {
      margin-bottom: 16px;
    }

    .ai-member-wins-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-member-wins-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-member-wins-nav-button-{{ ai_gen_id }} {
      width: {{ block.settings.arrow_size | times: 0.8 }}px;
      height: {{ block.settings.arrow_size | times: 0.8 }}px;
    }

    .ai-member-wins-card-{{ ai_gen_id }} {
      height: 250px;
    }
  }
{% endstyle %}

<member-wins-carousel-{{ ai_gen_id }} class="ai-member-wins-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-member-wins-header-{{ ai_gen_id }}">
    <div class="ai-member-wins-header-text-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-member-wins-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-member-wins-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
    <div class="ai-member-wins-nav-{{ ai_gen_id }}">
      <button
        class="ai-member-wins-nav-button-{{ ai_gen_id }} ai-member-wins-prev-{{ ai_gen_id }}"
        aria-label="Previous"
        data-direction="prev"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="ai-member-wins-nav-button-{{ ai_gen_id }} ai-member-wins-next-{{ ai_gen_id }}"
        aria-label="Next"
        data-direction="next"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <div class="ai-member-wins-carousel-wrapper-{{ ai_gen_id }}">
    <div class="ai-member-wins-carousel-{{ ai_gen_id }}">
      {% assign member_wins_count = 0 %}
      {% for i in (1..25) %}
        {% liquid
          assign image_key = 'screenshot_' | append: i
          assign screenshot = block.settings[image_key]
        %}
        {% if screenshot != blank %}
          {% assign member_wins_count = member_wins_count | plus: 1 %}
          <div class="ai-member-wins-card-{{ ai_gen_id }}">
            <img
              src="{{ screenshot | image_url: width: 800 }}"
              alt="{{ screenshot.alt | escape }}"
              loading="lazy"
              width="{{ screenshot.width }}"
              height="{{ screenshot.height }}"
              class="ai-member-wins-card-image-{{ ai_gen_id }}"
            >
          </div>
        {% endif %}
      {% endfor %}
      {% if member_wins_count == 0 %}
        <div class="ai-member-wins-card-{{ ai_gen_id }}">
          <div class="ai-member-wins-card-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-member-wins-empty-state-{{ ai_gen_id }}">
              Add member screenshots
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</member-wins-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class MemberWinsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.carousel = this.querySelector('.ai-member-wins-carousel-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-member-wins-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-member-wins-next-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-member-wins-card-{{ ai_gen_id }}');

        if (!this.carousel || !this.prevButton || !this.nextButton) return;

        this.setupEventListeners();
        this.updateButtonStates();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => {
          this.scroll('prev');
        });
        this.nextButton.addEventListener('click', () => {
          this.scroll('next');
        });
        this.carousel.addEventListener('scroll', () => this.updateButtonStates());
      }

      scroll(direction) {
        if (!this.cards.length) return;
        const cardWidth = this.cards[0].offsetWidth;
        const gap = 16;
        const scrollAmount = cardWidth + gap;
        const maxScroll = this.carousel.scrollWidth - this.carousel.offsetWidth;

        if (direction === 'prev') {
          if (this.carousel.scrollLeft <= 1) {
            this.carousel.scrollTo({ left: maxScroll, behavior: 'smooth' });
          } else {
            this.carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
          }
        } else {
          if (this.carousel.scrollLeft + this.carousel.offsetWidth >= this.carousel.scrollWidth - 2) {
            this.carousel.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            this.carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
          }
        }
      }

      updateButtonStates() {
        const isAtStart = this.carousel.scrollLeft <= 0;
        const isAtEnd = this.carousel.scrollLeft + this.carousel.offsetWidth >= this.carousel.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }, this._autoplayMs);
      }
      }
      }, this._resumeMs);
      }

    }

    customElements.define('member-wins-carousel-{{ ai_gen_id }}', MemberWinsCarousel{{ ai_gen_id }});
  })();
</script>

