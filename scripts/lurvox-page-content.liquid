{% comment %} Simple readable page content for policy pages on dark theme {% endcomment %}
<section class="lurvox-page-content" style="padding: 48px 20px 80px; background: #050505; color: #f5f5f5;">
  <div style="max-width: 760px; margin: 0 auto; line-height: 1.65; font-size: 16px;">
    <h1 style="margin: 0 0 12px; font-size: clamp(1.75rem, 4vw, 2.25rem); color: #ffffff; letter-spacing: -0.02em;">
      {{ page.title }}
    </h1>
    <div class="lurvox-page-rte rte" style="color: #e8e8e8;">
      {{ page.content }}
    </div>
  </div>
</section>

<style>
  .lurvox-page-rte h1,
  .lurvox-page-rte h2,
  .lurvox-page-rte h3 { color: #ffffff !important; margin-top: 1.5em; }
  .lurvox-page-rte p,
  .lurvox-page-rte li { color: #e8e8e8 !important; }
  .lurvox-page-rte a { color: #ff6200 !important; }
  .lurvox-page-rte ul { padding-left: 1.25em; }
</style>

{% schema %}
{
  "name": "LURVOX page content",
  "settings": [],
  "presets": [{ "name": "LURVOX page content" }]
}
{% endschema %}
