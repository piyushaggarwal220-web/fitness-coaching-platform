</lurvox-premium-system-{{ ai_gen_id }}>

<script>
  (function() {
    class LurvoxPremiumSystem{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.cards = [];
        this.observer = null;
      }

      connectedCallback() {
        this.cards = Array.from(this.querySelectorAll('.lurvox-premium-card-{{ ai_gen_id }}'));
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.15
        };

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const card = entry.target;
              const index = parseInt(card.dataset.cardIndex);
              
              setTimeout(() => {
                card.classList.add('is-visible');
              }, index * 120);

              this.observer.unobserve(card);
            }
          });
        }, options);

        this.cards.forEach((card) => {
          this.observer.observe(card);
        });
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('lurvox-premium-system-{{ ai_gen_id }}', LurvoxPremiumSystem{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "LURVOX premium system",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_padding_mobile",
      "label": "Section padding mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_desktop",
      "label": "Section padding desktop",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "primary_text_color",
