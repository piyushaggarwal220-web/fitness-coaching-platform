{% doc %}
  @prompt
    KEEP THE EXISTING CONTENT, ICONS AND CARD STRUCTURE.
    
    DO NOT CHANGE THE COPY.
    
    ONLY UPGRADE THE VISUAL DESIGN, CONTAINERS, TYPOGRAPHY AND ANIMATIONS.
    
    ━━━━━━━━━━━━━━━━━━
    LURVOX PREMIUM SYSTEM SECTION
    ━━━━━━━━━━━━━━━━━━
    
    Design language must match the existing LURVOX website:
    
    Background:
    #050505
    
    Primary text:
    #FFFFFF
    
    Secondary text:
    rgba(255,255,255,0.72)
    
    Accent:
    #FF6200
    
    Glow:
    rgba(255,98,0,0.35)
    
    No gold.
    No beige.
    No luxury hotel styling.
    
    ━━━━━━━━━━━━━━━━━━
    PREMIUM CARD DESIGN
    ━━━━━━━━━━━━━━━━━━
    
    Each category card:
    
    - Border radius: 28px
    - Border:
    1px solid rgba(255,255,255,0.07)
    
    - Background:
    rgba(255,255,255,0.015)
    
    - Subtle illuminated top edge.
    - Slightly brighter corners.
    - Very soft orange ambient glow behind card.
    - Premium depth without heavy shadows.
    
    Think:
    
    Mercedes AMG interface modules.
    Apple product cards.
    Nike campaign landing pages.
    
    Cards must feel engineered rather than decorative.
    
    ━━━━━━━━━━━━━━━━━━
    PREMIUM DIVIDERS
    ━━━━━━━━━━━━━━━━━━
    
    Add premium dividers:
    
    - Between card header and content.
    - Between every checklist item.
    
    Divider style:
    
    linear gradient:
    transparent →
    rgba(255,255,255,0.08) →
    transparent
    
    1px height only.
    
    Very subtle.
    
    Visible only on close inspection.
    
    ━━━━━━━━━━━━━━━━━━
    TYPOGRAPHY
    ━━━━━━━━━━━━━━━━━━
    
    Category headings:
    
    - uppercase
    - increased letter spacing
    - premium athletic typography
    - slightly heavier weight
    
    Checklist titles:
    
    - semibold
    - tighter line height
    - single line whenever possible
    
    Descriptions:
    
    - lighter weight
    - softer opacity
    - maximum two lines
    
    Allow merchant settings for:
    
    - heading size
    - body size
    - letter spacing
    - card padding
    - divider opacity
    
    ━━━━━━━━━━━━━━━━━━
    ICON SYSTEM
    ━━━━━━━━━━━━━━━━━━
    
    Header icons:
    
    Place inside premium rounded square containers.
    
    Container:
    
    48px
    border radius 14px
    border:
    1px solid rgba(255,255,255,0.08)
    
    Soft orange glow on hover.
    
    Checklist icons:
    
    - soft glass circle
    - premium orange checkmark
    - subtle glow pulse
    
    Glow:
    
    rgba(255,98,0,0.25)
    
    No neon.
    
    No gaming effects.
    
    ━━━━━━━━━━━━━━━━━━
    MERCEDES STYLE ANIMATIONS
    ━━━━━━━━━━━━━━━━━━
    
    Whole section:
    
    opacity 0 → 1
    translateY 40px → 0
    
    Duration:
    900ms
    
    Easing:
    cubic-bezier(0.22,1,0.36,1)
    
    Cards reveal sequentially:
    
    120ms stagger delay.
    
    As each card enters viewport:
    
    - border becomes slightly brighter
    - glow intensity increases
    - icon fades in
    - divider lines animate from left to right
    
    Checklist items:
    
    opacity 0 → 1
    translateX -12px → 0
    
    Duration:
    500ms
    
    80ms stagger delay.
    
    Check icons:
    
    scale 0.92 → 1
    opacity 0 → 1
    
    Duration:
    450ms
    
    No bounce.
    No flashy transitions.
    No cheap ecommerce animations.
    
    ━━━━━━━━━━━━━━━━━━
    SCROLL EXPERIENCE
    ━━━━━━━━━━━━━━━━━━
    
    As user scrolls:
    
    - current visible card receives slightly stronger border
    - previous card softly fades back
    - glow subtly follows scroll progress
    
    Very subtle.
    
    Almost subconscious.
    
    ━━━━━━━━━━━━━━━━━━
    MOBILE FIRST
    ━━━━━━━━━━━━━━━━━━
    
    No clipping.
    
    No horizontal scrolling.
    
    No overlap.
    
    Maintain premium spacing while keeping section compact.
    
    Cards width:
    92-94%
    
    Consistent vertical rhythm between cards.
    
    ━━━━━━━━━━━━━━━━━━
    FINAL FEEL
    ━━━━━━━━━━━━━━━━━━
    
    Mercedes MBUX interface.
    AMG configurator modules.
    Apple product detail pages.
    Nike premium campaign pages.
    
    Minimal.
    Expensive.
    Technical.
    Confident.
    Engineered.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .lurvox-premium-system-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_mobile }}px 20px;
    opacity: 0;
    transform: translateY(40px);
    animation: lurvox-section-reveal-{{ ai_gen_id }} 900ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 200ms;
  }

  @keyframes lurvox-section-reveal-{{ ai_gen_id }} {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .lurvox-premium-system__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .lurvox-premium-system__cards-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.card_gap }}px;
  }

  .lurvox-premium-card-{{ ai_gen_id }} {
    position: relative;
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    width: {{ block.settings.card_width_mobile }}%;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(40px);
    transition: all 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lurvox-premium-card-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      {{ block.settings.card_top_edge_color }} 50%, 
      transparent 100%
    );
    opacity: 0.6;
    border-radius: {{ block.settings.card_border_radius }}px {{ block.settings.card_border_radius }}px 0 0;
  }

  .lurvox-premium-card-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle at center, {{ block.settings.card_glow_color }} 0%, transparent 70%);
    opacity: 0;
    z-index: -1;
    border-radius: {{ block.settings.card_border_radius }}px;
    transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .lurvox-premium-card-{{ ai_gen_id }}.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .lurvox-premium-card-{{ ai_gen_id }}.is-visible::after {
    opacity: 1;
  }

  .lurvox-premium-card-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.card_border_hover_color }};
  }

  .lurvox-premium-card-{{ ai_gen_id }}:hover::after {
    opacity: 1.4;
  }

  .lurvox-premium-card__header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .lurvox-premium-card__icon-container-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    border: 1px solid {{ block.settings.icon_border_color }};
    background: rgba(255, 255, 255, 0.02);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 450ms cubic-bezier(0.22, 1, 0.36, 1);
    opacity: 0;
    transform: scale(0.92);
  }

  .lurvox-premium-card-{{ ai_gen_id }}.is-visible .lurvox-premium-card__icon-container-{{ ai_gen_id }} {
    opacity: 1;
    transform: scale(1);
    transition-delay: 200ms;
  }

  .lurvox-premium-card__icon-container-{{ ai_gen_id }}:hover {
    box-shadow: 0 0 20px {{ block.settings.icon_glow_color }};
  }

  .lurvox-premium-card__icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    color: {{ block.settings.icon_color }};
  }

  .lurvox-premium-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.primary_text_color }};
    text-transform: uppercase;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    margin: 0;
    line-height: 1.2;
  }

  .lurvox-premium-divider-{{ ai_gen_id }} {
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      {{ block.settings.divider_color }} 50%, 
      transparent 100%
    );
    opacity: {{ block.settings.divider_opacity }};
    margin: {{ block.settings.divider_spacing }}px 0;
  }

  .lurvox-premium-card__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .lurvox-premium-checklist-item-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: {{ block.settings.checklist_item_padding }}px 0;
    opacity: 0;
    transform: translateX(-12px);
    transition: all 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lurvox-premium-card-{{ ai_gen_id }}.is-visible .lurvox-premium-checklist-item-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateX(0);
  }

  .lurvox-premium-checklist-item-{{ ai_gen_id }}:nth-child(1) { transition-delay: 300ms; }
  .lurvox-premium-checklist-item-{{ ai_gen_id }}:nth-child(3) { transition-delay: 380ms; }
  .lurvox-premium-checklist-item-{{ ai_gen_id }}:nth-child(5) { transition-delay: 540ms; }
  .lurvox-premium-checklist-item-{{ ai_gen_id }}:nth-child(7) { transition-delay: 620ms; }
  .lurvox-premium-checklist-item-{{ ai_gen_id }}:nth-child(9) { transition-delay: 700ms; }

  .lurvox-premium-check-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid {{ block.settings.check_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
    opacity: 0;
    transform: scale(0.92);
    transition: all 450ms cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 0 12px {{ block.settings.check_glow_color }};
  }

  .lurvox-premium-card-{{ ai_gen_id }}.is-visible .lurvox-premium-check-icon-{{ ai_gen_id }} {
    opacity: 1;
    transform: scale(1);
  }

  .lurvox-premium-check-icon-{{ ai_gen_id }} svg {
    width: 12px;
    height: 12px;
    color: {{ block.settings.accent_color }};
  }

  .lurvox-premium-checklist-text-{{ ai_gen_id }} {
    flex: 1;
  }

  .lurvox-premium-checklist-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.checklist_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.primary_text_color }};
    margin: 0 0 4px 0;
    line-height: 1.3;
  }

  .lurvox-premium-checklist-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.checklist_desc_size }}px;
    font-weight: 400;
    color: {{ block.settings.secondary_text_color }};
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .lurvox-premium-system-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_desktop }}px 40px;
    }

    .lurvox-premium-card-{{ ai_gen_id }} {
      width: {{ block.settings.card_width_desktop }}%;
    }
  }

  @media screen and (min-width: 990px) {
    .lurvox-premium-system__cards-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
      gap: {{ block.settings.card_gap }}px;
    }

    .lurvox-premium-card-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

