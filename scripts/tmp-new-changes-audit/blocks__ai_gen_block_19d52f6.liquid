      "id": "title_size",
      "label": "Title size",
      "min": 24,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
