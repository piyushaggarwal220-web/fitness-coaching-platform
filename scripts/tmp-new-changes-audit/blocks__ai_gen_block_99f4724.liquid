{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-lurvox-comparison-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 900ms cubic-bezier(0.22,1,0.36,1), transform 900ms cubic-bezier(0.22,1,0.36,1);
  }

  .ai-lurvox-comparison-{{ ai_gen_id }}.ai-active {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-lurvox-master-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    background: rgba(255,255,255,0.015);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: {{ block.settings.container_radius }}px;
    padding: {{ block.settings.container_padding_top }}px {{ block.settings.container_padding_horizontal }}px {{ block.settings.container_padding_bottom }}px;
    box-shadow: 0 0 {{ block.settings.ambient_glow_size }}px rgba(255,98,0,{{ block.settings.ambient_glow_opacity }});
    position: relative;
    overflow: hidden;
    {% if block.settings.enable_backdrop_blur %}
      backdrop-filter: blur({{ block.settings.backdrop_blur }}px);
      -webkit-backdrop-filter: blur({{ block.settings.backdrop_blur }}px);
    {% endif %}
  }

  .ai-lurvox-master-container-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(180deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0) 100%);
    pointer-events: none;
    opacity: {{ block.settings.inner_glow_opacity }};
  }

  .ai-lurvox-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_bottom_spacing }}px;
    position: relative;
    z-index: 1;
  }

  .ai-lurvox-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    line-height: {{ block.settings.headline_line_height }};
    letter-spacing: -0.02em;
    font-weight: {{ block.settings.headline_weight }};
    color: {{ block.settings.primary_text }};
    margin: 0 0 {{ block.settings.headline_bottom_spacing }}px;
    text-transform: {{ block.settings.headline_transform }};
  }

  .ai-lurvox-subheadline-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheadline_size }}px;
    line-height: {{ block.settings.subheadline_line_height }};
    letter-spacing: 0;
    font-weight: {{ block.settings.subheadline_weight }};
    color: {{ block.settings.secondary_text }};
    margin: 0;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-lurvox-column-labels-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr {{ block.settings.indicator_column_width }}px {{ block.settings.indicator_column_width }}px;
    gap: {{ block.settings.column_gap }}px;
    padding: 0 {{ block.settings.row_padding_horizontal }}px {{ block.settings.column_labels_spacing }}px;
    position: relative;
    z-index: 1;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding-bottom: {{ block.settings.column_labels_spacing }}px;
    margin-bottom: {{ block.settings.column_labels_spacing }}px;
  }

  .ai-lurvox-column-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_label_size }}px;
    font-weight: {{ block.settings.column_label_weight }};
    letter-spacing: 0.12em;
    text-transform: {{ block.settings.column_label_transform }};
    color: {{ block.settings.primary_text }};
    opacity: 0.7;
    text-align: center;
  }

  .ai-lurvox-column-label-{{ ai_gen_id }}:first-child {
    text-align: left;
  }

  .ai-lurvox-rows-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
    z-index: 1;
  }

  .ai-lurvox-row-card-{{ ai_gen_id }} {
    background: {{ block.settings.row_background }};
    border: 1px solid {{ block.settings.row_border }};
    border-radius: {{ block.settings.row_radius }}px;
    padding: {{ block.settings.row_padding_vertical }}px {{ block.settings.row_padding_horizontal }}px;
    display: grid;
    grid-template-columns: 1fr {{ block.settings.indicator_column_width }}px {{ block.settings.indicator_column_width }}px;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
    opacity: 0;
    transform: translateY(12px);
    transition: all 600ms cubic-bezier(0.22,1,0.36,1);
    position: relative;
    overflow: hidden;
  }

  .ai-lurvox-row-card-{{ ai_gen_id }}.ai-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-lurvox-row-card-{{ ai_gen_id }}.ai-visible::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, transparent 0%, rgba(255,98,0,0.4) 50%, transparent 100%);
    opacity: 0;
    transition: opacity 600ms cubic-bezier(0.22,1,0.36,1);
  }

  {% if block.settings.enable_row_hover %}
    .ai-lurvox-row-card-{{ ai_gen_id }}:hover {
      background: {{ block.settings.row_hover_background }};
      border-color: {{ block.settings.row_hover_border }};
      transform: translateY(-1px);
    }

    .ai-lurvox-row-card-{{ ai_gen_id }}:hover::after {
      opacity: 1;
    }
  {% endif %}

  .ai-lurvox-row-card-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0) 100%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms cubic-bezier(0.22,1,0.36,1);
  }

  .ai-lurvox-row-card-{{ ai_gen_id }}.ai-visible::before {
    opacity: 1;
  }

  .ai-lurvox-feature-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.title_desc_gap }}px;
  }

  .ai-lurvox-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_title_size }}px;
    line-height: {{ block.settings.feature_title_line_height }};
    letter-spacing: -0.01em;
    font-weight: {{ block.settings.feature_title_weight }};
    color: {{ block.settings.primary_text }};
    margin: 0;
    transition: color 600ms cubic-bezier(0.22,1,0.36,1);
  }

  .ai-lurvox-feature-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_desc_size }}px;
    line-height: 1.35;
    letter-spacing: 0;
    font-weight: {{ block.settings.feature_desc_weight }};
    color: rgba(255,255,255,0.68);
    margin: 0;
    transition: color 600ms cubic-bezier(0.22,1,0.36,1);
  }

  .ai-lurvox-indicator-cell-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-lurvox-indicator-{{ ai_gen_id }} {
    width: {{ block.settings.indicator_size }}px;
    height: {{ block.settings.indicator_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.9);
    transition: all 500ms cubic-bezier(0.22,1,0.36,1);
    position: relative;
  }

  .ai-lurvox-row-card-{{ ai_gen_id }}.ai-visible .ai-lurvox-indicator-{{ ai_gen_id }} {
    opacity: 1;
    transform: scale(1);
  }

  .ai-lurvox-indicator-lurvox-{{ ai_gen_id }} {
    background: rgba(255,98,0,0.08);
    border: 1px solid rgba(255,98,0,0.25);
    box-shadow: 
      0 0 18px rgba(255,98,0,0.25),
      0 0 32px rgba(255,98,0,0.12);
  }

  .ai-lurvox-indicator-lurvox-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(255,98,0,0.15) 0%, transparent 60%);
    pointer-events: none;
  }

  .ai-lurvox-row-card-{{ ai_gen_id }}.ai-visible .ai-lurvox-indicator-lurvox-{{ ai_gen_id }} {
    box-shadow: 
      0 0 22px rgba(255,98,0,0.3),
      0 0 38px rgba(255,98,0,0.15);
  }

  {% if block.settings.enable_row_hover %}
    .ai-lurvox-row-card-{{ ai_gen_id }}:hover .ai-lurvox-indicator-lurvox-{{ ai_gen_id }} {
      box-shadow: 
        0 0 26px rgba(255,98,0,0.35),
        0 0 44px rgba(255,98,0,0.18);
      transform: translateY(-1px);
      background: rgba(255,98,0,0.1);
    }
  {% endif %}

  .ai-lurvox-indicator-others-{{ ai_gen_id }} {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 0 12px rgba(255,255,255,0.05);
  }

  .ai-lurvox-indicator-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.indicator_size }}px * 0.4);
    height: calc({{ block.settings.indicator_size }}px * 0.4);
    position: relative;
    z-index: 1;
  }

  .ai-lurvox-indicator-lurvox-{{ ai_gen_id }} svg {
    filter: drop-shadow(0 0 2px rgba(255,98,0,0.4));
  }

  .ai-lurvox-row-card-{{ ai_gen_id }}.ai-visible .ai-lurvox-indicator-lurvox-{{ ai_gen_id }} svg {
    filter: drop-shadow(0 0 3px rgba(255,98,0,0.5));
  }

  .ai-lurvox-divider-{{ ai_gen_id }} {
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.08) 50%, transparent 100%);
    margin: {{ block.settings.divider_spacing }}px 0;
    opacity: 0;
    transition: opacity 600ms cubic-bezier(0.22,1,0.36,1);
  }

  .ai-lurvox-divider-{{ ai_gen_id }}.ai-visible {
    opacity: {{ block.settings.divider_opacity }};
  }

  @media screen and (max-width: 749px) {
    .ai-lurvox-comparison-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.5 }}px {{ block.settings.section_padding_horizontal | times: 0.6 }}px {{ block.settings.section_padding_bottom | times: 0.5 }}px;
    }

    .ai-lurvox-master-container-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding_top | times: 0.6 }}px {{ block.settings.container_padding_horizontal | times: 0.6 }}px {{ block.settings.container_padding_bottom | times: 0.6 }}px;
    }

    .ai-lurvox-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.55 }}px;
    }

    .ai-lurvox-subheadline-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheadline_size | times: 0.85 }}px;
    }

    .ai-lurvox-column-labels-{{ ai_gen_id }} {
      grid-template-columns: 1fr {{ block.settings.indicator_column_width | times: 0.7 }}px {{ block.settings.indicator_column_width | times: 0.7 }}px;
      gap: {{ block.settings.column_gap | times: 0.6 }}px;
      padding: 0 {{ block.settings.row_padding_horizontal | times: 0.7 }}px {{ block.settings.column_labels_spacing | times: 0.7 }}px;
    }

    .ai-lurvox-column-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_label_size | times: 0.75 }}px;
    }

    .ai-lurvox-row-card-{{ ai_gen_id }} {
      grid-template-columns: 1fr {{ block.settings.indicator_column_width | times: 0.7 }}px {{ block.settings.indicator_column_width | times: 0.7 }}px;
      gap: {{ block.settings.column_gap | times: 0.6 }}px;
      padding: {{ block.settings.row_padding_vertical | times: 0.8 }}px {{ block.settings.row_padding_horizontal | times: 0.7 }}px;
    }

    .ai-lurvox-feature-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.feature_title_size | times: 0.85 }}px;
    }

    .ai-lurvox-feature-desc-{{ ai_gen_id }} {
      font-size: {{ block.settings.feature_desc_size | times: 0.85 }}px;
    }

    .ai-lurvox-indicator-{{ ai_gen_id }} {
      width: {{ block.settings.indicator_size | times: 0.75 }}px;
      height: {{ block.settings.indicator_size | times: 0.75 }}px;
    }

    .ai-lurvox-indicator-{{ ai_gen_id }} svg {
      width: calc({{ block.settings.indicator_size | times: 0.75 }}px * 0.4);
      height: calc({{ block.settings.indicator_size | times: 0.75 }}px * 0.4);
    }
  }
{% endstyle %}

<lurvox-comparison-section-{{ ai_gen_id }} class="ai-lurvox-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-lurvox-master-container-{{ ai_gen_id }}">
    <div class="ai-lurvox-header-{{ ai_gen_id }}">
      <h2 class="ai-lurvox-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      <p class="ai-lurvox-subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline }}</p>
    </div>

    <div class="ai-lurvox-column-labels-{{ ai_gen_id }}">
      <div class="ai-lurvox-column-label-{{ ai_gen_id }}">{{ block.settings.column_1_label }}</div>
      <div class="ai-lurvox-column-label-{{ ai_gen_id }}">{{ block.settings.column_2_label }}</div>
      <div class="ai-lurvox-column-label-{{ ai_gen_id }}">{{ block.settings.column_3_label }}</div>
    </div>

    <div class="ai-lurvox-rows-container-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        {% liquid
          assign title_key = 'feature_' | append: i | append: '_title'
          assign desc_key = 'feature_' | append: i | append: '_desc'
          assign feature_title = block.settings[title_key]
          assign feature_desc = block.settings[desc_key]
        %}

        {% if feature_title != blank %}
          {% unless forloop.first %}
            <div class="ai-lurvox-divider-{{ ai_gen_id }}" data-divider-index="{{ i }}"></div>
          {% endunless %}

          <div class="ai-lurvox-row-card-{{ ai_gen_id }}" data-index="{{ i }}">
            <div class="ai-lurvox-feature-content-{{ ai_gen_id }}">
              <div class="ai-lurvox-feature-title-{{ ai_gen_id }}">{{ feature_title }}</div>
              {% if feature_desc != blank %}
                <div class="ai-lurvox-feature-desc-{{ ai_gen_id }}">{{ feature_desc }}</div>
              {% endif %}
            </div>

            <div class="ai-lurvox-indicator-cell-{{ ai_gen_id }}">
              <div class="ai-lurvox-indicator-{{ ai_gen_id }} ai-lurvox-indicator-lurvox-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.accent_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
            </div>

            <div class="ai-lurvox-indicator-cell-{{ ai_gen_id }}">
              <div class="ai-lurvox-indicator-{{ ai_gen_id }} ai-lurvox-indicator-others-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.primary_text }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.55">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</lurvox-comparison-section-{{ ai_gen_id }}>

<script>
  (function() {
    class LurvoxComparisonSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.observer = null;
      }

      connectedCallback() {
        this.initIntersectionObserver();
      }

      initIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.1
        };

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              if (entry.target === this) {
                this.classList.add('ai-active');
                this.animateRows();
              }
            }
          });
        }, options);

        this.observer.observe(this);
      }

      animateRows() {
        const rows = this.querySelectorAll('.ai-lurvox-row-card-{{ ai_gen_id }}');
        const dividers = this.querySelectorAll('.ai-lurvox-divider-{{ ai_gen_id }}');
        
        rows.forEach((row, index) => {
          setTimeout(() => {
            row.classList.add('ai-visible');
            
            if (index > 0 && dividers[index - 1]) {
              dividers[index - 1].classList.add('ai-visible');
            }
          }, index * 60);
        });
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('lurvox-comparison-section-{{ ai_gen_id }}', LurvoxComparisonSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "LURVOX comparison",
  "settings": [
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "NOT COPY-PASTE. BUILT FROM YOUR PHOTOS BY A REAL COACH."
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Your plan is built around your physique, schedule and goals — not downloaded from the same template everyone else receives."
    },
    {
      "type": "range",
      "id": "headline_size",
      "label": "Size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "headline_line_height",
