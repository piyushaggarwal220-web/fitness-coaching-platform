{% doc %}
  @prompt
    Create a premium mobile-first CTA section placed directly below the FAQ section.
    
    SECTION WIDTH:
    92vw
    
    Max width:
    100%
    
    Background:
    #050505
    
    Card design:
    
    background:
    rgba(255,255,255,0.02)
    
    border:
    1px solid rgba(255,255,255,0.06)
    
    border radius:
    28px
    
    padding:
    28px
    
    overflow:
    hidden
    
    Add subtle premium shadow:
    0 20px 60px rgba(0,0,0,0.45)
    
    Add extremely subtle orange ambient glow behind the card only:
    rgba(255,98,0,0.03)
    
    No gradients.
    
    No glassmorphism overload.
    
    No gaming aesthetics.
    
    Atmosphere should feel premium and expensive.
    
    ━━━━━━━━━━━━━━
    
    HEADLINE
    
    Choose your LURVOX plan.
    
    Typography:
    
    Luxury editorial serif italic.
    
    Font size:
    34px
    
    Font weight:
    500
    
    Color:
    #FFFFFF
    
    Line height:
    1.15
    
    Letter spacing:
    -0.02em
    
    ━━━━━━━━━━━━━━
    
    SUBHEADLINE
    
    Checkout → questionnaire + photos → plan built within 24 hours.
    
    Typography:
    
    18px
    
    Weight:
    400
    
    Color:
    rgba(255,255,255,0.72)
    
    Line height:
    1.5
    
    Maximum width:
    90%
    
    ━━━━━━━━━━━━━━
    
    CTA BUTTON
    
    Text:
    
    CHOOSE YOUR PLAN
    
    Button width:
    100%
    
    Height:
    64px
    
    Border radius:
    999px
    
    Background:
    #EFE5DF
    
    Text color:
    #111111
    
    Font size:
    16px
    
    Font weight:
    800
    
    Letter spacing:
    0.18em
    
    Text transform:
    uppercase
    
    Add subtle shadow:
    0 10px 30px rgba(0,0,0,0.25)
    
    Hover state:
    
    background:
    #FFFFFF
    
    scale:
    1.02
    
    transition:
    300ms ease
    
    ━━━━━━━━━━━━━━
    
    SPACING
    
    Top padding:
    32px
    
    Bottom padding:
    32px
    
    Gap between headline and subheadline:
    16px
    
    Gap between subheadline and button:
    28px
    
    Everything must feel compact, premium and mobile first.
    
    Visual inspiration:
    
    Apple × Nike × Aman Resorts.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-cta-{{ ai_gen_id }} {
    display: block;
    width: 92vw;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-premium-cta-card-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.card_shadow }};
  }

  .ai-premium-cta-card-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ block.settings.ambient_glow }};
    pointer-events: none;
    z-index: 0;
  }

  .ai-premium-cta-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.headline_to_subheadline_gap }}px;
  }

  .ai-premium-cta-headline-{{ ai_gen_id }} {
    font-family: {{ block.settings.headline_font.family }}, {{ block.settings.headline_font.fallback_families }};
    font-weight: {{ block.settings.headline_font.weight }};
    font-style: {{ block.settings.headline_font.style }};
    font-size: {{ block.settings.headline_size }}px;
    line-height: {{ block.settings.headline_line_height }};
    letter-spacing: -0.02em;
    color: {{ block.settings.headline_color }};
    margin: 0;
  }

  .ai-premium-cta-subheadline-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.subheadline_to_button_gap }}px;
  }

  .ai-premium-cta-subheadline-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheadline_size }}px;
    font-weight: {{ block.settings.subheadline_weight }};
    line-height: {{ block.settings.subheadline_line_height }};
    color: {{ block.settings.subheadline_color }};
    max-width: {{ block.settings.subheadline_max_width }}%;
    margin: 0;
  }

  .ai-premium-cta-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: {{ block.settings.button_height }}px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: 0.18em;
    text-transform: {{ block.settings.button_text_transform }};
    text-decoration: none;
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    box-shadow: {{ block.settings.button_shadow }};
    cursor: pointer;
    transition: all {{ block.settings.button_transition_duration }}ms ease;
  }

  .ai-premium-cta-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
    transform: scale(1.02);
  }

  @media screen and (max-width: 749px) {
    .ai-premium-cta-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_width_percent }}%;
    }
  }
{% endstyle %}

<premium-cta-{{ ai_gen_id }} class="ai-premium-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-premium-cta-card-{{ ai_gen_id }}">
    <div class="ai-premium-cta-content-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-premium-cta-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      <div class="ai-premium-cta-subheadline-wrapper-{{ ai_gen_id }}">
        {% if block.settings.subheadline != blank %}
          <p class="ai-premium-cta-subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline }}</p>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-premium-cta-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</premium-cta-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumCta{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('premium-cta-{{ ai_gen_id }}', PremiumCta{{ ai_gen_id }});
  })();
</script>

