{% comment %}
  LURVOX — Book a free consultation call
  On-site form (name, phone, email, goal) + plan selection.
  Posts to app.lurvox.in API.
{% endcomment %}

{%- liquid
  assign accent = section.settings.accent_color | default: '#FF6200'
  assign heading = section.settings.heading | default: 'Book a free consultation call'
  assign subheading = section.settings.subheading | default: 'Tell us about yourself and which plan you’re considering. A coach will call you back — no payment required.'
  assign button_label = section.settings.button_label | default: 'Request free consultation call'
  assign api_url = section.settings.api_url | default: 'https://app.lurvox.in/api/public/talk-to-a-coach'

  assign p1_name = section.settings.plan_1_name | default: '3 Months'
  assign p1_price = section.settings.plan_1_price | default: '₹1,499'
  assign p1_meta = section.settings.plan_1_meta | default: '≈ ₹500/month'
  assign p1_badge = section.settings.plan_1_badge | default: ''

  assign p2_name = section.settings.plan_2_name | default: '6 Months'
  assign p2_price = section.settings.plan_2_price | default: '₹2,499'
  assign p2_meta = section.settings.plan_2_meta | default: '≈ ₹417/month · Most popular'
  assign p2_badge = section.settings.plan_2_badge | default: 'Popular'

  assign p3_name = section.settings.plan_3_name | default: '12 Months'
  assign p3_price = section.settings.plan_3_price | default: '₹3,999'
  assign p3_meta = section.settings.plan_3_meta | default: '≈ ₹333/month · Best value'
  assign p3_badge = section.settings.plan_3_badge | default: 'Best value'
-%}

<section
  class="lx-consult"
  id="lx-consult-{{ section.id }}"
  style="--lx-accent: {{ accent }};"
>
  <div class="lx-consult__bg" aria-hidden="true"></div>

  <div class="lx-consult__inner page-width">
    <header class="lx-consult__header">
      <p class="lx-consult__eyebrow">{{ section.settings.eyebrow | default: 'Free coach call' }}</p>
      <h1 class="lx-consult__title">{{ heading }}</h1>
      <p class="lx-consult__subtitle">{{ subheading }}</p>
    </header>

    <div class="lx-consult__grid">
      <div class="lx-consult__plans" role="group" aria-labelledby="lx-consult-plans-label-{{ section.id }}">
        <div class="lx-consult__plans-head">
          <h2 id="lx-consult-plans-label-{{ section.id }}">{{ section.settings.plans_heading | default: 'Choose a plan you’re interested in' }}</h2>
          <p>{{ section.settings.plans_note | default: 'You can change this on the call. Selecting a plan helps your coach prepare.' }}</p>
        </div>

        <div class="lx-consult__plan-list">
          <label class="lx-consult__plan">
            <input type="radio" name="lx-plan-{{ section.id }}" value="{{ p1_name }} — {{ p1_price }}" form="lx-consult-form-{{ section.id }}">
            <span class="lx-consult__plan-card">
              {% if p1_badge != blank %}<span class="lx-consult__badge">{{ p1_badge }}</span>{% endif %}
              <span class="lx-consult__plan-name">{{ p1_name }}</span>
              <span class="lx-consult__plan-price">{{ p1_price }}</span>
              <span class="lx-consult__plan-meta">{{ p1_meta }}</span>
            </span>
          </label>

          <label class="lx-consult__plan">
            <input type="radio" name="lx-plan-{{ section.id }}" value="{{ p2_name }} — {{ p2_price }}" form="lx-consult-form-{{ section.id }}" checked>
            <span class="lx-consult__plan-card is-featured">
              {% if p2_badge != blank %}<span class="lx-consult__badge is-featured">{{ p2_badge }}</span>{% endif %}
              <span class="lx-consult__plan-name">{{ p2_name }}</span>
              <span class="lx-consult__plan-price">{{ p2_price }}</span>
              <span class="lx-consult__plan-meta">{{ p2_meta }}</span>
            </span>
          </label>

          <label class="lx-consult__plan">
            <input type="radio" name="lx-plan-{{ section.id }}" value="{{ p3_name }} — {{ p3_price }}" form="lx-consult-form-{{ section.id }}">
            <span class="lx-consult__plan-card">
              {% if p3_badge != blank %}<span class="lx-consult__badge is-best">{{ p3_badge }}</span>{% endif %}
              <span class="lx-consult__plan-name">{{ p3_name }}</span>
              <span class="lx-consult__plan-price">{{ p3_price }}</span>
              <span class="lx-consult__plan-meta">{{ p3_meta }}</span>
            </span>
          </label>
        </div>
      </div>

      <form class="lx-consult__form" id="lx-consult-form-{{ section.id }}" novalidate>
        <h2 class="lx-consult__form-title">{{ section.settings.form_heading | default: 'Your details' }}</h2>

        <div class="lx-consult__field">
          <label for="lx-consult-name-{{ section.id }}">Name</label>
          <input
            id="lx-consult-name-{{ section.id }}"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Your full name"
          >
        </div>

        <div class="lx-consult__row">
          <div class="lx-consult__field">
            <label for="lx-consult-phone-{{ section.id }}">Phone / WhatsApp</label>
            <input
              id="lx-consult-phone-{{ section.id }}"
              name="phone"
              type="tel"
              required
              autocomplete="tel"
              placeholder="+91 98765 43210"
            >
          </div>
          <div class="lx-consult__field">
            <label for="lx-consult-email-{{ section.id }}">Email</label>
            <input
              id="lx-consult-email-{{ section.id }}"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@email.com"
            >
          </div>
        </div>

        <div class="lx-consult__field">
          <label for="lx-consult-goal-{{ section.id }}">Your goal</label>
          <textarea
            id="lx-consult-goal-{{ section.id }}"
            name="message"
            rows="4"
            required
            placeholder="e.g. Lose fat, build muscle, get consistent with training…"
          ></textarea>
        </div>

        <p class="lx-consult__status" id="lx-consult-status-{{ section.id }}" role="status" aria-live="polite"></p>

        <button type="submit" class="lx-consult__submit" id="lx-consult-submit-{{ section.id }}">
          {{ button_label }}
        </button>

        <p class="lx-consult__fineprint">
          {{ section.settings.fineprint | default: 'Free consultation · No payment on this page · A coach typically responds within a few hours' }}
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  body,
  #MainContent,
  .shopify-section.section-lx-consult {
    background: #000 !important;
  }

  #lx-consult-{{ section.id }} {
    --lx-ink: #f5f5f5;
    --lx-muted: rgba(245, 245, 245, 0.62);
    --lx-line: rgba(255, 255, 255, 0.12);
    --lx-surface: #141414;
    --lx-soft: #1a1a1a;
    --lx-field: #0a0a0a;
    position: relative;
    padding: clamp(40px, 6vw, 72px) 0 clamp(56px, 8vw, 96px);
    color: var(--lx-ink);
    background: #000;
    overflow: clip;
  }

  #lx-consult-{{ section.id }} .lx-consult__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 12% -10%, color-mix(in srgb, var(--lx-accent) 22%, transparent), transparent 60%),
      radial-gradient(ellipse 50% 40% at 100% 8%, rgba(255, 98, 0, 0.08), transparent 55%),
      #000;
    pointer-events: none;
  }

  #lx-consult-{{ section.id }} .lx-consult__inner {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding-inline: clamp(16px, 4vw, 24px);
  }

  #lx-consult-{{ section.id }} .lx-consult__header {
    max-width: 640px;
    margin: 0 0 clamp(28px, 4vw, 40px);
  }

  #lx-consult-{{ section.id }} .lx-consult__eyebrow {
    margin: 0 0 10px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lx-accent);
  }

  #lx-consult-{{ section.id }} .lx-consult__title {
    margin: 0 0 12px;
    font-size: clamp(1.85rem, 4.2vw, 2.65rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  #lx-consult-{{ section.id }} .lx-consult__subtitle {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--lx-muted);
  }

  #lx-consult-{{ section.id }} .lx-consult__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 3vw, 28px);
    align-items: start;
  }

  @media (min-width: 900px) {
    #lx-consult-{{ section.id }} .lx-consult__grid {
      grid-template-columns: 0.95fr 1.05fr;
      gap: 32px;
    }
  }

  #lx-consult-{{ section.id }} .lx-consult__plans,
  #lx-consult-{{ section.id }} .lx-consult__form {
    background: var(--lx-surface);
    border: 1px solid var(--lx-line);
    border-radius: 18px;
    padding: clamp(18px, 3vw, 28px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }

  #lx-consult-{{ section.id }} .lx-consult__plans-head h2,
  #lx-consult-{{ section.id }} .lx-consult__form-title {
    margin: 0 0 8px;
    font-size: 1.15rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  #lx-consult-{{ section.id }} .lx-consult__plans-head p {
    margin: 0 0 18px;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--lx-muted);
  }

  #lx-consult-{{ section.id }} .lx-consult__plan-list {
    display: grid;
    gap: 12px;
  }

  #lx-consult-{{ section.id }} .lx-consult__plan {
    display: block;
    cursor: pointer;
  }

  #lx-consult-{{ section.id }} .lx-consult__plan input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  #lx-consult-{{ section.id }} .lx-consult__plan-card {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 16px 16px 16px 18px;
    border: 1.5px solid var(--lx-line);
    border-radius: 14px;
    background: var(--lx-soft);
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease, background 0.18s ease;
  }

  #lx-consult-{{ section.id }} .lx-consult__plan input:checked + .lx-consult__plan-card,
  #lx-consult-{{ section.id }} .lx-consult__plan input:focus-visible + .lx-consult__plan-card {
    border-color: var(--lx-accent);
    background: #1f1f1f;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--lx-accent) 28%, transparent);
  }

  #lx-consult-{{ section.id }} .lx-consult__plan:hover .lx-consult__plan-card {
    transform: translateY(-1px);
  }

  #lx-consult-{{ section.id }} .lx-consult__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 4px 8px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.1);
    color: var(--lx-ink);
  }

  #lx-consult-{{ section.id }} .lx-consult__badge.is-featured {
    background: color-mix(in srgb, var(--lx-accent) 28%, #000);
    color: #fff;
  }

  #lx-consult-{{ section.id }} .lx-consult__badge.is-best {
    background: #f5f5f5;
    color: #0a0a0a;
  }

  #lx-consult-{{ section.id }} .lx-consult__plan-name {
    font-size: 0.95rem;
    font-weight: 650;
  }

  #lx-consult-{{ section.id }} .lx-consult__plan-price {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  #lx-consult-{{ section.id }} .lx-consult__plan-meta {
    font-size: 0.86rem;
    color: var(--lx-muted);
  }

  #lx-consult-{{ section.id }} .lx-consult__form {
    display: grid;
    gap: 14px;
  }

  #lx-consult-{{ section.id }} .lx-consult__row {
    display: grid;
    gap: 14px;
  }

  @media (min-width: 640px) {
    #lx-consult-{{ section.id }} .lx-consult__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  #lx-consult-{{ section.id }} .lx-consult__field {
    display: grid;
    gap: 6px;
  }

  #lx-consult-{{ section.id }} .lx-consult__field label {
    font-size: 0.86rem;
    font-weight: 650;
  }

  #lx-consult-{{ section.id }} .lx-consult__field input,
  #lx-consult-{{ section.id }} .lx-consult__field textarea {
    width: 100%;
    padding: 13px 14px;
    border: 1.5px solid var(--lx-line);
    border-radius: 12px;
    background: var(--lx-field);
    font-size: 16px;
    line-height: 1.4;
    color: var(--lx-ink);
    box-sizing: border-box;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  #lx-consult-{{ section.id }} .lx-consult__field input::placeholder,
  #lx-consult-{{ section.id }} .lx-consult__field textarea::placeholder {
    color: rgba(245, 245, 245, 0.38);
  }

  #lx-consult-{{ section.id }} .lx-consult__field input:focus,
  #lx-consult-{{ section.id }} .lx-consult__field textarea:focus {
    outline: none;
    border-color: var(--lx-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--lx-accent) 20%, transparent);
  }

  #lx-consult-{{ section.id }} .lx-consult__status {
    min-height: 1.25em;
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  #lx-consult-{{ section.id }} .lx-consult__status.is-error {
    color: #ff8a80;
  }

  #lx-consult-{{ section.id }} .lx-consult__status.is-success {
    color: #6ee7b7;
  }

  #lx-consult-{{ section.id }} .lx-consult__submit {
    appearance: none;
    border: none;
    border-radius: 12px;
    padding: 15px 20px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--lx-accent) 88%, #fff) 0%, var(--lx-accent) 100%);
    color: #fff;
    font-size: 1rem;
    font-weight: 750;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
    box-shadow: 0 10px 24px color-mix(in srgb, var(--lx-accent) 28%, transparent);
  }

  #lx-consult-{{ section.id }} .lx-consult__submit:hover {
    transform: translateY(-1px);
  }

  #lx-consult-{{ section.id }} .lx-consult__submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
  }

  #lx-consult-{{ section.id }} .lx-consult__fineprint {
    margin: 2px 0 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--lx-muted);
    text-align: center;
  }
</style>

<script>
  (function () {
    var form = document.getElementById('lx-consult-form-{{ section.id }}');
    if (!form) return;
    var statusEl = document.getElementById('lx-consult-status-{{ section.id }}');
    var submitBtn = document.getElementById('lx-consult-submit-{{ section.id }}');
    var apiUrl = {{ api_url | json }};
    var planName = 'lx-plan-{{ section.id }}';

    function setStatus(message, type) {
      if (!statusEl) return;
      statusEl.textContent = message || '';
      statusEl.className = 'lx-consult__status' + (type ? ' is-' + type : '');
    }

    function selectedPlan() {
      var checked = document.querySelector('input[name="' + planName + '"]:checked');
      return checked ? checked.value : '';
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      setStatus('', '');
      if (submitBtn) submitBtn.disabled = true;

      var goal = (form.message.value || '').trim();
      var plan = selectedPlan();
      var message = goal;
      if (plan) {
        message = goal + '\\n\\nInterested plan: ' + plan;
      }

      var payload = {
        name: form.name.value.trim(),
        email: form.email.value.trim(),
        phone: form.phone.value.trim(),
        message: message
      };

      fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(function (res) {
          return res.json().catch(function () { return null; }).then(function (data) {
            return { res: res, data: data };
          });
        })
        .then(function (_ref) {
          var res = _ref.res;
          var data = _ref.data;
          if (res.ok && data && data.ok) {
            setStatus('Thanks — we received your request. A coach will call you soon.', 'success');
            form.reset();
            var popular = document.querySelector('input[name="' + planName + '"][value*="6 Months"]');
            if (popular) popular.checked = true;
            return;
          }
          var err = (data && data.error) || 'Something went wrong. Please try again.';
          setStatus(err, 'error');
        })
        .catch(function () {
          setStatus('Network error. Please check your connection and try again.', 'error');
        })
        .finally(function () {
          if (submitBtn) submitBtn.disabled = false;
        });
    });
  })();
</script>

