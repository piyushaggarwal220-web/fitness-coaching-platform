        "ai_gen_block_66d8696_yVRepa": {
          "type": "ai_gen_block_66d8696",
          "settings": {
            "eyebrow": "FAQ",
            "headline": "Questions Before You Start",
            "subheadline": "Clear answers about coaching, what is included, and how the system works.",
            "headline_size_desktop": 34,
            "headline_size_mobile": 22,
            "headline_max_width": 280,
            "subheadline_size": 14,
            "header_spacing": 32,
            "container_background": "",
            "container_border_color": "#e15c0f",
            "container_border_hover_color": "",
            "container_border_width": 1,
            "container_radius": 28,
            "container_padding_mobile": 22,
            "container_padding_desktop": 36,
            "row_height": 54,
            "row_padding_horizontal": 10,
            "row_hover_background": "",
            "row_tap_background": "",
            "divider_color": "",
            "divider_width": 1,
            "question_size": 13,
            "question_weight": 700,
            "question_letter_spacing": 0.8,
            "question_color": "#ffffff",
            "question_hover_color": "#ff6200",
            "icon_size": 20,
            "icon_color": "",
            "icon_hover_color": "#ff6200",
            "answer_size": 14,
            "answer_weight": 400,
            "answer_color": "",
            "answer_padding_bottom": 18,
            "question_1": "WHAT HAPPENS AFTER I PAY?",
            "answer_1": "You create your account, finish a short assessment with progress photos, and get a personal workout + diet within 24–48 hours. Pay securely with UPI / cards on Razorpay. Then use daily trackers, message your coach, submit weekly check-ins, and get plan updates from real progress.",
            "question_2": "WHAT EXACTLY IS INCLUDED?",
            "answer_2": "Personal workout, personal diet, weekly coach check-ins, daily trackers, coach chat, progress photos/journey, Consistency League, and weekly plan updates. One price — no separate upsell for core coaching.",
            "question_3": "WILL I GET A REAL COACH?",
            "answer_3": "Yes. A human coach reviews your assessment, check-ins, and progress. Tools help them work faster — they do not replace the coach. You also get direct coach chat inside the app.",
            "question_4": "GYM OR HOME? BEGINNERS? VEGETARIANS?",
            "answer_4": "All welcome. Plans are built for gym, home, or mixed setups, matched to your experience level, and diet is customized for vegetarian, vegan, and allergy needs.",
            "question_5": "WHAT IS THE CONSISTENCY LEAGUE?",
            "answer_5": "A monthly accountability ladder inside the LURVOX app. Entry is free with every coaching plan. You earn points from daily trackers, weekly check-ins, progress photos, and streaks. Top 10% in your division promote each month: Bronze → Silver → Gold → Platinum → Diamond (certificates & trophies). Crazy 1/2/3 is the prize-money arena — up to Rs 5,000 — and requires the 12-month plan. World Leaderboard coming soon. Open /pages/consistency-league for the full breakdown.",
            "question_6": "IS THERE A RISK IF IT’S NOT FOR ME?",
