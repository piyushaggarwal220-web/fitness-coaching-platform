{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-what-you-get-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_mobile }}px 20px;
  }

  @media screen and (min-width: 750px) {
    .ai-what-you-get-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_desktop }}px 40px;
    }
  }

  .ai-what-you-get-container-{{ ai_gen_id }} {
    max-width: 680px;
    margin: 0 auto;
  }

  .ai-what-you-get-eyebrow-{{ ai_gen_id }} {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: {{ block.settings.eyebrow_color }};
    margin-bottom: 14px;
  }

  .ai-what-you-get-headline-{{ ai_gen_id }} {
    font-size: 28px;
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.5px;
    color: {{ block.settings.headline_color }};
    margin-bottom: 18px;
    font-family: Georgia, 'Times New Roman', serif;
  }

  @media screen and (min-width: 750px) {
    .ai-what-you-get-headline-{{ ai_gen_id }} {
      font-size: 38px;
      letter-spacing: -0.8px;
    }
  }

  .ai-what-you-get-paragraph-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.5;
    color: {{ block.settings.paragraph_color }};
    margin-bottom: 16px;
  }

  .ai-what-you-get-highlight-{{ ai_gen_id }} {
    font-size: 12px;
    line-height: 1.5;
    color: {{ block.settings.highlight_color }};
    margin-bottom: 20px;
  }

  .ai-what-you-get-card-{{ ai_gen_id }} {
    background: #0B0B0B;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 24px;
    padding: 24px 22px;
    margin-bottom: 20px;
    overflow: hidden;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.3s ease;
    box-shadow: 0 0 0 1px rgba(255,98,0,0.08), 0 10px 40px rgba(0,0,0,0.45);
  }

  .ai-what-you-get-card-{{ ai_gen_id }}.ai-animated-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  @media screen and (min-width: 750px) {
    .ai-what-you-get-card-{{ ai_gen_id }}:hover {
      transform: translateY(-4px);
      border-color: rgba(255,255,255,0.15);
      box-shadow: 0 0 0 1px rgba(255,98,0,0.12), 0 10px 40px rgba(0,0,0,0.45), 0 0 24px rgba(255,98,0,0.25);
    }
  }

  .ai-what-you-get-card-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .ai-what-you-get-icon-wrapper-{{ ai_gen_id }} {
    width: 52px;
    height: 52px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-what-you-get-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    color: {{ block.settings.icon_color }};
  }

  .ai-what-you-get-card-title-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: {{ block.settings.card_title_color }};
    margin: 0;
  }

  .ai-what-you-get-divider-{{ ai_gen_id }} {
    height: 1px;
    background: rgba(255,255,255,0.08);
    margin-bottom: 22px;
    width: 100%;
  }

  .ai-what-you-get-checklist-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .ai-what-you-get-checklist-item-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-what-you-get-check-icon-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 1px;
    color: {{ block.settings.check_icon_color }};
    filter: drop-shadow(0 0 6px {{ block.settings.check_icon_glow }});
  }

  .ai-what-you-get-item-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-what-you-get-item-title-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 700;
    color: {{ block.settings.item_title_color }};
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .ai-what-you-get-item-description-{{ ai_gen_id }} {
    font-size: 12px;
    line-height: 1.4;
    color: {{ block.settings.item_description_color }};
  }
{% endstyle %}

<what-you-get-{{ ai_gen_id }} class="ai-what-you-get-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
