{%- if section.settings.enabled -%}
  <div
    id="lurvox-social-proof"
    class="lurvox-social-proof"
    style="--lurvox-sp-accent: {{ section.settings.accent_color }};"
    data-interval="{{ section.settings.interval_seconds | default: 45 }}"
    data-duration="{{ section.settings.visible_seconds | default: 5 }}"
    hidden
    aria-live="polite"
  >
    <div class="lurvox-social-proof__card" data-sp-card>
      <span class="lurvox-social-proof__avatar" data-sp-avatar aria-hidden="true">A</span>
      <span class="lurvox-social-proof__body">
        <strong data-sp-name>Someone</strong>
        <small>
          enrolled in <span data-sp-plan>12 Months</span>
          · <span data-sp-when>just now</span>
        </small>
      </span>
      <span class="lurvox-social-proof__dot" aria-hidden="true"></span>
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById('lurvox-social-proof');
      if (!root || root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      function onCheckoutSurface() {
        var href = (location.href || '').toLowerCase();
        var path = (location.pathname || '').toLowerCase();
        if (href.indexOf('app.lurvox.in') !== -1) return true;
        if (path.indexOf('/checkouts') !== -1 || path.indexOf('/checkout') !== -1) return true;
        if (path.indexOf('/cart') !== -1) return true;
        if (path.indexOf('/plans/') !== -1 || path === '/plans' || path === '/trial') return true;
        return false;
      }

      if (onCheckoutSurface()) return;

      var names = [
        'Aarav Sharma', 'Vihaan Patel', 'Aditya Rao', 'Arjun Mehta', 'Kabir Singh',
        'Reyansh Gupta', 'Vivaan Joshi', 'Ishaan Kapoor', 'Shaurya Nair', 'Atharv Desai',
        'Ananya Iyer', 'Aisha Khan', 'Diya Reddy', 'Myra Malhotra', 'Kiara Jain',
        'Saanvi Pillai', 'Pari Verma', 'Anvi Chopra', 'Riya Banerjee', 'Navya Menon',
        'Rohan Kulkarni', 'Yash Agarwal', 'Kunal Bhat', 'Nikhil Saxena', 'Harsh Tiwari',
        'Meera Shah', 'Tanvi Bose', 'Ira Sengupta', 'Advait Kulkarni', 'Devansh Mishra'
      ];

      var plans = [
        'the 3 Month plan',
        'the 6 Month plan',
        'the 1 Year plan',
        'the 12 Month plan'
      ];

      var whens = [
        'just now',
        '1 min ago',
        '2 mins ago',
        '5 mins ago',
        '8 mins ago',
        '12 mins ago',
        '15 mins ago',
        '20 mins ago',
        '30 mins ago',
        '45 mins ago',
        '1 hour ago'
      ];

      var card = root.querySelector('[data-sp-card]');
      var nameEl = root.querySelector('[data-sp-name]');
      var planEl = root.querySelector('[data-sp-plan]');
      var whenEl = root.querySelector('[data-sp-when]');
      var avatarEl = root.querySelector('[data-sp-avatar]');
      var intervalMs = Math.max(20, parseInt(root.getAttribute('data-interval'), 10) || 45) * 1000;
      var visibleMs = Math.max(3, parseInt(root.getAttribute('data-duration'), 10) || 5) * 1000;
      var hideTimer = null;
      var lastName = '';

      function pick(list, avoid) {
        var item = list[Math.floor(Math.random() * list.length)];
        if (avoid && list.length > 1) {
          var guard = 0;
          while (item === avoid && guard < 6) {
            item = list[Math.floor(Math.random() * list.length)];
            guard += 1;
          }
        }
        return item;
      }

      function initials(name) {
        return name
          .split(/\s+/)
          .slice(0, 2)
          .map(function (part) { return part.charAt(0); })
          .join('')
          .toUpperCase();
      }

      var lastScrollAt = 0;
      window.addEventListener(
        'scroll',
        function () { lastScrollAt = Date.now(); },
        { passive: true }
      );

      function showToast() {
        if (onCheckoutSurface() || document.hidden) return;
        // Never appear mid-scroll or over the cart — that is what reads as the page jumping
        if (Date.now() - lastScrollAt < 1200) return;
        if (document.documentElement.classList.contains('lurvox-cart-open')) return;

        var name = pick(names, lastName);
        lastName = name;
        var plan = pick(plans);
        // Bias toward 1 year + mixed times like the brief
        if (Math.random() < 0.35) plan = 'the 1 Year plan';
        var when = pick(whens);
        if (Math.random() < 0.4) when = pick(['5 mins ago', '30 mins ago', '2 mins ago', '15 mins ago']);

        nameEl.textContent = name;
        planEl.textContent = plan;
        whenEl.textContent = when;
        avatarEl.textContent = initials(name);

        root.hidden = false;
        root.classList.remove('is-out');
        root.classList.add('is-in');

        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = setTimeout(function () {
          root.classList.remove('is-in');
          root.classList.add('is-out');
          setTimeout(function () {
            if (root.classList.contains('is-out')) root.hidden = true;
          }, 420);
        }, visibleMs);
      }

      // First toast shortly after load, then every interval
      setTimeout(showToast, 2000);
      setInterval(showToast, intervalMs);

      // Stop once user leaves for app checkout
      document.addEventListener('click', function (event) {
        var a = event.target && event.target.closest ? event.target.closest('a[href]') : null;
        if (!a) return;
        var href = (a.getAttribute('href') || '').toLowerCase();
        if (
          href.indexOf('app.lurvox.in') !== -1 ||
          href.indexOf('/checkout') !== -1 ||
          href.indexOf('/plans/') !== -1 ||
          href.indexOf('/trial') !== -1
        ) {
          root.hidden = true;
          root.classList.remove('is-in');
        }
      }, true);
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .lurvox-social-proof {
    --lurvox-sp-accent: #ff6200;
    position: fixed;
    left: max(16px, env(safe-area-inset-left));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 9998;
    pointer-events: none;
    max-width: min(340px, calc(100vw - 32px));
    contain: layout paint style;
  }

  .lurvox-social-proof__card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 16px;
    color: #fff;
    background:
      radial-gradient(circle at 0% 0%, color-mix(in srgb, var(--lurvox-sp-accent) 28%, transparent), transparent 55%),
      linear-gradient(135deg, #17110d 0%, #0d0d0d 100%);
    border: 1px solid color-mix(in srgb, var(--lurvox-sp-accent) 42%, transparent);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset,
      0 0 28px color-mix(in srgb, var(--lurvox-sp-accent) 12%, transparent);
    opacity: 0;
    will-change: opacity;
    transition: opacity 0.32s ease;
  }

  .lurvox-social-proof.is-in .lurvox-social-proof__card {
    opacity: 1;
  }

  .lurvox-social-proof.is-out .lurvox-social-proof__card {
    opacity: 0;
  }

  .lurvox-social-proof__avatar {
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: linear-gradient(145deg, var(--lurvox-sp-accent), #c44700);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    box-shadow: 0 0 0 3px rgba(255, 98, 0, 0.16);
  }

  .lurvox-social-proof__body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .lurvox-social-proof__body strong {
    font-size: 13px;
    font-weight: 750;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lurvox-social-proof__body small {
    color: rgba(255, 255, 255, 0.68);
    font-size: 11px;
    line-height: 1.35;
  }

  .lurvox-social-proof__body small span {
    color: #ffb07a;
  }

  .lurvox-social-proof__dot {
    width: 8px;
    height: 8px;
    margin-left: 4px;
    border-radius: 999px;
    background: #35d07f;
    box-shadow: 0 0 0 5px rgba(53, 208, 127, 0.12);
    animation: lurvox-sp-pulse 1.8s ease-in-out infinite;
  }

  @keyframes lurvox-sp-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.15); opacity: 0.7; }
  }

  @media screen and (max-width: 749px) {
    .lurvox-social-proof {
      left: 12px;
      right: auto;
      bottom: calc(84px + env(safe-area-inset-bottom));
      max-width: min(290px, calc(100vw - 24px));
    }

    .lurvox-social-proof__card {
      padding: 10px 12px;
      gap: 10px;
    }

    .lurvox-social-proof__avatar {
      flex-basis: 32px;
      width: 32px;
      height: 32px;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lurvox-social-proof__card {
      transition: opacity 0.2s ease;
    }
    .lurvox-social-proof__dot {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LURVOX social proof",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show floating enrollments", "default": true },
    { "type": "range", "id": "interval_seconds", "label": "Seconds between toasts", "min": 20, "max": 120, "step": 5, "default": 20 },
    { "type": "range", "id": "visible_seconds", "label": "Seconds each toast stays", "min": 3, "max": 12, "step": 1, "default": 5 },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#FF6200" }
  ]
}
{% endschema %}
