{% comment %}
  Homepage-only Find My Plan overlay. Eight questions from the studio finder.
  Floating metallic card over a blurred page. No separate quiz page.
{% endcomment %}
{%- if template.name == 'index' -%}
<div id="lx-home-quiz">
  <button type="button" class="lxq-tab" data-lxq-open>
    <span>Find my plan</span>
    <small>8 questions · free</small>
  </button>
  <div class="lxq-overlay" data-lxq-overlay hidden>
    <div class="lxq-blur" data-lxq-close></div>
    <div class="lxq-panel" role="dialog" aria-modal="true" aria-labelledby="lxq-title">
      <span class="lxq-shine" aria-hidden="true"></span>
      <button type="button" class="lxq-x" data-lxq-close aria-label="Close">×</button>
      <section data-lxq-view="quiz">
        <p class="lxq-kicker">Free quiz</p>
        <h2 id="lxq-title" class="lxq-title">Find your plan</h2>
        <div class="lxq-bar"><span data-lxq-bar></span></div>
        <p class="lxq-step" data-lxq-step>Question 1 of 8</p>
        <h3 class="lxq-q" data-lxq-q></h3>
        <div class="lxq-options" data-lxq-options></div>
        <button type="button" class="lxq-back" data-lxq-back hidden>Back</button>
      </section>
      <section data-lxq-view="result" hidden>
        <p class="lxq-kicker">Your plan</p>
        <div class="lxq-result-card">
          <p class="lxq-result-term" data-lxq-per></p>
          <h2 class="lxq-result-name" data-lxq-plan></h2>
          <p class="lxq-result-price" data-lxq-price></p>
          <p class="lxq-result-why" data-lxq-why></p>
        </div>
        <div class="lxq-actions">
          <a class="lxq-btn lxq-btn--primary" data-lxq-checkout href="https://app.lurvox.in/plans/3-months?landing=/">See this plan</a>
          <button type="button" class="lxq-btn" data-lxq-book>Book a free call</button>
        </div>
        <button type="button" class="lxq-back" data-lxq-restart>Retake quiz</button>
      </section>
    </div>
  </div>
</div>
<style id="lx-home-quiz-css">
  #lx-home-quiz { font-family: inherit; }
  #lx-home-quiz .lxq-tab {
    position: fixed;
    right: 14px;
    bottom: calc(18px + env(safe-area-inset-bottom));
    z-index: 2147482600;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    min-height: 52px;
    padding: 10px 16px 10px 14px;
    border: 0;
    border-radius: 16px;
    color: #fff;
    cursor: pointer;
    background:
      linear-gradient(180deg, rgba(255,255,255,.22), transparent 36%),
      linear-gradient(135deg, #2a2a2e 0%, #121214 55%, #1c1c20 100%);
    box-shadow:
      0 12px 28px rgba(0,0,0,.42),
      inset 0 1px 0 rgba(255,255,255,.38),
      inset 0 -1px 0 rgba(255,255,255,.06);
    outline: 1px solid rgba(255,255,255,.2);
    outline-offset: 0;
  }
  #lx-home-quiz .lxq-tab span { font-size: 14px; font-weight: 800; letter-spacing: -.02em; }
  #lx-home-quiz .lxq-tab small { font-size: 11px; font-weight: 650; color: #ffb089; }
  #lx-home-quiz .lxq-overlay {
    position: fixed;
    inset: 0;
    z-index: 2147483001;
    display: grid;
    place-items: center;
    padding: 16px;
  }
  #lx-home-quiz .lxq-overlay[hidden] { display: none; }
  #lx-home-quiz .lxq-blur {
    position: absolute;
    inset: 0;
    background: rgba(4,4,8,.46);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }
  #lx-home-quiz .lxq-panel {
    position: relative;
    width: min(520px, 100%);
    max-height: min(88vh, 820px);
    overflow: auto;
    border-radius: 24px;
    padding: 1.5px;
    color: #f5f5f5;
    background:
      linear-gradient(135deg, rgba(255,255,255,.78) 0%, rgba(186,190,198,.28) 22%, rgba(255,255,255,.08) 46%, rgba(255,176,137,.4) 78%, rgba(255,255,255,.55) 100%);
    box-shadow:
      0 34px 80px rgba(0,0,0,.55),
      0 10px 24px rgba(0,0,0,.32),
      inset 0 1px 0 rgba(255,255,255,.5);
    transform: perspective(1200px) translateY(0) rotateX(1.4deg);
  }
  #lx-home-quiz .lxq-panel > section,
  #lx-home-quiz .lxq-x,
  #lx-home-quiz .lxq-shine { position: relative; z-index: 1; }
  #lx-home-quiz .lxq-panel > section {
    margin: 0;
    padding: 22px 18px 18px;
    border-radius: 22.5px;
    background:
      linear-gradient(180deg, rgba(255,255,255,.1), transparent 30%),
      linear-gradient(180deg, #1b1b1e, #0e0e11);
  }
  #lx-home-quiz .lxq-shine {
    pointer-events: none;
    position: absolute;
    inset: 1px;
    border-radius: 22.5px;
    background:
      radial-gradient(28px 22px at 14px 12px, rgba(255,255,255,.55), transparent 70%),
      radial-gradient(24px 20px at calc(100% - 14px) 12px, rgba(255,255,255,.28), transparent 72%),
      linear-gradient(115deg, rgba(255,255,255,.2), transparent 28%);
    z-index: 2;
  }
  #lx-home-quiz .lxq-x {
    position: absolute;
    top: 12px;
    right: 14px;
    z-index: 3;
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }
  #lx-home-quiz .lxq-kicker {
    margin: 0 0 6px;
    color: #ff6200;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  #lx-home-quiz .lxq-title { margin: 0 0 8px; font-size: 28px; letter-spacing: -0.03em; }
  #lx-home-quiz .lxq-q { margin: 12px 0; font-size: 22px; letter-spacing: -0.03em; }
  #lx-home-quiz .lxq-step {
    margin: 10px 0 0;
    color: #ffb089;
    font-size: 13px;
    font-weight: 650;
  }
  #lx-home-quiz .lxq-bar {
    height: 4px;
    background: rgba(255,255,255,.12);
    border-radius: 99px;
    overflow: hidden;
  }
  #lx-home-quiz .lxq-bar span { display: block; height: 100%; width: 0; background: #ff6200; }
  #lx-home-quiz .lxq-options { display: grid; gap: 8px; margin-top: 12px; }
  #lx-home-quiz .lxq-options button {
    display: block;
    width: 100%;
    text-align: left;
    padding: 14px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.14);
    background:
      linear-gradient(180deg, rgba(255,255,255,.08), transparent 40%),
      #161618;
    color: #fff;
    font: inherit;
    cursor: pointer;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.16);
  }
  #lx-home-quiz .lxq-options button.is-on {
    border-color: #ff6200;
    box-shadow: 0 0 0 2px rgba(255,98,0,.35), inset 0 1px 0 rgba(255,255,255,.2);
  }
  #lx-home-quiz .lxq-actions { display: grid; gap: 10px; margin-top: 16px; }
  #lx-home-quiz .lxq-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.16);
    background: #1a1a1a;
    color: #fff;
    font: inherit;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
  }
  #lx-home-quiz .lxq-btn--primary { background: #ff6200; color: #140900; border-color: #ff6200; }
  #lx-home-quiz .lxq-back {
    display: block;
    margin: 12px auto 0;
    background: none;
    border: 0;
    color: rgba(245,245,245,.7);
    cursor: pointer;
  }
  #lx-home-quiz .lxq-result-card {
    margin-top: 10px;
    padding: 16px;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,.12);
    background: #141416;
  }
  #lx-home-quiz .lxq-result-term {
    margin: 0 0 4px;
    color: #ffb089;
    font-size: 12px;
    font-weight: 750;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  #lx-home-quiz .lxq-result-name { margin: 0 0 6px; font-size: 28px; letter-spacing: -.03em; }
  #lx-home-quiz .lxq-result-price { margin: 0 0 8px; font-size: 18px; font-weight: 750; }
  #lx-home-quiz .lxq-result-why { margin: 0; color: rgba(245,245,245,.7); line-height: 1.45; }
  @media (max-width: 639px) {
    #lx-home-quiz .lxq-tab { left: 14px; right: 14px; align-items: center; }
    #lx-home-quiz .lxq-panel { transform: none; }
  }
</style>
<script>
(function () {
  var root = document.getElementById('lx-home-quiz');
  if (!root || root.getAttribute('data-bound') === '1') return;
  root.setAttribute('data-bound', '1');

  var steps = [
    { key: 'goal', q: 'What is the main goal?', options: [
      { label: 'Fast fat loss', plan: 'fat' },
      { label: 'Fat loss and visible muscle', plan: 'mix' },
      { label: 'A complete overhaul: fat, muscle, stamina, and strength', plan: 'athletic' }
    ]},
    { key: 'commit', q: 'How long can you commit?', options: [
      { label: 'About 3 months', plan: 'fat' },
      { label: 'Half a year', plan: 'mix' },
      { label: 'A full year', plan: 'athletic' }
    ]},
    { key: 'training', q: 'Where is your training now?', options: [
      { label: 'New to structured training', plan: 'fat' },
      { label: 'Trained on and off', plan: 'mix' },
      { label: 'I train fairly regularly', plan: 'athletic' }
    ]},
    { key: 'beyond', q: 'Beyond fat loss, what else?', options: [
      { label: 'Nothing else. Fat loss is the job.', plan: 'fat' },
      { label: 'Noticeable muscle and strength', plan: 'mix' },
      { label: 'Muscle, stamina, and performance', plan: 'athletic' }
    ]},
    { key: 'stamina', q: 'How much does stamina matter?', options: [
      { label: 'Not a priority', plan: 'fat' },
      { label: 'Somewhat', plan: 'mix' },
      { label: 'Very. I want to feel athletic.', plan: 'athletic' }
    ]},
    { key: 'budget', q: 'What is realistic for your schedule and budget?', options: [
      { label: 'Start small', plan: 'fat' },
      { label: 'A mid-range plan', plan: 'mix' },
      { label: 'I am ready for the full year', plan: 'athletic' }
    ]},
    { key: 'success', q: 'A year from now, success looks like…', options: [
      { label: 'The fat is gone', plan: 'fat' },
      { label: 'The fat is gone and muscle is on', plan: 'mix' },
      { label: 'I feel like a different, athletic person', plan: 'athletic' }
    ]},
    { key: 'where', q: 'Where will you train?', options: [
      { label: 'Home', where: 'home' },
      { label: 'A gym', where: 'gym' },
      { label: 'Home and a gym', where: 'both' }
    ]}
  ];
  var plans = {
    '3_months': { label: 'Fat loss', price: '₹1,999', per: '90 days', path: '3-months' },
    '6_months': { label: 'Fat loss + muscle gain', price: '₹3,499', per: '6 months', path: '6-months' },
    '12_months': { label: 'Athletic body', price: '₹5,999', per: '12 months', path: '12-months' }
  };
  var ORDER = ['fat', 'mix', 'athletic'];
  var SLUG = { fat: '3_months', mix: '6_months', athletic: '12_months' };
  var CLUES = [
    { fat: 'The goal is fast fat loss', mix: 'The goal is fat loss and visible muscle', athletic: 'The goal is a complete overhaul' },
    { fat: 'The commitment is about 3 months', mix: 'The commitment is half a year', athletic: 'The commitment is a full year' },
    { fat: 'Structured training is new', mix: 'Training has been on and off', athletic: 'Training is already regular' },
    { fat: 'Fat loss is the only job', mix: 'Muscle and strength matter too', athletic: 'Muscle, stamina, and performance all matter' },
    { fat: 'Stamina is not a priority', mix: 'Stamina matters somewhat', athletic: 'Stamina is high on the list' },
    { fat: 'The realistic start is the smaller plan', mix: 'The realistic start is the mid-range plan', athletic: 'The full year is realistic' },
    { fat: 'Success is the fat gone', mix: 'Success is fat gone and muscle on', athletic: 'Success is feeling like an athletic person' }
  ];
  var picks = [];
  var where = 'both';
  var stepIndex = 0;

  function placePhrase(value) {
    if (value === 'home') return 'training at home';
    if (value === 'gym') return 'training in a gym';
    return 'training at home and in a gym';
  }

  function recommend() {
    var scores = { fat: 0, mix: 0, athletic: 0 };
    picks.forEach(function (pick) { if (pick) scores[pick] += 1; });
    var max = Math.max(scores.fat, scores.mix, scores.athletic);
    var leaders = ORDER.filter(function (key) { return scores[key] === max; });
    var commitment = picks[1];
    var winner = leaders[0];
    if (leaders.length > 1) {
      if (leaders.indexOf(commitment) >= 0) winner = commitment;
      else {
        var at = ORDER.indexOf(commitment);
        winner = leaders.slice().sort(function (a, b) {
          return Math.abs(ORDER.indexOf(a) - at) - Math.abs(ORDER.indexOf(b) - at);
        })[0];
      }
    }
    var clues = picks.map(function (pick, index) {
      return pick === winner && CLUES[index] ? CLUES[index][winner] : null;
    }).filter(Boolean);
    var first = clues[0] || 'This plan is the one the answers landed on';
    var second = clues[1] ? ', and ' + clues[1].charAt(0).toLowerCase() + clues[1].slice(1) : '';
    return { slug: SLUG[winner], why: first + second + ', with ' + placePhrase(where) + '.' };
  }

  function view(name) {
    Array.prototype.forEach.call(root.querySelectorAll('[data-lxq-view]'), function (el) {
      el.hidden = el.getAttribute('data-lxq-view') !== name;
    });
    var panel = root.querySelector('.lxq-panel');
    if (panel) panel.scrollTop = 0;
  }

  function renderStep() {
    var step = steps[stepIndex];
    root.querySelector('[data-lxq-step]').textContent = 'Question ' + (stepIndex + 1) + ' of ' + steps.length;
    root.querySelector('[data-lxq-bar]').style.width = ((stepIndex + 1) / steps.length) * 100 + '%';
    root.querySelector('[data-lxq-q]').textContent = step.q;
    var box = root.querySelector('[data-lxq-options]');
    box.innerHTML = '';
    root.querySelector('[data-lxq-back]').hidden = stepIndex === 0;
    step.options.forEach(function (opt) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = opt.label;
      btn.addEventListener('click', function () {
        Array.prototype.forEach.call(box.children, function (el) { el.classList.remove('is-on'); });
        btn.classList.add('is-on');
        if (opt.where) where = opt.where;
        if (opt.plan) picks[stepIndex] = opt.plan;
        window.setTimeout(function () {
          if (stepIndex >= steps.length - 1) showResult();
          else { stepIndex += 1; renderStep(); }
        }, 120);
      });
      box.appendChild(btn);
    });
  }

  function showResult() {
    var rec = recommend();
    var plan = plans[rec.slug];
    root.querySelector('[data-lxq-plan]').textContent = plan.label;
    root.querySelector('[data-lxq-per]').textContent = plan.per;
    root.querySelector('[data-lxq-price]').textContent = plan.price;
    root.querySelector('[data-lxq-why]').textContent = rec.why;
    root.querySelector('[data-lxq-checkout]').href = 'https://app.lurvox.in/plans/' + plan.path + '?landing=/';
    view('result');
  }

  function openQuiz() {
    root.querySelector('[data-lxq-overlay]').hidden = false;
    var tab = root.querySelector('.lxq-tab');
    if (tab) tab.hidden = true;
    document.documentElement.style.overflow = 'hidden';
    view('quiz');
    renderStep();
  }

  function closeQuiz() {
    root.querySelector('[data-lxq-overlay]').hidden = true;
    var tab = root.querySelector('.lxq-tab');
    if (tab) tab.hidden = false;
    document.documentElement.style.overflow = '';
  }

  window.__lurvoxOpenHomeQuiz = openQuiz;

  Array.prototype.forEach.call(root.querySelectorAll('[data-lxq-close]'), function (el) {
    el.addEventListener('click', closeQuiz);
  });
  Array.prototype.forEach.call(root.querySelectorAll('[data-lxq-open]'), function (el) {
    el.addEventListener('click', openQuiz);
  });
  root.querySelector('[data-lxq-back]').addEventListener('click', function () {
    if (stepIndex <= 0) return;
    stepIndex -= 1;
    renderStep();
  });
  root.querySelector('[data-lxq-restart]').addEventListener('click', function () {
    picks = [];
    where = 'both';
    stepIndex = 0;
    view('quiz');
    renderStep();
  });
  root.querySelector('[data-lxq-book]').addEventListener('click', function () {
    closeQuiz();
    location.hash = 'lx-home-consult';
  });

  function bindFindLinks() {
    document.querySelectorAll('a[href*="choose-your-plan"], a[href*="find-your-plan"]').forEach(function (a) {
      if (a.dataset.lxqBound === '1') return;
      a.dataset.lxqBound = '1';
      a.addEventListener('click', function (ev) {
        ev.preventDefault();
        ev.stopPropagation();
        openQuiz();
      }, true);
    });
  }
  bindFindLinks();
  setTimeout(bindFindLinks, 400);

  if (/[?&]quiz=1\b/.test(location.search) || location.hash === '#quiz') {
    openQuiz();
  }
})();
</script>
{%- endif -%}
