    display: block;
    border-radius: 12px;
    background: var(--soft);
    margin-bottom: 22px;
  }
  .lxo-shot {
    margin-top: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .lxo-page .lxo-shot > button {
