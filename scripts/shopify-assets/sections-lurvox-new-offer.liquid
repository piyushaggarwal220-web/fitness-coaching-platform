    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .lxo-steps button.is-on span {
    background: var(--orange);
    color: #fff;
  }
  .lxo-steps p { color: var(--quiet); padding-top: 6px; }
  .lxo-steps strong { color: var(--ink); font-weight: 600; }

