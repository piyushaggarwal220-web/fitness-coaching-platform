    --quiet: #5e5954;
    --line: rgba(22, 21, 19, 0.12);
    --orange: #ff4d00;
    --soft: #f6f6f5;
    background: #fff;
    color: var(--ink);
    font-family: "Instrument Sans", system-ui, sans-serif;
    font-weight: 400;
    font-size: 17px;
    line-height: 1.5;
    min-height: 100vh;
    padding-bottom: 84px;
