  }
  .lxo-foot p { margin-top: 6px; }
  .lxo-foot a { margin-right: 14px; text-decoration: underline; text-underline-offset: 3px; }

  .lxo-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 8;
    display: flex;
    justify-content: center;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.94);
    border-top: 1px solid var(--line);
  }
  .lxo-sticky .lxo-quiz { width: min(100%, 420px); margin: 0; }

  @media (prefers-reduced-motion: reduce) {
    .lxo-page * { transition: none !important; animation: none !important; }
    .lxo-reveal,
    .lxo-reveal img { opacity: 1; transform: none; }
  }
</style>

<script>
  (function () {
    var catalog = {
      fat: {
        name: 'Fat loss',
        price: '₹1,999',
        month: '₹666 a month',
        length: '90 days',
        href: 'https://app.lurvox.in/plans/3-months',
        why: '90 days to lose fat. The plan is rewritten every 14 days, from your check-ins.',
        points: ['Workout and diet for 90 days', 'Check-ins and chat in the app', 'Rewritten every 14 days']
      },
      muscle: {
        name: 'Muscle',
        price: '₹3,499',
        month: '₹583 a month',
        length: '6 months',
        href: 'https://app.lurvox.in/plans/6-months',
        why: 'Six months to build muscle. Cardio and supplements are included, and the plan is rewritten every week.',
        points: ['Workout, diet, cardio, and supplements', 'Rewritten every week', 'Extra help if progress stalls after 90 days']
      },
      athletic: {
        name: 'Athletic',
        price: '₹5,999',
        month: '₹500 a month',
        length: '12 months',
        href: 'https://app.lurvox.in/plans/12-months',
        why: 'A full year. Stamina is included, and the coach rewrites the plan every week so it stays current.',
        points: ['The full plan, kept current all year', 'Stamina work included', 'Rewritten every week']
      }
    }
    var steps = [
      {
        key: 'goal',
        q: 'What do you want from this?',
        options: [
          { label: 'Lose fat', plan: 'fat' },
          { label: 'Lose fat and build muscle', plan: 'muscle' },
          { label: 'An athletic body, with stamina', plan: 'athletic' }
        ]
      },
      {
        key: 'time',
        q: 'How long do you want to stay with it?',
        options: [
          { label: '90 days', plan: 'fat' },
          { label: '6 months', plan: 'muscle' },
          { label: '12 months', plan: 'athletic' }
        ]
      },
      {
        key: 'support',
        q: 'How should the plan keep up?',
        options: [
          { label: 'Rewrite it every two weeks', plan: 'fat' },
          { label: 'Rewrite it every week, and add cardio', plan: 'muscle' },
          { label: 'Keep it current for a full year', plan: 'athletic' }
        ]
      }
    ]
    var answers = {}
    var index = 0
    var browse = document.getElementById('lxo-browse')
    var ask = document.getElementById('lxo-ask')
    var stepEl = document.getElementById('lxo-step')
    var questionEl = document.getElementById('lxo-question')
    var optionsEl = document.getElementById('lxo-options')
    var backEl = document.getElementById('lxo-back')
    var resultEl = document.getElementById('lxo-result')
    var planList = document.getElementById('lxo-plan-list')
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    function choose() {
      var tally = { fat: 0, muscle: 0, athletic: 0 }
      Object.keys(answers).forEach(function (key) { tally[answers[key]] += 1 })
      var best = answers.goal || 'fat'
      var top = tally[best]
      ;['fat', 'muscle', 'athletic'].forEach(function (key) {
        if (tally[key] > top) {
          best = key
          top = tally[key]
        }
      })
      return catalog[best]
    }

    function setProgress() {
      var bar = document.querySelector('#lxo-progress span')
      if (bar) bar.style.width = (((index + 1) / steps.length) * 100) + '%'
    }

    function showQuestion() {
      var step = steps[index]
      resultEl.hidden = true
      stepEl.hidden = false
      questionEl.hidden = false
      optionsEl.hidden = false
      document.getElementById('lxo-progress').hidden = false
      stepEl.textContent = (index + 1) + ' of ' + steps.length
      questionEl.textContent = step.q
      backEl.hidden = index === 0
      setProgress()
      optionsEl.textContent = ''
      ask.classList.remove('is-swap')
      step.options.forEach(function (option) {
        var button = document.createElement('button')
        button.type = 'button'
        button.textContent = option.label
        button.addEventListener('click', function () {
          optionsEl.querySelectorAll('button').forEach(function (item) { item.classList.remove('is-picked') })
          button.classList.add('is-picked')
          window.setTimeout(function () {
            answers[step.key] = option.plan
            if (index < steps.length - 1) {
              ask.classList.add('is-swap')
              window.setTimeout(function () {
                index += 1
                showQuestion()
              }, reduce ? 0 : 140)
            } else {
              showResult()
            }
          }, reduce ? 0 : 120)
        })
        optionsEl.appendChild(button)
      })
    }

    function showResult() {
      var plan = choose()
      stepEl.hidden = true
      questionEl.hidden = true
      optionsEl.hidden = true
      backEl.hidden = true
      document.getElementById('lxo-progress').hidden = true
      resultEl.hidden = false
      document.getElementById('lxo-result-name').textContent = plan.name
      document.getElementById('lxo-result-price').textContent = plan.price
      document.getElementById('lxo-result-why').textContent = plan.why
      var next = document.getElementById('lxo-continue')
      next.href = plan.href
      next.textContent = 'Continue with ' + plan.name
    }

    function openQuiz() {
      answers = {}
      index = 0
      browse.hidden = true
      document.getElementById('lxo-sticky').hidden = true
      ask.hidden = false
      showQuestion()
      window.scrollTo(0, 0)
    }

    document.querySelectorAll('[data-lxo-start]').forEach(function (button) {
      button.addEventListener('click', openQuiz)
    })
    backEl.addEventListener('click', function () {
      if (index === 0) return
      index -= 1
      showQuestion()
    })
    document.getElementById('lxo-again').addEventListener('click', openQuiz)

    var scenes = {
      gym: {
        beat: '1 of 4 · The start',
        lede: 'Most plans are a template. This one starts with your goal, your day, and where you train.'
      },
      train: {
        beat: '2 of 4 · The workout',
        lede: 'The sessions are written for the time you have, at home or in a gym. Not copied from someone else’s program.'
      },
      eat: {
        beat: '3 of 4 · The diet',
        lede: 'The meals use food you will actually eat. When you log what you ate, the diet is adjusted from that.'
      },
      checkin: {
        beat: '4 of 4 · The check-in',
        lede: 'You tell the coach what happened. The next plan is rewritten from that week, so it does not go stale.'
      }
    }
    var sceneOrder = ['gym', 'train', 'eat', 'checkin']
    var sceneIndex = 0
    var sceneToken = 0
    var heroPhoto = document.getElementById('lxo-hero-photo')
    var heroLede = document.getElementById('lxo-hero-lede')
    var heroBeat = document.getElementById('lxo-beat')

    function showScene(id) {
      var scene = scenes[id]
      if (!scene) return
      sceneIndex = sceneOrder.indexOf(id)
      var token = ++sceneToken
      heroPhoto.querySelectorAll('img').forEach(function (img) {
        img.classList.toggle('is-on', img.getAttribute('data-scene') === id)
      })
      document.querySelectorAll('.lxo-scenes button').forEach(function (button) {
        var on = button.getAttribute('data-scene') === id
        button.classList.toggle('is-on', on)
        button.setAttribute('aria-selected', on ? 'true' : 'false')
      })
      var apply = function () {
        if (token !== sceneToken) return
        heroBeat.textContent = scene.beat
        heroLede.textContent = scene.lede
        heroBeat.classList.remove('is-swap')
        heroLede.classList.remove('is-swap')
      }
      if (reduce) {
        apply()
        return
      }
      heroBeat.classList.add('is-swap')
      heroLede.classList.add('is-swap')
      window.setTimeout(apply, 160)
    }

    var storyTimer = 0
    function armStory() {
      if (reduce) return
      window.clearInterval(storyTimer)
      storyTimer = window.setInterval(function () {
        var ask = document.getElementById('lxo-ask')
        if (ask && !ask.hidden) return
        showScene(sceneOrder[(sceneIndex + 1) % sceneOrder.length])
      }, 5600)
    }
    armStory()
    document.getElementById('top').addEventListener('pointerdown', function () {
      window.clearInterval(storyTimer)
    })

    document.querySelector('.lxo-scenes').addEventListener('click', function (event) {
      var button = event.target.closest('button')
      if (!button) return
      showScene(button.getAttribute('data-scene'))
    })

    var touchX = 0
    heroPhoto.addEventListener('touchstart', function (event) {
      touchX = event.changedTouches[0].clientX
    }, { passive: true })
    heroPhoto.addEventListener('touchend', function (event) {
      var dx = event.changedTouches[0].clientX - touchX
      if (Math.abs(dx) < 40) return
      var next = sceneIndex + (dx < 0 ? 1 : -1)
      if (next < 0) next = sceneOrder.length - 1
      if (next >= sceneOrder.length) next = 0
      showScene(sceneOrder[next])
    }, { passive: true })

    document.getElementById('lxo-shots').addEventListener('click', function (event) {
      var button = event.target.closest('button')
      if (!button) return
      var shot = button.parentElement
      document.querySelectorAll('.lxo-shot').forEach(function (item) {
        item.classList.toggle('is-open', item === shot)
      })
    })

    document.getElementById('lxo-next').addEventListener('click', function (event) {
      var button = event.target.closest('button')
      if (!button) return
      document.querySelectorAll('#lxo-next button').forEach(function (item) {
        item.classList.toggle('is-on', item === button)
      })
    })

    function showPlan(key) {
      var plan = catalog[key]
      if (!plan || !planList) return
      planList.querySelectorAll('button').forEach(function (item) {
        item.classList.toggle('is-on', item.getAttribute('data-plan') === key)
      })
      var box = document.getElementById('lxo-plan-more')
      var apply = function () {
        document.getElementById('lxo-plan-why').textContent = plan.why
        document.getElementById('lxo-plan-month').textContent = plan.length + ' · ' + plan.month
        var list = document.getElementById('lxo-plan-points')
        list.textContent = ''
        plan.points.forEach(function (point) {
          var item = document.createElement('li')
          item.textContent = point
          list.appendChild(item)
        })
        box.classList.remove('is-swap')
      }
      if (reduce) {
        apply()
        return
      }
      box.classList.add('is-swap')
      window.setTimeout(apply, 160)
    }

    planList.addEventListener('click', function (event) {
      var button = event.target.closest('button')
      if (!button) return
      showPlan(button.getAttribute('data-plan'))
    })

    var heroQuiz = document.querySelector('.lxo-hero .lxo-quiz')
    var sticky = document.getElementById('lxo-sticky')
    if (heroQuiz && sticky && 'IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        var gone = !entries[0].isIntersecting
        sticky.hidden = !gone || ask.hidden === false
      }, { threshold: 0 })
      observer.observe(heroQuiz)
    }

    var revealItems = document.querySelectorAll('.lxo-reveal')
    if (reduce || !('IntersectionObserver' in window)) {
      revealItems.forEach(function (item) { item.classList.add('is-in') })
    } else {
      var reveal = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return
          entry.target.classList.add('is-in')
          reveal.unobserve(entry.target)
        })
      }, { threshold: 0.16 })
      revealItems.forEach(function (item) { reveal.observe(item) })
    }
  })()
</script>

{% schema %}
{
  "name": "LURVOX new offer",
  "settings": []
}
{% endschema %}
