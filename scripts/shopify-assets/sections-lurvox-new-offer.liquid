    font-size: 16px;
  }
  .lxo-shot.is-open > button { color: var(--ink); }
  .lxo-shot.is-open > button::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--orange);
    transform: translateY(-1px);
  }
  .lxo-shot-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s ease;
  }
  .lxo-shot.is-open .lxo-shot-body { grid-template-rows: 1fr; }
  .lxo-shot-body > div { overflow: hidden; }
  .lxo-shot img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    margin-top: 10px;
