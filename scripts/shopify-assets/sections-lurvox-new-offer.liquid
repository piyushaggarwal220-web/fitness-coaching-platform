    background: #fff !important;
    color: #161513;
  }
  body:has(.lxo-page) .shopify-section-group-header-group,
  body:has(.lxo-page) .shopify-section-group-footer-group,
  body:has(.lxo-page) #shopify-section-header,
  body:has(.lxo-page) #shopify-section-footer,
  body:has(.lxo-page) .lx-mchat,
  body:has(.lxo-page) .lx-find-float,
  body:has(.lxo-page) a[href*="choose-your-plan"],
  body:has(.lxo-page) a[href*="find-your-plan"] {
    display: none !important;
  }
  .shopify-section:has(.lxo-page) {
    padding: 0 !important;
    margin: 0 !important;
    max-width: none !important;
    background: #fff !important;
  }

