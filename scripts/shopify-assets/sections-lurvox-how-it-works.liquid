{% comment %}
  LURVOX — How it works (dedicated page section)
{% endcomment %}

{%- liquid
  assign find_url = section.settings.find_url | default: '/pages/choose-your-plan'
  assign plans_url = section.settings.plans_url | default: '/#plans'
  assign terms_url = section.settings.terms_url | default: 'https://app.lurvox.in/terms'
  assign compare_url = section.settings.compare_url | default: '/pages/compare-fit?view=compare-short'
-%}

<section class="lx-how" id="how-lurvox-works" aria-label="How LURVOX works">
  <div class="lx-how__glow" aria-hidden="true"></div>
  <div class="lx-how__inner">
    <p class="lx-how__eyebrow">{{ section.settings.eyebrow | default: 'How LURVOX works' }}</p>
    <h1 class="lx-how__title">{{ section.settings.title | default: 'From checkout to weekly coaching' }}</h1>
    <p class="lx-how__lede">
      {{ section.settings.lede | default: 'Built for India: vegetarian and home cooked diets, gym or home workouts, and a real coach in the app. Not a PDF dump.' }}
    </p>

    <ol class="lx-how__steps">
      <li>
        <span class="lx-how__num">01</span>
        <div>
          <h2>Tell us your body & schedule</h2>
          <p>Short assessment + progress photos after checkout.</p>
        </div>
      </li>
      <li>
        <span class="lx-how__num">02</span>
        <div>
          <h2>Get your personal plan</h2>
          <p>Workout + diet matched to you within 24 to 48 hours.</p>
        </div>
      </li>
      <li>
        <span class="lx-how__num">03</span>
        <div>
          <h2>Train with daily trackers</h2>
          <p>Log workouts, meals, sleep, steps. Your coach sees what matters.</p>
        </div>
      </li>
      <li>
        <span class="lx-how__num">04</span>
        <div>
          <h2>Weekly reviews that keep you moving</h2>
          <p>Mid week + weekly check ins on every plan. Plan updates every 14 days on 3 months, every week on 6 and 12 months. Direct coach chat in the app.</p>
        </div>
      </li>
    </ol>

    <div class="lx-how__trust" aria-label="Trust signals">
      <p><strong>Personal plan</strong> in 24 to 48 hrs</p>
      <p><strong>Human coach</strong>. Not a PDF</p>
      <p><strong>UPI / Razorpay</strong> checkout</p>
      <p><strong>Terms</strong> apply to every plan</p>
    </div>

    <div class="lx-how__risk">
      <p>
        Refunds and guarantees (if any) are only as stated in our
        <a href="{{ terms_url }}" target="_blank" rel="noopener noreferrer">Terms &amp; Conditions</a>.
      </p>
    </div>

    <div class="lx-how__actions">
      <a class="lx-how__btn lx-how__btn--primary" href="{{ find_url }}">
        <span class="lx-how__btn-main">Tap to know which plan fits you</span>
        <span class="lx-how__btn-sub">Quick quiz</span>
      </a>
      <a class="lx-how__btn lx-how__btn--ghost" href="{{ compare_url }}">Compare 3 · 6 · 12 month plans</a>
      <a class="lx-how__link" href="{{ plans_url }}">Back to plans on home</a>
    </div>
  </div>
</section>

<style>
  body, #MainContent, .shopify-section:has(.lx-how) { background: #050505 !important; }
  .lx-how {
    position: relative;
    color: #f5f5f5;
    padding: clamp(28px, 6vw, 72px) 16px clamp(48px, 8vw, 96px);
    overflow: hidden;
  }
  .lx-how__glow {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 60% 40% at 50% -5%, rgba(255,98,0,0.18), transparent 65%);
  }
  .lx-how__inner { position: relative; z-index: 1; max-width: 640px; margin: 0 auto; }
  .lx-how__eyebrow {
    margin: 0 0 10px; font-size: 0.72rem; font-weight: 750; letter-spacing: 0.16em;
    text-transform: uppercase; color: #ff6200; text-align: center;
  }
  .lx-how__title {
    margin: 0 0 12px; text-align: center; font-size: clamp(1.5rem, 5vw, 2.2rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.15;
  }
  .lx-how__lede {
    margin: 0 0 28px; text-align: center; color: rgba(245,245,245,0.62); line-height: 1.5;
  }
  .lx-how__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .lx-how__steps li {
    display: grid; grid-template-columns: 44px 1fr; gap: 14px; align-items: start;
    padding: 18px 0; border-top: 1px solid rgba(255,255,255,0.1);
  }
  .lx-how__steps li:last-child { border-bottom: 1px solid rgba(255,255,255,0.1); }
  .lx-how__num {
    font-size: 0.85rem; font-weight: 800; color: #ff6200; letter-spacing: 0.04em; padding-top: 2px;
  }
  .lx-how__steps h2 {
    margin: 0 0 6px; font-size: 1.05rem; font-weight: 700; letter-spacing: -0.02em;
  }
  .lx-how__steps p { margin: 0; color: rgba(245,245,245,0.62); line-height: 1.45; font-size: 0.94rem; }
  .lx-how__trust {
    display: grid; gap: 8px; margin: 24px 0 16px; padding: 16px;
    border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; background: #111;
  }
  .lx-how__trust p { margin: 0; font-size: 0.9rem; color: rgba(245,245,245,0.78); }
  .lx-how__risk {
    margin: 0 0 24px; padding: 14px 16px; border-radius: 14px;
    background: rgba(255,98,0,0.08); border: 1px solid rgba(255,98,0,0.22);
    font-size: 0.9rem; line-height: 1.45; color: rgba(245,245,245,0.82);
  }
  .lx-how__risk a { color: #ff6200; }
  .lx-how__actions { display: flex; flex-direction: column; gap: 10px; align-items: stretch; }
  .lx-how__btn {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 3px; text-decoration: none; min-height: 52px; padding: 12px 16px; border-radius: 999px;
    text-align: center;
  }
  .lx-how__btn--primary { background: #ff6200; color: #0a0a0a; }
  .lx-how__btn--ghost { border: 1px solid rgba(255,255,255,0.16); color: #f5f5f5; }
  .lx-how__btn-main { font-weight: 750; font-size: 0.95rem; }
  .lx-how__btn-sub { font-size: 0.75rem; opacity: 0.72; }
  .lx-how__link {
    text-align: center; color: rgba(245,245,245,0.55); font-size: 0.88rem; text-decoration: none;
    padding: 8px;
  }
</style>

{% schema %}
{
  "name": "LURVOX How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How LURVOX works" },
    { "type": "text", "id": "title", "label": "Title", "default": "From checkout to weekly coaching" },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "Built for India: vegetarian and home cooked diets, gym or home workouts, and a real coach in the app. Not a PDF dump." },
    { "type": "text", "id": "find_url", "label": "Find plan URL", "default": "/pages/choose-your-plan" },
    { "type": "text", "id": "compare_url", "label": "Compare URL", "default": "/pages/compare-fit?view=compare-short" },
    { "type": "text", "id": "plans_url", "label": "Home plans URL", "default": "/#plans" },
    { "type": "text", "id": "refund_url", "label": "Refund URL", "default": "/pages/refund-policy" }
  ],
  "presets": [{ "name": "LURVOX How it works" }]
}
{% endschema %}
