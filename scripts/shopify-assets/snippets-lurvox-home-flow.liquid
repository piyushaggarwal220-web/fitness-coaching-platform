{% comment %}
  LURVOX homepage CTA strips — keep home scroll short and clear.
  mode: find | after_plans
{% endcomment %}

{%- liquid
  assign mode = mode | default: 'find'
  assign find_url = '/pages/choose-your-plan'
  assign how_url = '/pages/how-lurvox-works'
  assign compare_url = '/pages/compare-fit?view=compare-short'
-%}

{%- if mode == 'find' -%}
  {% comment %} Find-your-plan quiz removed — Instant-style fitness quiz lives after transformations. {% endcomment %}
{%- else -%}
  {% render 'lurvox-animated-transforms' %}
  {% render 'lurvox-fitness-quiz' %}
{%- endif -%}

<style>
  .lx-flow {
    background: transparent;
    padding: 8px 16px 28px;
  }
  .lx-flow--after {
    padding: 4px 16px 28px;
  }
  .lx-flow__inner {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
  }

  .lx-flow__inner--stamp {
    align-items: center;
  }

  .lx-flow__inner--stamp {
    align-items: center;
  }
  .lx-flow__inner--links {
    align-items: center;
    gap: 6px;
    text-align: center;
  }
  .lx-flow__hint {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.55);
  }
  .lx-flow__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 10px;
  }
  .lx-flow__link {
    color: #ff6200 !important;
    font-size: 0.95rem;
    font-weight: 750;
    text-decoration: underline !important;
    text-underline-offset: 3px;
  }
  .lx-flow__link--talk {
    font-size: 1.02rem;
    font-weight: 850;
  }
  .lx-flow__sep {
    color: rgba(255, 255, 255, 0.35);
  }
  .lx-flow__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-align: center;
    text-decoration: none !important;
    width: 100%;
    min-height: 56px;
    padding: 16px 18px;
    border-radius: 14px;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
    box-sizing: border-box;
  }
  .lx-flow__btn--primary {
    background: #ff6200 !important;
    color: #0a0a0a !important;
    border: 1px solid #ff6200 !important;
  }
  .lx-flow__btn--how {
    background: #1a1a1a !important;
    color: #ffffff !important;
    border: 1.5px solid rgba(255, 255, 255, 0.55) !important;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06) inset;
  }
  .lx-flow__btn--compare {
    background: rgba(255, 98, 0, 0.14) !important;
    color: #ffffff !important;
    border: 1.5px solid #ff6200 !important;
    box-shadow: 0 8px 24px rgba(255, 98, 0, 0.18);
  }
  .lx-flow__main {
    font-size: 1.02rem !important;
    font-weight: 800 !important;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: inherit !important;
    opacity: 1 !important;
  }
  .lx-flow__main em {
    color: rgba(10, 10, 10, 0.72);
    font-style: normal;
    font-weight: 800;
  }
  .lx-flow__sub {
    font-size: 0.8rem;
    font-weight: 600;
    color: inherit;
    opacity: 0.78;
  }
