{% comment %}
  LURVOX — one floating dock, two orange-and-black actions.
  Talk is first and slightly larger. Quiz CTAs lead with free value, not prices.
  Swap the pair so the current page is not repeated.
  Demo lives on the welcome card / hero, not here.
{% endcomment %}

{%- liquid
  assign find_url = '/pages/choose-your-plan'
  assign talk_url = '/pages/talk-to-a-coach'
  assign plans_url = '/pages/compare-fit?view=compare-short'
  assign on_finder = false
  assign on_talk = false
  assign on_compare = false
  if request.page_type == 'page' and page.handle == 'choose-your-plan'
    assign on_finder = true
  endif
  if request.page_type == 'page' and page.handle == 'talk-to-a-coach'
    assign on_talk = true
  endif
  if request.page_type == 'page' and page.handle == 'book-a-free-call'
    assign on_talk = true
  endif
  if request.page_type == 'page'
    if page.handle == 'compare-fit' or page.handle == 'compare-plans' or page.handle contains 'compare'
      assign on_compare = true
    endif
  endif
-%}

<div class="lx-find-float" data-lx-find-float aria-label="Quick actions">
  {%- if on_finder -%}
    <div class="lx-find-float__row lx-find-float__row--talk-first">
      <a class="lx-find-float__btn lx-find-float__btn--talk" href="{{ talk_url }}">
        <span class="lx-find-float__main">Talk to a coach</span>
        <span class="lx-find-float__sub">Free consult</span>
      </a>
      <a class="lx-find-float__btn" href="{{ plans_url }}">
        <span class="lx-find-float__main">See plans</span>
        <span class="lx-find-float__sub">Compare options</span>
      </a>
    </div>
  {%- elsif on_talk -%}
    <div class="lx-find-float__row">
      <a class="lx-find-float__btn" href="{{ find_url }}">
        <span class="lx-find-float__main">Free Find Your Plan Quiz</span>
        <span class="lx-find-float__sub">No cost · No commitment</span>
      </a>
      <a class="lx-find-float__btn" href="{{ plans_url }}">
        <span class="lx-find-float__main">See plans</span>
        <span class="lx-find-float__sub">Compare options</span>
      </a>
    </div>
  {%- elsif on_compare -%}
    <div class="lx-find-float__row lx-find-float__row--talk-second">
      <a class="lx-find-float__btn" href="{{ find_url }}">
        <span class="lx-find-float__main">Free Find Your Plan Quiz</span>
        <span class="lx-find-float__sub">No cost · No commitment</span>
      </a>
      <a class="lx-find-float__btn lx-find-float__btn--talk" href="{{ talk_url }}">
        <span class="lx-find-float__main">Talk to a coach</span>
        <span class="lx-find-float__sub">Free consult</span>
      </a>
    </div>
  {%- else -%}
    <div class="lx-find-float__row lx-find-float__row--talk-first">
      <a class="lx-find-float__btn lx-find-float__btn--talk" href="{{ talk_url }}">
        <span class="lx-find-float__main">Talk to a coach</span>
        <span class="lx-find-float__sub">Free consult</span>
      </a>
      <a class="lx-find-float__btn" href="{{ find_url }}">
        <span class="lx-find-float__main">Free Find Your Plan Quiz</span>
        <span class="lx-find-float__sub">No cost · No commitment</span>
      </a>
    </div>
  {%- endif -%}
</div>

<style id="lx-find-float-css">
  .lx-find-float {
    position: fixed;
    left: 50%;
    bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    z-index: 2147483000;
    width: min(520px, calc(100vw - 16px));
    max-width: calc(100vw - 14px);
    pointer-events: none;
    box-sizing: border-box;
  }

  body:has(#PBarNextFrameWrapper) .lx-find-float,
  body:has([id*="PBar"]) .lx-find-float,
  html:has(.preview-bar) .lx-find-float {
    bottom: calc(72px + env(safe-area-inset-bottom, 0px));
  }

  .lx-find-float.is-hidden {
    opacity: 0;
    pointer-events: none !important;
    transform: translateX(-50%) translateY(12px);
  }

  .lx-find-float__row {
    pointer-events: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
    align-items: stretch;
    padding: 0;
    border-radius: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .lx-find-float__row--talk-first {
    grid-template-columns: 1.18fr 1fr;
  }

  .lx-find-float__row--talk-second {
    grid-template-columns: 1fr 1.18fr;
  }

  .lx-find-float__btn {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    width: 100%;
    min-height: 56px;
    padding: 10px 10px;
    box-sizing: border-box;
    text-align: center;
    text-decoration: none !important;
    border-radius: 16px;
    color: #1a0c00 !important;
    background: linear-gradient(165deg, #ffc078 0%, #ff9a45 35%, #ff6200 100%) !important;
    border: 0 !important;
    outline: none !important;
    box-shadow:
      0 14px 30px rgba(255, 98, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.45) !important;
    -webkit-tap-highlight-color: transparent;
  }

  .lx-find-float__btn:hover,
  .lx-find-float__btn:focus-visible {
    background: linear-gradient(165deg, #ffd08e 0%, #ffaa55 35%, #ff7418 100%) !important;
    color: #1a0c00 !important;
    filter: brightness(1.03);
  }

  .lx-find-float__btn--talk {
    min-height: 62px;
    box-shadow:
      0 16px 34px rgba(255, 98, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.5) !important;
  }

  .lx-find-float__btn--talk .lx-find-float__main {
    font-size: 1rem;
  }

  .lx-find-float__main {
    font-size: 0.92rem;
    font-weight: 850;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #140900 !important;
  }

  .lx-find-float__sub {
    font-size: 0.68rem;
    font-weight: 650;
    color: rgba(20, 9, 0, 0.78) !important;
    white-space: normal;
    line-height: 1.2;
  }

  body.lx-has-find-float {
    padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px)) !important;
  }

  .lx-flow:not(.lx-flow--after),
  .lx-conv-sticky,
  [data-lx-conv-sticky] {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    .lx-find-float {
      width: calc(100vw - 12px);
      max-width: calc(100vw - 12px);
      bottom: calc(10px + env(safe-area-inset-bottom, 0px));
    }

    .lx-find-float__btn {
      min-height: 54px;
      padding: 9px 8px;
    }

    .lx-find-float__main { font-size: 0.84rem; }
    .lx-find-float__btn--talk .lx-find-float__main { font-size: 0.92rem; }
    .lx-find-float__sub { font-size: 0.62rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lx-find-float { transition: none; }
  }
</style>
<script>
  (function () {
    function place() {
      var el = document.querySelector('[data-lx-find-float]');
      if (!el) return;
      document.body.classList.add('lx-has-find-float');
      el.classList.remove('is-hidden');
      el.setAttribute('aria-hidden', 'false');

      document.querySelectorAll('a[href*="/pages/book-a-free-call"]').forEach(function (a) {
        a.setAttribute('href', '/pages/talk-to-a-coach');
      });

      var bar =
        document.getElementById('PBarNextFrameWrapper') ||
        document.querySelector('[id*="PBar"], .preview-bar, #preview-bar-iframe');
      var gap = 10;
      var lift = 0;
      if (bar) lift = Math.ceil(bar.getBoundingClientRect().height || 64);
      el.style.bottom = 'calc(' + (lift + gap) + 'px + env(safe-area-inset-bottom, 0px))';

      var h = Math.ceil(el.getBoundingClientRect().height || 52);
      var pad = lift + gap + h + 18;
      document.body.style.paddingBottom = 'calc(' + pad + 'px + env(safe-area-inset-bottom, 0px))';
    }

    place();
    window.addEventListener('resize', place);
    window.addEventListener('orientationchange', place);
    setTimeout(place, 300);
    setTimeout(place, 1000);
  })();
</script>
