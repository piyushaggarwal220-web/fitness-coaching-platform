<section class="lx-welcome" id="lx-welcome" style="--lx-accent: {{ section.settings.accent_color }};">
  <style>
    /* Must be a raw <style> so it is not scoped to this section. */
    [class*="ai-fitness-gallery__reviews-"] {
      display: none !important;
    }
    /* Hide leftover unsourced sale banners. Keep the brand top bar. */
    [id*="offer-strip"]:not(.lurvox-offer-strip--brand):not(#lurvox-offer-strip-home):not(#lurvox-offer-strip-live) {
      display: none !important;
    }
  </style>
  <div class="lx-welcome__inner">
    <article class="lx-welcome__card">
      <p class="lx-welcome__eyebrow">Try it first</p>
      <h1 class="lx-welcome__headline">{{ section.settings.headline }}</h1>
      {%- if section.settings.lede != blank -%}
        <p class="lx-welcome__lede">{{ section.settings.lede }}</p>
      {%- endif -%}
      {%- if section.settings.demo_enabled and section.settings.demo_ask != blank -%}
        <p class="lx-welcome__ask">{{ section.settings.demo_ask }}</p>
      {%- endif -%}
      {%- if section.settings.demo_enabled -%}
        <div class="lx-welcome__actions">
          <a class="lx-welcome__btn lx-welcome__btn--primary" href="{{ section.settings.demo_url }}">
            <span class="lx-welcome__btn-main">{{ section.settings.demo_label | default: 'Try the platform free' }}</span>
            <span class="lx-welcome__btn-sub">No signup. Look around first.</span>
          </a>
        </div>
      {%- endif -%}
    </article>
  </div>
</section>

{% stylesheet %}
.lx-welcome {
  --lx-accent: #ff6200;
  background: #070707;
  color: #fff;
  padding: 8px 16px 28px;
}

.lx-welcome__inner {
  max-width: 720px;
  margin: 0 auto;
}

.lx-welcome__card {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding: 20px 18px 18px;
  border-radius: 20px;
  background:
    radial-gradient(ellipse 90% 80% at 8% -20%, rgba(255, 98, 0, 0.22), transparent 55%),
    linear-gradient(180deg, #14110e 0%, #0c0c0c 100%);
  border: 1px solid rgba(255, 98, 0, 0.38);
  box-shadow:
    0 0 0 1px rgba(255, 98, 0, 0.08),
    0 18px 48px rgba(0, 0, 0, 0.35),
    0 0 36px rgba(255, 98, 0, 0.12);
}

.lx-welcome__card::before {
  content: '';
  position: absolute;
  inset: auto -20% -40% auto;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 98, 0, 0.18), transparent 68%);
  pointer-events: none;
  z-index: -1;
}

.lx-welcome__eyebrow {
  margin: 0 0 8px;
  color: var(--lx-accent);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.lx-welcome__headline {
  margin: 0 0 6px;
  font-size: clamp(26px, 6.8vw, 38px);
  line-height: 1.08;
  letter-spacing: -0.04em;
  font-weight: 800;
}

.lx-welcome__lede {
  margin: 0 0 8px;
  color: rgba(255, 255, 255, 0.9);
  font-size: clamp(15px, 3.6vw, 18px);
  line-height: 1.4;
  font-weight: 600;
}

.lx-welcome__ask {
  margin: 0 0 14px;
  color: rgba(255, 255, 255, 0.64);
  font-size: 13.5px;
  line-height: 1.45;
}

.lx-welcome__actions {
  display: grid;
  gap: 10px;
  justify-items: stretch;
}

.lx-welcome__btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  width: 100%;
  min-height: 54px;
  padding: 13px 18px;
  border-radius: 14px;
  text-decoration: none !important;
  text-align: center;
  box-sizing: border-box;
  line-height: 1.2;
}

.lx-welcome__btn--primary {
  background: linear-gradient(165deg, #ff9a45 0%, var(--lx-accent) 70%, #e85700 100%);
  border: 0 !important;
  color: #140900 !important;
  box-shadow:
    0 12px 28px rgba(255, 98, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.28);
}

.lx-welcome__btn-main {
  font-size: 15.5px;
  font-weight: 850;
}

.lx-welcome__btn-sub {
  font-size: 12px;
  font-weight: 650;
  color: rgba(20, 9, 0, 0.72);
}

@media screen and (min-width: 750px) {
  .lx-welcome {
    padding: 12px 24px 36px;
  }

  .lx-welcome__card {
    padding: 24px 26px 22px;
  }

  .lx-welcome__actions {
    max-width: 320px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Landing welcome",
  "settings": [
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "Try the app" },
    { "type": "textarea", "id": "lede", "label": "Support line", "default": "See a live coaching plan before you pay." },
    { "type": "checkbox", "id": "demo_enabled", "label": "Show demo login", "default": true },
    { "type": "text", "id": "demo_ask", "label": "Demo ask", "default": "No signup. Look around first." },
    { "type": "text", "id": "demo_label", "label": "Demo link", "default": "Try the platform free" },
    { "type": "text", "id": "demo_url", "label": "Demo URL", "default": "https://app.lurvox.in/try" },
    { "type": "checkbox", "id": "call_enabled", "label": "Show book-a-call", "default": true },
    { "type": "text", "id": "call_label", "label": "Call button", "default": "Book a free call" },
    { "type": "text", "id": "call_url", "label": "Call URL", "default": "/pages/talk-to-a-coach" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#FF6200" }
  ],
  "presets": [{ "name": "Landing welcome" }]
}
{% endschema %}
