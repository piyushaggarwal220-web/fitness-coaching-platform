{% comment %}
  Piyush + Rakshit photos with Instagram profile links.
{% endcomment %}
<div class="lx-coaches" aria-label="LURVOX coaches">
  <a class="lx-coach" href="https://www.instagram.com/maximusvault/" target="_blank" rel="noopener noreferrer">
    <img src="https://app.lurvox.in/landing/instant-coach-piyush.png" alt="Piyush Aggarwal, LURVOX coach" width="400" height="533" loading="lazy" />
    <strong>Piyush</strong>
    <span>@maximusvault</span>
  </a>
  <a class="lx-coach" href="https://www.instagram.com/rakshitmohla_/" target="_blank" rel="noopener noreferrer">
    <img src="https://app.lurvox.in/landing/instant-coach-rakshit.png" alt="Rakshit Mohla, LURVOX coach" width="400" height="533" loading="lazy" />
    <strong>Rakshit</strong>
    <span>@rakshitmohla_</span>
  </a>
</div>
<p class="lx-coaches-hint">Tap a handle to open Instagram</p>
<style>
  .lx-coaches {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    max-width: 520px;
    margin: 0 auto 22px;
  }
  .lx-coach {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0 0 12px;
    border-radius: 18px;
    overflow: hidden;
    background: #141414;
    border: 1px solid rgba(255, 98, 0, 0.35);
    color: #fff;
    text-decoration: none;
  }
  .lx-coach img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: center 12%;
    display: block;
  }
  .lx-coach strong {
    margin-top: 4px;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }
  .lx-coach span {
    color: #ff6200;
    font-size: 15px;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .lx-coaches-hint {
    margin: 0 auto 18px;
    max-width: 520px;
    text-align: center;
    color: rgba(255, 255, 255, 0.62);
    font-size: 13px;
    font-weight: 600;
  }
</style>
