{% doc %}
Draft-only: swap selected orange accents to shiny purple glow.
No page overlay. Filled orange CTAs stay orange.
{% enddoc %}

<style id="lx-purple-sheen">
  :root {
    --lx-purple-deep: #3b0764;
    --lx-purple-rich: #7c3aed;
    --lx-purple-shine: #a78bfa;
    --lx-purple-glint: #c4b5fd;
    --lx-text-glow-soft:
      0 0 8px rgba(196, 181, 253, 0.7),
      0 0 22px rgba(167, 139, 250, 0.45),
      0 0 44px rgba(124, 58, 237, 0.28) !important;
    --lx-text-glow-accent:
      0 0 7px rgba(196, 181, 253, 0.85),
      0 0 18px rgba(167, 139, 250, 0.55),
      0 0 36px rgba(124, 58, 237, 0.3) !important;
    --lx-text-glow-body: none !important;
    --lx-text-glow-plan-details:
      0 0 1px rgba(255, 255, 255, 0.95),
      0 0 6px rgba(196, 181, 253, 0.8),
      0 0 16px rgba(167, 139, 250, 0.45),
      0 0 28px rgba(124, 58, 237, 0.22) !important;
    --lx-nav-orange: #c4b5fd !important;
    --lx-nav-line: rgba(167, 139, 250, 0.4) !important;
  }

  /* Kill the old orange body-text haze so purple is only on chosen accents */
  main h3,
  main h4,
  main p,
  main li,
  main th,
  main td,
  main label,
  main a,
  main button,
  main span,
  main strong {
    text-shadow: none !important;
  }

  main h1,
  main h2,
  main [class*='headline'],
  main [class*='title'],
  main [class*='plan-card-price'],
  main [class*='plan-price'],
  main [class*='savings'],
  main [class*='eyebrow'],
  .lx-matrix__heading p,
  .lx-matrix__table thead strong,
  .lx-hdr__wordmark,
  .lx-pf__eyebrow {
    color: inherit;
    text-shadow: var(--lx-text-glow-soft) !important;
  }

  main [class*='plan-label'],
  main [class*='plan-badge'],
  main [class*='plan-duration'],
  main [class*='plan-monthly'] {
    text-shadow: var(--lx-text-glow-plan-details) !important;
  }

  main h1::before,
  main h2::before {
    background: radial-gradient(
      ellipse at left center,
      rgba(196, 181, 253, 0.42),
      rgba(124, 58, 237, 0.16) 45%,
      transparent 72%
    ) !important;
  }

  main h1::after,
  main h2::after {
    content: none !important;
    display: none !important;
  }

  main a:hover,
  main button:hover {
    text-shadow:
      0 0 8px rgba(196, 181, 253, 0.55),
      0 0 18px rgba(124, 58, 237, 0.28) !important;
  }

  #header-group .lurvox-offer-strip,
  #header-group #lurvox-offer-strip-live,
  #header-group #lurvox-offer-strip-home,
  .lurvox-offer-strip.lurvox-offer-strip--home,
  aside.lurvox-offer-strip,
  .shopify-section-group-header-group .lurvox-offer-strip,
  .shopify-section-group-header-group .lurvox-client-login {
    background: #050505 !important;
    background-image: none !important;
    border-bottom: 1px solid rgba(167, 139, 250, 0.35) !important;
  }

  .lurvox-offer-strip__copy,
  .lurvox-offer-strip__copy strong,
  .lurvox-offer-strip strong,
  .lurvox-offer-strip__emoji {
    color: #c4b5fd !important;
    text-shadow:
      0 0 8px rgba(196, 181, 253, 0.85),
      0 0 20px rgba(124, 58, 237, 0.45) !important;
    filter: drop-shadow(0 0 8px rgba(167, 139, 250, 0.55));
  }

  .lurvox-offer-strip__timer {
    border: 1px solid #a78bfa !important;
    background: rgba(124, 58, 237, 0.18) !important;
    box-shadow: 0 0 18px rgba(124, 58, 237, 0.4) !important;
    color: #fff !important;
  }

  a.header-actions__action[href*='talk-to-a-coach'],
  a.header-actions__action[href*='talk-to-a-coach'] .svg-wrapper,
  a.header-actions__action[href*='talk-to-a-coach'] svg,
  a.lx-header-login,
  a.lurvox-client-login__link,
  .lurvox-client-login__link svg {
    color: #c4b5fd !important;
    text-shadow:
      0 0 8px rgba(196, 181, 253, 0.8),
      0 0 18px rgba(124, 58, 237, 0.4) !important;
    filter: drop-shadow(0 0 6px rgba(167, 139, 250, 0.55));
  }

  a.lurvox-client-login__link:hover,
  a.lx-header-login:hover {
    color: #e9d5ff !important;
  }

  .lx-pf__eyebrow,
  .lx-how [class*='kicker'],
  .lx-how__risk a,
  [class*='ai-transformation-plan-badge'] {
    color: #c4b5fd !important;
    text-shadow:
      0 0 8px rgba(196, 181, 253, 0.75),
      0 0 18px rgba(124, 58, 237, 0.35) !important;
  }

  [class*='ai-transformation-plan-badge'] {
    background: rgba(124, 58, 237, 0.18) !important;
    border-color: rgba(167, 139, 250, 0.45) !important;
    box-shadow: 0 0 14px rgba(124, 58, 237, 0.32);
  }

  .lx-pf__progress-bar {
    background: linear-gradient(90deg, #7c3aed, #c4b5fd) !important;
    box-shadow: 0 0 14px rgba(167, 139, 250, 0.55) !important;
  }

  @media (prefers-contrast: more), (forced-colors: active) {
    main h1,
    main h2,
    .lurvox-offer-strip__copy,
    a.lx-header-login,
    a.header-actions__action[href*='talk-to-a-coach'] {
      text-shadow: none !important;
      filter: none !important;
    }
  }
</style>
