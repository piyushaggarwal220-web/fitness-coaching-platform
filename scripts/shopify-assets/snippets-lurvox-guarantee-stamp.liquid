{% comment %}
  Moneyback guarantee stamp for Orange theme — Instant-style seal.
{% endcomment %}
<div class="lx-guarantee-stamp" aria-label="Guaranteed results, moneyback if none">
  <span class="lx-guarantee-stamp__ring">
    <span class="lx-guarantee-stamp__top">Guaranteed</span>
    <span class="lx-guarantee-stamp__mid">Results</span>
    <span class="lx-guarantee-stamp__bot">Moneyback</span>
  </span>
</div>

<style>
  .lx-guarantee-stamp {
    --lx-orange: #ff6200;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 148px;
    height: 148px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #ffb020;
    border: 5px solid #111;
    box-shadow:
      0 0 0 4px #fff,
      0 0 0 8px var(--lx-orange),
      0 14px 32px rgba(0, 0, 0, 0.35);
    transform: rotate(-9deg);
  }
  .lx-guarantee-stamp__ring {
    width: 118px;
    height: 118px;
    border-radius: 50%;
    border: 3px dashed var(--lx-orange);
    background: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    text-align: center;
    padding: 8px;
    box-sizing: border-box;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  .lx-guarantee-stamp__top,
  .lx-guarantee-stamp__bot {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lx-orange);
    line-height: 1.05;
  }
  .lx-guarantee-stamp__mid {
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #111;
    line-height: 1;
  }
  @media (max-width: 480px) {
    .lx-guarantee-stamp {
      width: 128px;
      height: 128px;
    }
    .lx-guarantee-stamp__ring {
      width: 100px;
      height: 100px;
    }
    .lx-guarantee-stamp__mid {
      font-size: 15px;
    }
  }
</style>
