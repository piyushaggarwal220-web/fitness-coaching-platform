{% comment %}
  Strong guaranteed-results stamp for Orange marketing pages.
{% endcomment %}
<div class="lx-guarantee-stamp" aria-label="Guaranteed results, moneyback if none">
  <span class="lx-guarantee-stamp__ring">
    <span class="lx-guarantee-stamp__top">Guaranteed</span>
    <span class="lx-guarantee-stamp__mid">Results</span>
    <span class="lx-guarantee-stamp__bot">Moneyback</span>
  </span>
</div>

<style>
  .lx-guarantee-stamp {
    --lx-orange: #ff6200;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 118px;
    height: 118px;
    flex-shrink: 0;
  }
  .lx-guarantee-stamp__ring {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 3px solid var(--lx-orange);
    box-shadow:
      0 0 0 4px rgba(255, 98, 0, 0.18),
      inset 0 0 0 2px rgba(255, 98, 0, 0.35);
    background:
      radial-gradient(circle at 35% 30%, rgba(255, 98, 0, 0.22), transparent 55%),
      rgba(8, 8, 8, 0.92);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    transform: rotate(-8deg);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  .lx-guarantee-stamp__top,
  .lx-guarantee-stamp__bot {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }
  .lx-guarantee-stamp__mid {
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1;
  }
</style>
