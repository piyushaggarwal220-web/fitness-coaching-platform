{% javascript %}
  (function () {
    const root = document.querySelector('[data-lx-home]');
    if (!root) return;

    const reveals = root.querySelectorAll('.lx-home__reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      reveals.forEach((el) => io.observe(el));
    } else {
      reveals.forEach((el) => el.classList.add('is-in'));
    }

    const plans = root.querySelector('[data-lx-plans]');
    if (!plans) return;
    const cta = plans.querySelector('[data-plan-cta]');
    const cards = plans.querySelectorAll('[data-plan-card]');
    const radios = plans.querySelectorAll('input[name="lx-plan"]');

    function syncPlan() {
      const selected = plans.querySelector('input[name="lx-plan"]:checked');
      cards.forEach((card) => card.classList.remove('is-selected'));
      if (!selected) return;
      selected.closest('[data-plan-card]')?.classList.add('is-selected');
      if (cta && selected.dataset.planLink) cta.setAttribute('href', selected.dataset.planLink);
    }

    radios.forEach((radio) => radio.addEventListener('change', syncPlan));
    syncPlan();

    const urgency = root.querySelector('[data-lx-urgency]');
    const countdownEl = urgency && urgency.querySelector('[data-lx-countdown]');
    if (urgency && countdownEl) {
      const hours = parseInt(urgency.getAttribute('data-hours'), 10) || 8;
      const storageKey = 'lurvox-urgency-countdown-end-v2';
      const durationMs = hours * 60 * 60 * 1000;
      let endTime = 0;
      try {
        const stored = localStorage.getItem(storageKey);
        const parsed = stored ? parseInt(stored, 10) : NaN;
        if (Number.isFinite(parsed) && parsed > Date.now()) endTime = parsed;
      } catch (e) {}
      if (!endTime) {
        endTime = Date.now() + durationMs;
        try { localStorage.setItem(storageKey, String(endTime)); } catch (e) {}
      }
      const tick = () => {
        let distance = endTime - Date.now();
        if (distance <= 0) {
          endTime = Date.now() + durationMs;
          try { localStorage.setItem(storageKey, String(endTime)); } catch (e) {}
          distance = durationMs;
        }
        const h = Math.floor(distance / 3600000);
        const m = Math.floor((distance % 3600000) / 60000);
        const s = Math.floor((distance % 60000) / 1000);
        countdownEl.textContent =
          String(h).padStart(2, '0') + ':' +
          String(m).padStart(2, '0') + ':' +
          String(s).padStart(2, '0');
      };
      tick();
      setInterval(tick, 1000);
    }
  })();
{% endjavascript %}

