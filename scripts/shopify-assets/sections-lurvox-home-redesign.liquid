{% comment %}
  LURVOX Homepage Redesign — Athletic Editorial
  Draft-theme only. Do not publish without review.
{% endcomment %}

<section class="lx-home" id="lx-home" data-lx-home>
  <div class="lx-home__grain" aria-hidden="true"></div>

  {%- comment -%} 1. Hero {%- endcomment -%}
  <header class="lx-home__hero">
    <div class="lx-home__hero-media" aria-hidden="true">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            class: 'lx-home__hero-img',
            widths: '800, 1200, 1600, 2400',
            sizes: '100vw',
            alt: ''
        }}
      {%- endif -%}
      <div class="lx-home__hero-veil"></div>
    </div>

    <div class="lx-home__hero-copy lx-home__reveal">
      <p class="lx-home__brand">{{ section.settings.brand_name }}</p>
      <h1 class="lx-home__headline">{{ section.settings.hero_headline }}</h1>
      <p class="lx-home__lede">{{ section.settings.hero_lede }}</p>
      <div class="lx-home__cta-row">
        <a class="lx-home__btn lx-home__btn--primary" href="#plans">{{ section.settings.hero_cta_label }}</a>
        <a class="lx-home__btn lx-home__btn--ghost" href="#how-it-works">{{ section.settings.hero_secondary_label }}</a>
      </div>
    </div>
  </header>

  {%- comment -%} 2. Trust {%- endcomment -%}
  <div class="lx-home__trust lx-home__reveal" aria-label="Social proof">
    <p class="lx-home__trust-line">
      <span>{{ section.settings.trust_reviews }}</span>
      <span class="lx-home__trust-dot" aria-hidden="true"></span>
      <span>{{ section.settings.trust_outcomes }}</span>
      <span class="lx-home__trust-dot" aria-hidden="true"></span>
      <span>{{ section.settings.trust_coach }}</span>
    </p>
  </div>

  {%- comment -%} 3. How coaching works {%- endcomment -%}
  <section class="lx-home__block" id="how-it-works">
    <div class="lx-home__block-inner lx-home__reveal">
      <p class="lx-home__label">{{ section.settings.how_label }}</p>
      <h2 class="lx-home__title">{{ section.settings.how_title }}</h2>
      <p class="lx-home__copy">{{ section.settings.how_copy }}</p>
      <ol class="lx-home__steps">
        <li>
          <span class="lx-home__step-num">01</span>
          <div>
            <h3>{{ section.settings.step_1_title }}</h3>
            <p>{{ section.settings.step_1_body }}</p>
          </div>
        </li>
        <li>
          <span class="lx-home__step-num">02</span>
          <div>
            <h3>{{ section.settings.step_2_title }}</h3>
            <p>{{ section.settings.step_2_body }}</p>
          </div>
        </li>
        <li>
          <span class="lx-home__step-num">03</span>
          <div>
            <h3>{{ section.settings.step_3_title }}</h3>
            <p>{{ section.settings.step_3_body }}</p>
          </div>
        </li>
        <li>
          <span class="lx-home__step-num">04</span>
          <div>
            <h3>{{ section.settings.step_4_title }}</h3>
            <p>{{ section.settings.step_4_body }}</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {%- comment -%} 4. What you get {%- endcomment -%}
  <section class="lx-home__block lx-home__block--journey" id="what-you-get">
    <div class="lx-home__block-inner lx-home__reveal">
      <p class="lx-home__label">{{ section.settings.wyg_label }}</p>
      <h2 class="lx-home__title">{{ section.settings.wyg_title }}</h2>
      <p class="lx-home__copy">{{ section.settings.wyg_copy }}</p>
      <div class="lx-home__journey">
        <article>
          <h3>{{ section.settings.wyg_1_title }}</h3>
          <p>{{ section.settings.wyg_1_body }}</p>
        </article>
        <article>
          <h3>{{ section.settings.wyg_2_title }}</h3>
          <p>{{ section.settings.wyg_2_body }}</p>
        </article>
        <article>
          <h3>{{ section.settings.wyg_3_title }}</h3>
          <p>{{ section.settings.wyg_3_body }}</p>
        </article>
        <article>
          <h3>{{ section.settings.wyg_4_title }}</h3>
          <p>{{ section.settings.wyg_4_body }}</p>
        </article>
      </div>
    </div>
  </section>

  {%- comment -%} 5. Transformations {%- endcomment -%}
  <section class="lx-home__block lx-home__block--gallery" id="transformations">
    <div class="lx-home__block-inner lx-home__reveal">
      <p class="lx-home__label">{{ section.settings.gallery_label }}</p>
      <h2 class="lx-home__title">{{ section.settings.gallery_title }}</h2>
      <p class="lx-home__copy">{{ section.settings.gallery_copy }}</p>
    </div>
    <div class="lx-home__gallery" role="list">
      {%- for i in (1..6) -%}
        {%- assign img_key = 'transform_image_' | append: i -%}
        {%- assign title_key = 'transform_title_' | append: i -%}
        {%- assign name_key = 'transform_name_' | append: i -%}
        {%- assign img = section.settings[img_key] -%}
        {%- if img != blank -%}
          <figure class="lx-home__gallery-item" role="listitem">
            {{
              img
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                class: 'lx-home__gallery-img',
                widths: '400, 700, 1000, 1200',
                sizes: '(min-width: 900px) 33vw, 85vw',
                alt: section.settings[title_key]
            }}
            <figcaption>
              <strong>{{ section.settings[title_key] }}</strong>
              <span>{{ section.settings[name_key] }}</span>
            </figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} 6. Plans {%- endcomment -%}
  <section class="lx-home__block lx-home__block--plans" id="plans" data-lx-plans>
    <div class="lx-home__block-inner lx-home__reveal">
      <p class="lx-home__label">{{ section.settings.plans_label }}</p>
      <h2 class="lx-home__title">{{ section.settings.plans_title }}</h2>
      <p class="lx-home__copy">{{ section.settings.plans_copy }}</p>

      <div class="lx-home__urgency" data-lx-urgency data-hours="8">
        <p class="lx-home__urgency-label">Price increases in</p>
        <p class="lx-home__urgency-timer" data-lx-countdown>08:00:00</p>
        <p class="lx-home__urgency-note">Lock today’s pricing before the next increase.</p>
      </div>

      <div class="lx-home__plan-grid" role="radiogroup" aria-label="Coaching plans">
        {%- for i in (1..4) -%}
          {%- assign enabled_key = 'plan_' | append: i | append: '_enabled' -%}
          {%- unless i == 1 -%}
            {%- if section.settings[enabled_key] -%}
            {%- assign label_key = 'plan_' | append: i | append: '_label' -%}
            {%- assign badge_key = 'plan_' | append: i | append: '_badge' -%}
            {%- assign duration_key = 'plan_' | append: i | append: '_duration' -%}
            {%- assign price_key = 'plan_' | append: i | append: '_price' -%}
            {%- assign original_key = 'plan_' | append: i | append: '_original' -%}
            {%- assign savings_key = 'plan_' | append: i | append: '_savings' -%}
            {%- assign monthly_key = 'plan_' | append: i | append: '_monthly' -%}
            {%- assign desc_key = 'plan_' | append: i | append: '_desc' -%}
            {%- assign link_key = 'plan_' | append: i | append: '_link' -%}
            {%- assign default_key = 'plan_' | append: i | append: '_default' -%}
            <label
              class="lx-home__plan{% if section.settings[default_key] %} is-selected{% endif %}"
              data-plan-card
            >
              <input
                type="radio"
                name="lx-plan"
                value="{{ i }}"
                data-plan-link="{{ section.settings[link_key] }}"
                {% if section.settings[default_key] %}checked{% endif %}
              >
              {%- if section.settings[badge_key] != blank -%}
                <span class="lx-home__plan-badge">{{ section.settings[badge_key] }}</span>
              {%- endif -%}
              <span class="lx-home__plan-label">{{ section.settings[label_key] }}</span>
              <span class="lx-home__plan-duration">{{ section.settings[duration_key] }}</span>
              <span class="lx-home__plan-price">
                <span class="lx-home__plan-currency">₹</span>{{ section.settings[price_key] }}
              </span>
              {%- if section.settings[original_key] != blank -%}
                <span class="lx-home__plan-original">₹{{ section.settings[original_key] }}</span>
              {%- endif -%}
              {%- if section.settings[savings_key] != blank -%}
                <span class="lx-home__plan-savings">{{ section.settings[savings_key] }}</span>
              {%- endif -%}
              <span class="lx-home__plan-monthly">{{ section.settings[monthly_key] }}</span>
              <span class="lx-home__plan-desc">{{ section.settings[desc_key] }}</span>
            </label>
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>

      <div class="lx-home__plan-actions">
        <a class="lx-home__btn lx-home__btn--primary lx-home__btn--wide" href="{{ section.settings.plan_3_link }}" data-plan-cta>
          {{ section.settings.plans_cta }}
        </a>
        <p class="lx-home__plan-note">{{ section.settings.plans_note }}</p>
      </div>
    </div>
  </section>

  {%- comment -%} 7. Consistency League tease {%- endcomment -%}
  <section class="lx-home__block lx-home__block--league" id="league">
    <div class="lx-home__block-inner lx-home__reveal">
      <p class="lx-home__label">{{ section.settings.league_label }}</p>
      <h2 class="lx-home__title">{{ section.settings.league_title }}</h2>
      <p class="lx-home__copy">{{ section.settings.league_copy }}</p>
      <a class="lx-home__btn lx-home__btn--ghost" href="{{ section.settings.league_link }}">
        {{ section.settings.league_cta }}
      </a>
    </div>
  </section>

  {%- comment -%} 8. FAQ {%- endcomment -%}
  <section class="lx-home__block" id="faq">
    <div class="lx-home__block-inner lx-home__reveal">
      <p class="lx-home__label">{{ section.settings.faq_label }}</p>
      <h2 class="lx-home__title">{{ section.settings.faq_title }}</h2>
      <div class="lx-home__faq">
        {%- for i in (1..6) -%}
          {%- assign q_key = 'faq_q_' | append: i -%}
          {%- assign a_key = 'faq_a_' | append: i -%}
          {%- if section.settings[q_key] != blank -%}
            <details class="lx-home__faq-item">
              <summary>{{ section.settings[q_key] }}</summary>
              <p>{{ section.settings[a_key] }}</p>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} 9. Final CTA {%- endcomment -%}
  <section class="lx-home__finale" id="start">
    <div class="lx-home__finale-inner lx-home__reveal">
      <p class="lx-home__brand lx-home__brand--sm">{{ section.settings.brand_name }}</p>
      <h2 class="lx-home__finale-title">{{ section.settings.finale_title }}</h2>
      <p class="lx-home__copy">{{ section.settings.finale_copy }}</p>
      <div class="lx-home__cta-row">
        <a class="lx-home__btn lx-home__btn--primary" href="#plans">{{ section.settings.finale_cta }}</a>
        {%- if section.settings.contact_link != blank -%}
          <a class="lx-home__btn lx-home__btn--ghost" href="{{ section.settings.contact_link }}">
            {{ section.settings.contact_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>
</section>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Outfit:wght@400;500;600;700&display=swap');

  .lx-home {
    --lx-ink: #0b0c0e;
    --lx-ink-2: #12141a;
    --lx-surface: #181b22;
    --lx-line: rgba(244, 239, 232, 0.12);
    --lx-text: #f3efe8;
    --lx-muted: rgba(243, 239, 232, 0.68);
    --lx-ember: #e85d04;
    --lx-ember-hot: #ff7a1a;
    --lx-ember-soft: rgba(232, 93, 4, 0.16);
    --lx-max: 1120px;
    --lx-pad: clamp(20px, 4vw, 40px);
    position: relative;
    overflow: clip;
    background: var(--lx-ink);
    color: var(--lx-text);
    font-family: 'Outfit', system-ui, sans-serif;
    font-weight: 400;
    line-height: 1.5;
  }

  .lx-home__grain {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.35;
    background-image:
      radial-gradient(ellipse 70% 40% at 50% -5%, rgba(232, 93, 4, 0.18), transparent 55%),
      radial-gradient(ellipse 50% 30% at 100% 40%, rgba(232, 93, 4, 0.06), transparent 50%),
      linear-gradient(180deg, #0f1115 0%, var(--lx-ink) 30%, #090a0c 100%);
  }

  .lx-home__hero,
  .lx-home__trust,
  .lx-home__block-inner,
  .lx-home__finale-inner {
    position: relative;
    z-index: 1;
  }

  .lx-home__hero {
    display: grid;
    min-height: min(100svh, 920px);
    place-items: end stretch;
  }

  .lx-home__hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .lx-home__hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: saturate(0.92) contrast(1.05);
  }

  .lx-home__hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(11, 12, 14, 0.45) 0%, rgba(11, 12, 14, 0.62) 38%, rgba(11, 12, 14, 0.97) 100%),
      linear-gradient(90deg, rgba(11, 12, 14, 0.7) 0%, transparent 58%);
  }

  .lx-home__hero-copy {
    position: relative;
    z-index: 2;
    width: min(var(--lx-max), calc(100% - 2 * var(--lx-pad)));
    margin: 0 auto;
    padding: clamp(100px, 18vw, 160px) 0 clamp(96px, 14vw, 140px);
  }

  .lx-home__brand {
    margin: 0 0 18px;
    font-family: 'Syne', sans-serif;
    font-size: clamp(42px, 9vw, 88px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-transform: uppercase;
  }

  .lx-home__brand--sm {
    font-size: clamp(28px, 5vw, 40px);
    margin-bottom: 16px;
  }

  .lx-home__headline {
    margin: 0 0 16px;
    max-width: 16ch;
    font-family: 'Syne', sans-serif;
    font-size: clamp(26px, 4.6vw, 44px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .lx-home__lede,
  .lx-home__copy {
    margin: 0;
    max-width: 34rem;
    color: var(--lx-muted);
    font-size: clamp(15px, 1.7vw, 17px);
    line-height: 1.65;
  }

  .lx-home__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .lx-home__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    border: 1px solid transparent;
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 220ms ease, background 220ms ease, border-color 220ms ease, color 220ms ease;
  }

  .lx-home__btn:hover {
    transform: translateY(-1px);
  }

  .lx-home__btn--primary {
    background: var(--lx-ember);
    color: #140900;
  }

  .lx-home__btn--primary:hover {
    background: var(--lx-ember-hot);
  }

  .lx-home__btn--ghost {
    border-color: var(--lx-line);
    background: transparent;
    color: var(--lx-text);
  }

  .lx-home__btn--ghost:hover {
    border-color: rgba(243, 239, 232, 0.35);
  }

  .lx-home__btn--wide {
    width: min(100%, 420px);
  }

  .lx-home__trust {
    width: min(var(--lx-max), calc(100% - 2 * var(--lx-pad)));
    margin: 0 auto;
    padding: 8px 0 40px;
    border-bottom: 1px solid var(--lx-line);
  }

  .lx-home__trust-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin: 0;
    color: var(--lx-muted);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .lx-home__trust-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--lx-ember);
    opacity: 0.8;
  }

  .lx-home__block {
    position: relative;
    z-index: 1;
    padding: clamp(56px, 10vw, 104px) 0;
  }

  .lx-home__block-inner {
    width: min(var(--lx-max), calc(100% - 2 * var(--lx-pad)));
    margin: 0 auto;
  }

  .lx-home__label {
    margin: 0 0 12px;
    color: var(--lx-ember);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .lx-home__title {
    margin: 0 0 16px;
    max-width: 18ch;
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 4.8vw, 46px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-shadow:
      0 0 24px rgba(255, 255, 255, 0.1),
      0 0 38px rgba(232, 93, 4, 0.12);
  }

  .lx-home__block .lx-home__copy {
    margin-bottom: 36px;
  }

  .lx-home__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--lx-line);
  }

  .lx-home__steps li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--lx-line);
  }

  .lx-home__step-num {
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--lx-ember);
    letter-spacing: -0.02em;
  }

  .lx-home__steps h3 {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 650;
  }

  .lx-home__steps p {
    margin: 0;
    color: var(--lx-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .lx-home__journey {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .lx-home__journey article {
    padding: 24px 0 8px;
    border-top: 1px solid var(--lx-line);
  }

  .lx-home__journey h3 {
    margin: 0 0 10px;
    font-family: 'Syne', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .lx-home__journey p {
    margin: 0;
    color: var(--lx-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .lx-home__block--gallery {
    padding-bottom: clamp(40px, 6vw, 64px);
  }

  .lx-home__gallery {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, 32vw);
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 var(--lx-pad) 8px;
    scrollbar-width: thin;
  }

  .lx-home__gallery-item {
    position: relative;
    margin: 0;
    scroll-snap-align: start;
    overflow: hidden;
    min-height: 360px;
    background: var(--lx-surface);
  }

  .lx-home__gallery-img {
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
    display: block;
  }

  .lx-home__gallery-item figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 48px 16px 16px;
    background: linear-gradient(180deg, transparent, rgba(11, 12, 14, 0.92));
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .lx-home__gallery-item strong {
    font-size: 15px;
    font-weight: 700;
  }

  .lx-home__gallery-item span {
    color: var(--lx-muted);
    font-size: 13px;
  }

  .lx-home__block--plans {
    background:
      linear-gradient(180deg, transparent, rgba(232, 93, 4, 0.05) 40%, transparent),
      var(--lx-ink);
  }

  .lx-home__plan-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 28px;
  }

  .lx-home__urgency {
    margin: 0 0 18px;
    padding: 14px 16px;
    border: 1px solid rgba(255, 98, 0, 0.35);
    border-radius: 16px;
    background:
      linear-gradient(180deg, rgba(255, 98, 0, 0.12), rgba(255, 98, 0, 0.04));
    text-align: center;
    box-shadow: 0 0 28px rgba(255, 98, 0, 0.12);
  }

  .lx-home__urgency-label {
    margin: 0 0 6px;
    color: #ff8a3d;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lx-home__urgency-timer {
    margin: 0;
    color: #fff;
    font-size: clamp(1.7rem, 7vw, 2.2rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    text-shadow:
      0 0 10px rgba(255, 98, 0, 0.45),
      0 0 28px rgba(255, 98, 0, 0.22);
  }

  .lx-home__urgency-note {
    margin: 6px 0 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.78rem;
  }

  .lx-home__plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 20px 20px;
    border: 1px solid var(--lx-line);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.02);
    cursor: pointer;
    transition: border-color 200ms ease, background 200ms ease, transform 200ms ease;
  }

  .lx-home__plan input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .lx-home__plan:hover,
