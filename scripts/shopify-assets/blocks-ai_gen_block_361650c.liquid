<transformation-plan-selector-{{ ai_gen_id }}
  class="ai-transformation-plan-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-transformation-plan-container-{{ ai_gen_id }}">
    <div class="ai-transformation-plan-header-{{ ai_gen_id }}">
      <div class="ai-transformation-plan-label-{{ ai_gen_id }}">{{ block.settings.top_label }}</div>
      <h2 class="ai-transformation-plan-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      <p class="ai-transformation-plan-subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline }}</p>
    </div>

    <div class="ai-transformation-plan-cards-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign plan_enabled_key = 'plan_' | append: i | append: '_enabled'
          assign plan_label_key = 'plan_' | append: i | append: '_label'
          assign plan_badge_key = 'plan_' | append: i | append: '_badge'
          assign plan_duration_key = 'plan_' | append: i | append: '_duration'
          assign plan_price_key = 'plan_' | append: i | append: '_price'
          assign plan_original_price_key = 'plan_' | append: i | append: '_original_price'
          assign plan_savings_key = 'plan_' | append: i | append: '_savings'
          assign plan_monthly_key = 'plan_' | append: i | append: '_monthly'
          assign plan_description_key = 'plan_' | append: i | append: '_description'
          assign plan_footer_key = 'plan_' | append: i | append: '_footer'
          assign plan_link_key = 'plan_' | append: i | append: '_link'

          assign plan_enabled = block.settings[plan_enabled_key]
          assign plan_label = block.settings[plan_label_key]
          assign plan_badge = block.settings[plan_badge_key]
          assign plan_duration = block.settings[plan_duration_key]
          assign plan_price = block.settings[plan_price_key]
          assign plan_original_price = block.settings[plan_original_price_key]
          assign plan_savings = block.settings[plan_savings_key]
          assign plan_monthly = block.settings[plan_monthly_key]
          assign plan_description = block.settings[plan_description_key]
          assign plan_footer = block.settings[plan_footer_key]
          assign plan_link = block.settings[plan_link_key]
        %}

        {% if plan_enabled %}
          <div
            class="ai-transformation-plan-card-{{ ai_gen_id }} selected"
            data-plan-index="{{ i }}"
            data-plan-price="{{ plan_price }}"
            data-plan-link="{{ plan_link }}"
          >
            <div class="ai-transformation-plan-card-inner-{{ ai_gen_id }}">
              <div class="ai-transformation-plan-card-left-{{ ai_gen_id }}">
                <div class="ai-transformation-plan-card-header-{{ ai_gen_id }}">
                  <div class="ai-transformation-plan-card-label-{{ ai_gen_id }}">{{ plan_label }}</div>
                  {% if plan_badge != blank %}
                    <div class="ai-transformation-plan-badge-{{ ai_gen_id }}">{{ plan_badge }}</div>
                  {% endif %}
                </div>
                <div class="ai-transformation-plan-card-duration-{{ ai_gen_id }}">{{ plan_duration }}</div>
                <div class="ai-transformation-plan-card-description-{{ ai_gen_id }}">{{ plan_description }}</div>
                {% if plan_footer != blank %}
                  <div class="ai-transformation-plan-card-footer-{{ ai_gen_id }}">{{ plan_footer }}</div>
                {% endif %}
              </div>

              <div class="ai-transformation-plan-card-right-{{ ai_gen_id }}">
                <div class="ai-transformation-plan-card-pricing-{{ ai_gen_id }}">
                  {% if plan_original_price != blank %}
                    <div class="ai-transformation-plan-card-original-price-{{ ai_gen_id }}">₹{{ plan_original_price }}</div>
                  {% endif %}
                  <div class="ai-transformation-plan-card-price-{{ ai_gen_id }}">₹{{ plan_price }}</div>
                  {% if plan_monthly != blank %}
                    <div class="ai-transformation-plan-card-monthly-{{ ai_gen_id }}">{{ plan_monthly | replace: 'Rs ', '₹' | replace: 'Rs', '₹' }}</div>
                  {% endif %}
                  {% if plan_savings != blank %}
                    <div class="ai-transformation-plan-card-savings-{{ ai_gen_id }}">{{ plan_savings | replace: 'Rs ', '₹' | replace: 'Rs', '₹' }}</div>
                  {% endif %}
                </div>
                <div class="ai-transformation-plan-radio-{{ ai_gen_id }}"></div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_urgency %}
      <div class="ai-transformation-plan-urgency-{{ ai_gen_id }}">
        <div class="ai-transformation-plan-urgency-label-{{ ai_gen_id }}">{{ block.settings.urgency_label }}</div>
        <div class="ai-transformation-plan-countdown-{{ ai_gen_id }}" data-countdown-end="{{ block.settings.countdown_hours }}">00:00:00</div>
        <div class="ai-transformation-plan-urgency-subtext-{{ ai_gen_id }}">{{ block.settings.urgency_subtext }}</div>
      </div>
    {% endif %}

    <div class="ai-transformation-plan-cta-wrapper-{{ ai_gen_id }}">
      <a href="{{ block.settings.plan_1_link | default: 'https://app.lurvox.in/plans/12-months' }}" class="ai-transformation-plan-cta-{{ ai_gen_id }}" data-cta-button>
        {{ block.settings.cta_text }} — Rs <span data-cta-price>500</span>
      </a>
    </div>
  </div>
</transformation-plan-selector-{{ ai_gen_id }}>

<script>
  (function() {
    class TransformationPlanSelector{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.cards = [];
        this.ctaButton = null;
        this.ctaPrice = null;
        this.countdownElement = null;
        this.countdownInterval = null;
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-transformation-plan-card-{{ ai_gen_id }}');
        this.ctaButton = this.querySelector('[data-cta-button]');
        this.ctaPrice = this.querySelector('[data-cta-price]');
        this.countdownElement = this.querySelector('[data-countdown-end]');

        this.setupCardSelection();
        // lurvox-force-all-selected
        this.cards.forEach((c) => c.classList.add('selected'));
        this.updateCTA();
        
        if (this.countdownElement) {
          this.startCountdown();
        }
      }

      disconnectedCallback() {
        if (this.countdownInterval) {
          clearInterval(this.countdownInterval);
        }
      }

      setupCardSelection() {
        this.cards.forEach((card) => {
          card.addEventListener('click', () => {
            this.cards.forEach((c) => c.classList.add('selected'));
            this.updateCTA();
            const link = card.getAttribute('data-plan-link');
            if (link && link !== '#' && link.trim()) {
              window.location.assign(link);
            }
          });
        });
      }

      updateCTA() {
        const selectedCard = this.querySelector('.ai-transformation-plan-card-{{ ai_gen_id }}.selected');
        if (selectedCard && this.ctaPrice && this.ctaButton) {
          const price = selectedCard.getAttribute('data-plan-price');
          const link = selectedCard.getAttribute('data-plan-link');
          this.ctaPrice.textContent = price;
          if (link) {
            this.ctaButton.setAttribute('href', link);
          }
        }
      }

      startCountdown() {
        const hours = parseInt(this.countdownElement.getAttribute('data-countdown-end')) || 8;
        const storageKey = 'lurvox-urgency-countdown-end-v1';
        const durationMs = hours * 60 * 60 * 1000;
        let endTime = 0;

        try {
          const stored = localStorage.getItem(storageKey);
          const parsed = stored ? parseInt(stored, 10) : NaN;
          if (Number.isFinite(parsed)) {
            endTime = parsed;
          }
        } catch (e) {}

        if (!endTime) {
          endTime = Date.now() + durationMs;
          try {
            localStorage.setItem(storageKey, String(endTime));
          } catch (e) {}
        }

        const updateCountdown = () => {
          const now = Date.now();
          let distance = endTime - now;

          if (distance < 0) {
            this.countdownElement.textContent = '00:00:00';
            clearInterval(this.countdownInterval);
            return;
          }

          const hoursLeft = Math.floor(distance / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          this.countdownElement.textContent =
            String(hoursLeft).padStart(2, '0') + ':' +
            String(minutes).padStart(2, '0') + ':' +
            String(seconds).padStart(2, '0');
        };

        updateCountdown();
        this.countdownInterval = setInterval(updateCountdown, 1000);
      }
    }

    customElements.define('transformation-plan-selector-{{ ai_gen_id }}', TransformationPlanSelector{{ ai_gen_id }});
  })();
</script>

