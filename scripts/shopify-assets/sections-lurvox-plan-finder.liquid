{% comment %}
  LURVOX — Find your plan (tap quiz)
  Full intake quiz → recommend a goal-based plan page (not checkout)
  cache-bust 1787768000004
{% endcomment %}

{%- liquid
  assign accent = section.settings.accent_color | default: '#FF6200'
  assign plan_base = section.settings.plan_base | default: 'https://app.lurvox.in/plans'
  assign talk_url = section.settings.talk_url | default: '/pages/talk-to-a-coach'
  assign plans_url = section.settings.plans_url | default: '/pages/compare-fit?view=compare-short'
-%}

<section
  class="lx-pf"
  id="lx-pf-{{ section.id }}"
  style="--lx-accent: {{ accent }};"
  data-plan-base="{{ plan_base }}"
  data-talk-url="{{ talk_url }}"
  data-plans-url="{{ plans_url }}"
>
  <!-- lx-pf-js-v4 -->
  <div class="lx-pf__bg" aria-hidden="true"></div>

  <div class="lx-pf__inner page-width">
    <header class="lx-pf__header" data-pf-header>
      <p class="lx-pf__eyebrow">{{ section.settings.eyebrow | default: 'CHOOSE YOUR GOAL' }}</p>
      <h1 class="lx-pf__title">{{ section.settings.heading | default: 'Pick your goal. We handle the rest.' }}</h1>
      <p class="lx-pf__subtitle">
        {{ section.settings.subheading | default: 'Fat loss, Fat loss + muscle gain, or Athletic body. Answer honestly — we send you to that plan page. No payment here.' }}
      </p>
    </header>

    <div class="lx-pf__card" data-pf-quiz>
      <div class="lx-pf__progress-wrap">
        <div class="lx-pf__progress" aria-hidden="true">
          <div class="lx-pf__progress-bar" data-pf-progress></div>
        </div>
        <p class="lx-pf__step-label" data-pf-step-label>Tap an answer to continue</p>
      </div>
      <h2 class="lx-pf__question" data-pf-question></h2>
      <div class="lx-pf__options" data-pf-options role="group"></div>
      <button type="button" class="lx-pf__back" data-pf-back hidden>Back</button>
    </div>

    <div class="lx-pf__result" data-pf-result hidden>
      <p class="lx-pf__result-eyebrow">Best fit for you</p>
      <h2 class="lx-pf__result-title" data-pf-result-title></h2>
      <p class="lx-pf__result-price" data-pf-result-price></p>
      <p class="lx-pf__result-why" data-pf-result-why></p>
      <ul class="lx-pf__result-bullets" data-pf-result-bullets></ul>
      <div class="lx-pf__compare" data-pf-compare hidden>
        <p class="lx-pf__compare-title" data-pf-compare-title>Why this plan, and what the others miss</p>
        <ul class="lx-pf__compare-list" data-pf-compare-list></ul>
      </div>
      <p class="lx-pf__result-next">
        After you start: coach assigned · Day 1 personal plan · mid-week and weekly check-ins in the app.
      </p>
      <div class="lx-pf__result-actions">
        <a class="lx-pf__btn lx-pf__btn--primary" data-pf-checkout href="{{ plan_base | default: 'https://app.lurvox.in/plans' }}/3-months">
          <span data-pf-checkout-label>See this plan</span>
        </a>
        <a class="lx-pf__btn lx-pf__btn--ghost" data-pf-upgrade href="{{ plan_base | default: 'https://app.lurvox.in/plans' }}/12-months" hidden>
          Prefer Athletic body? 12 months · ₹5,999
        </a>
        <a class="lx-pf__btn lx-pf__btn--ghost" href="/">Back to home</a>
        <a class="lx-pf__link" href="{{ plans_url }}">Compare all plans</a>
      </div>
      <button type="button" class="lx-pf__restart" data-pf-restart>Retake quiz</button>
    </div>
  </div>
</section>

<style>
  body,
  #MainContent,
  .shopify-section:has(.lx-pf) {
    background: #050505 !important;
  }

  #lx-pf-{{ section.id }} {
    --lx-ink: #f7f7f7;
    --lx-muted: rgba(247, 247, 247, 0.64);
    --lx-line: rgba(255, 255, 255, 0.12);
    --lx-surface: #121212;
    --lx-surface-2: #1a1a1a;
    position: relative;
    color: var(--lx-ink);
    padding: clamp(18px, 3.5vw, 56px) 12px clamp(48px, 8vw, 100px);
    overflow: hidden;
    min-height: 72vh;
  }

  #lx-pf-{{ section.id }} .lx-pf__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 55% at 12% -10%, color-mix(in srgb, var(--lx-accent) 28%, transparent), transparent 58%),
      radial-gradient(ellipse 50% 40% at 100% 80%, rgba(255, 255, 255, 0.05), transparent 55%),
      linear-gradient(180deg, #0a0a0a 0%, #050505 100%);
    pointer-events: none;
  }

  #lx-pf-{{ section.id }} .lx-pf__inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
  }

  #lx-pf-{{ section.id }} .lx-pf__header {
    text-align: center;
    margin-bottom: 24px;
  }

  #lx-pf-{{ section.id }} .lx-pf__eyebrow {
    margin: 0 0 10px;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lx-accent);
  }

  #lx-pf-{{ section.id }} .lx-pf__title {
    margin: 0 0 12px;
    font-size: clamp(1.55rem, 5.8vw, 2.45rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  #lx-pf-{{ section.id }} .lx-pf__subtitle {
    margin: 0 auto;
    max-width: 34em;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--lx-muted);
  }

  #lx-pf-{{ section.id }} .lx-pf__card,
  #lx-pf-{{ section.id }} .lx-pf__result {
    background: linear-gradient(180deg, #161616 0%, var(--lx-surface) 100%);
    border: 1px solid var(--lx-line);
    border-radius: 22px;
    padding: clamp(18px, 3.8vw, 32px);
    box-shadow:
      0 24px 50px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  #lx-pf-{{ section.id }} .lx-pf__progress-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 18px;
  }

  #lx-pf-{{ section.id }} .lx-pf__progress {
    height: 5px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 99px;
    overflow: hidden;
  }

  #lx-pf-{{ section.id }} .lx-pf__progress-bar {
    height: 100%;
    width: 8%;
    background: linear-gradient(90deg, var(--lx-accent), #ff8a3d);
    border-radius: 99px;
    transition: width 0.28s ease;
  }

  #lx-pf-{{ section.id }} .lx-pf__step-label {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--lx-muted);
  }

  #lx-pf-{{ section.id }} .lx-pf__question {
    margin: 0 0 18px;
    font-size: clamp(1.2rem, 4.2vw, 1.5rem);
    font-weight: 780;
    letter-spacing: -0.025em;
    line-height: 1.28;
  }

  #lx-pf-{{ section.id }} .lx-pf__options {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #lx-pf-{{ section.id }} .lx-pf__option {
    appearance: none;
    width: 100%;
    text-align: left;
    border: 1px solid var(--lx-line);
    background: var(--lx-surface-2);
    color: var(--lx-ink);
    border-radius: 16px;
    padding: 15px 16px;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.35;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.12s ease, box-shadow 0.15s ease;
  }

  #lx-pf-{{ section.id }} .lx-pf__option:hover,
  #lx-pf-{{ section.id }} .lx-pf__option:focus-visible {
    border-color: color-mix(in srgb, var(--lx-accent) 72%, white);
    outline: none;
    transform: translateY(-1px);
  }

  #lx-pf-{{ section.id }} .lx-pf__option:active {
    transform: translateY(0);
  }

  #lx-pf-{{ section.id }} .lx-pf__option.is-selected {
    border-color: var(--lx-accent);
    background: color-mix(in srgb, var(--lx-accent) 18%, #1a1a1a);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--lx-accent) 35%, transparent);
  }

  #lx-pf-{{ section.id }} .lx-pf__back,
  #lx-pf-{{ section.id }} .lx-pf__restart {
    margin-top: 18px;
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--lx-muted);
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 0;
  }

  #lx-pf-{{ section.id }} .lx-pf__result {
    text-align: center;
  }

  #lx-pf-{{ section.id }} .lx-pf__result-eyebrow {
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lx-accent);
  }

  #lx-pf-{{ section.id }} .lx-pf__result-title {
    margin: 0 0 6px;
    font-size: clamp(1.65rem, 5.2vw, 2.15rem);
    font-weight: 850;
    letter-spacing: -0.03em;
  }

  #lx-pf-{{ section.id }} .lx-pf__result-price {
    margin: 0 0 16px;
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--lx-accent);
  }

  #lx-pf-{{ section.id }} .lx-pf__result-why {
    margin: 0 0 14px;
    font-size: 1.02rem;
    line-height: 1.55;
    color: rgba(247, 247, 247, 0.86);
  }

  #lx-pf-{{ section.id }} .lx-pf__result-bullets {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
  }

  #lx-pf-{{ section.id }} .lx-pf__result-bullets li {
    position: relative;
    padding: 10px 12px 10px 34px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.92rem;
    line-height: 1.4;
    color: rgba(247, 247, 247, 0.88);
  }

  #lx-pf-{{ section.id }} .lx-pf__result-bullets li::before {
    content: '';
    position: absolute;
    left: 12px;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transform: translateY(-50%);
    background: var(--lx-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--lx-accent) 25%, transparent);
  }

  #lx-pf-{{ section.id }} .lx-pf__compare {
    margin: 0 0 20px;
    padding: 16px 16px 14px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.09);
    text-align: left;
  }

  #lx-pf-{{ section.id }} .lx-pf__compare-title {
    margin: 0 0 12px;
    font-size: 0.74rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lx-muted);
  }

  #lx-pf-{{ section.id }} .lx-pf__compare-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #lx-pf-{{ section.id }} .lx-pf__compare-list li {
    position: relative;
    padding-left: 26px;
    font-size: 0.92rem;
    line-height: 1.45;
    color: rgba(247, 247, 247, 0.82);
  }

  #lx-pf-{{ section.id }} .lx-pf__compare-list li::before {
    position: absolute;
    left: 0;
    top: 0.05em;
    font-weight: 800;
    font-size: 0.95rem;
  }

  #lx-pf-{{ section.id }} .lx-pf__compare-list li.is-pick {
    color: var(--lx-ink);
    font-weight: 650;
  }

  #lx-pf-{{ section.id }} .lx-pf__compare-list li.is-pick::before {
    content: '✓';
    color: #46d17f;
  }

  #lx-pf-{{ section.id }} .lx-pf__compare-list li.is-miss::before {
    content: '✕';
    color: rgba(255, 255, 255, 0.4);
  }

  #lx-pf-{{ section.id }} .lx-pf__result-next {
    margin: 0 0 22px;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--lx-muted);
  }

  #lx-pf-{{ section.id }} .lx-pf__result-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: stretch;
  }

  #lx-pf-{{ section.id }} .lx-pf__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 750;
    text-decoration: none;
    padding: 12px 18px;
  }

  #lx-pf-{{ section.id }} .lx-pf__btn--primary {
    background: linear-gradient(180deg, #ff8a3d 0%, var(--lx-accent) 100%);
    color: #111;
    box-shadow: 0 10px 24px color-mix(in srgb, var(--lx-accent) 35%, transparent);
  }

  #lx-pf-{{ section.id }} .lx-pf__btn--ghost {
    background: transparent;
    color: var(--lx-ink);
    border: 1px solid var(--lx-line);
  }

  #lx-pf-{{ section.id }} .lx-pf__link {
    margin-top: 4px;
    color: var(--lx-muted);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #lx-pf-{{ section.id }} .lx-pf__restart {
    margin-top: 18px;
  }

  #lx-pf-{{ section.id }} [hidden] {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    #lx-pf-{{ section.id }} .lx-pf__progress-bar,
    #lx-pf-{{ section.id }} .lx-pf__option {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('lx-pf-{{ section.id }}');
    if (!root) return;

    var planBase = (root.getAttribute('data-plan-base') || 'https://app.lurvox.in/plans').replace(/\/$/, '');
    var steps = [
      { key: 'goal', q: 'What is the main goal?', options: [
        { id: 'b', label: 'Fat loss and visible muscle', plan: 'mix' },
        { id: 'c', label: 'A complete overhaul: fat, muscle, stamina, and strength', plan: 'athletic' },
        { id: 'a', label: 'Fast fat loss', plan: 'fat' }
      ]},
      { key: 'commit', q: 'How long can you commit?', options: [
        { id: 'c', label: 'A full year', plan: 'athletic' },
        { id: 'a', label: 'About 3 months', plan: 'fat' },
        { id: 'b', label: 'Half a year', plan: 'mix' }
      ]},
      { key: 'training', q: 'Where is your training now?', options: [
        { id: 'b', label: 'Trained on and off', plan: 'mix' },
        { id: 'a', label: 'New to structured training', plan: 'fat' },
        { id: 'c', label: 'I train fairly regularly', plan: 'athletic' }
      ]},
      { key: 'beyond', q: 'Beyond fat loss, what else?', options: [
        { id: 'c', label: 'Muscle, stamina, and performance', plan: 'athletic' },
        { id: 'b', label: 'Noticeable muscle and strength', plan: 'mix' },
        { id: 'a', label: 'Nothing else. Fat loss is the job.', plan: 'fat' }
      ]},
      { key: 'stamina', q: 'How much does stamina matter?', options: [
        { id: 'b', label: 'Somewhat', plan: 'mix' },
        { id: 'c', label: 'Very. I want to feel athletic.', plan: 'athletic' },
        { id: 'a', label: 'Not a priority', plan: 'fat' }
      ]},
      { key: 'budget', q: 'What is realistic for your schedule and budget?', options: [
        { id: 'c', label: 'I am ready for the full year', plan: 'athletic' },
        { id: 'b', label: 'A mid-range plan', plan: 'mix' },
        { id: 'a', label: 'Start small', plan: 'fat' }
      ]},
      { key: 'success', q: 'A year from now, success looks like…', options: [
        { id: 'c', label: 'I feel like a different, athletic person', plan: 'athletic' },
        { id: 'a', label: 'The fat is gone', plan: 'fat' },
        { id: 'b', label: 'The fat is gone and muscle is on', plan: 'mix' }
      ]},
      { key: 'where', q: 'Where will you train?', options: [
        { id: 'b', label: 'A gym', where: 'gym' },
        { id: 'c', label: 'Home and a gym', where: 'both' },
        { id: 'a', label: 'Home', where: 'home' }
      ]}
    ];

    var plans = {
      '3_months': {
        slug: '3_months',
        path: '3-months',
        label: 'Fat loss',
        price: '₹1,999',
        per: '90 days',
        bullets: [
          'Best for a focused 90-day fat-loss plan',
          '2 weekly check-ins',
          'Plan updates every 14 days'
        ]
      },
      '6_months': {
        slug: '6_months',
        path: '6-months',
        label: 'Fat loss + muscle gain',
        price: '₹3,499',
        per: '6 months',
        bullets: [
          'Best for: losing fat while building muscle',
          '2 weekly check-ins',
          'Weekly plan updates'
        ]
      },
      '12_months': {
        slug: '12_months',
        path: '12-months',
        label: 'Athletic body',
        price: '₹5,999',
        per: '12 months',
        bullets: [
          'Best for: fat loss, muscle gain, and stamina',
          'Weekly plan updates',
          'One-time payment'
        ]
      }
    };

    // For each recommended plan: why it wins (is-pick) and what the other plans miss (is-miss).
    var contrast = {
      '3_months': [
        { kind: 'pick', text: 'Best for a focused 90-day fat-loss plan.' },
        { kind: 'miss', text: '6 months is Fat loss + muscle gain.' },
        { kind: 'miss', text: 'Athletic body is 12 months — fat loss, muscle gain, and stamina. No live calls.' }
      ],
      '6_months': [
        { kind: 'pick', text: 'Best for: losing fat while building muscle.' },
        { kind: 'miss', text: '3 months is Fat loss — a focused 90-day plan.' },
        { kind: 'miss', text: 'Athletic body is 12 months — fat loss, muscle gain, and stamina. No live calls.' }
      ],
      '12_months': [
        { kind: 'pick', text: 'Athletic body is 12 months — fat loss, muscle gain, and stamina. No live calls.' },
        { kind: 'miss', text: '3 months is Fat loss — a focused 90-day plan.' },
        { kind: 'miss', text: '6 months is Fat loss + muscle gain.' }
      ]
    };

    var answers = {};
    var stepIndex = 0;

    var quizEl = root.querySelector('[data-pf-quiz]');
    var resultEl = root.querySelector('[data-pf-result]');
    var headerEl = root.querySelector('[data-pf-header]');
    var progressEl = root.querySelector('[data-pf-progress]');
    var stepLabelEl = root.querySelector('[data-pf-step-label]');
    var questionEl = root.querySelector('[data-pf-question]');
    var optionsEl = root.querySelector('[data-pf-options]');
    var backEl = root.querySelector('[data-pf-back]');
    var titleEl = root.querySelector('[data-pf-result-title]');
    var priceEl = root.querySelector('[data-pf-result-price]');
    var whyEl = root.querySelector('[data-pf-result-why]');
    var bulletsEl = root.querySelector('[data-pf-result-bullets]');
    var compareEl = root.querySelector('[data-pf-compare]');
    var compareListEl = root.querySelector('[data-pf-compare-list]');
    var checkoutEl = root.querySelector('[data-pf-checkout]');
    var checkoutLabelEl = root.querySelector('[data-pf-checkout-label]');
    var upgradeEl = root.querySelector('[data-pf-upgrade]');
    var restartEl = root.querySelector('[data-pf-restart]');

    function recommend() {
      var scores = { fat: 0, mix: 0, athletic: 0 };
      var order = ['fat', 'mix', 'athletic'];
      var slugs = { fat: '3_months', mix: '6_months', athletic: '12_months' };
      var picks = [];
      var where = 'both';
      steps.forEach(function (step) {
        var picked = answers[step.key];
        if (!picked) return;
        if (picked.plan) picks.push(picked.plan);
        if (picked.where) where = picked.where;
      });
      picks.forEach(function (pick) { scores[pick] += 1; });
      var max = Math.max(scores.fat, scores.mix, scores.athletic);
      var leaders = order.filter(function (key) { return scores[key] === max; });
      var commitment = picks[1];
      var winner = leaders[0] || 'mix';
      if (leaders.length > 1 && commitment) {
        if (leaders.indexOf(commitment) >= 0) winner = commitment;
      }
      var planKey = slugs[winner];
      var why =
        planKey === '3_months'
          ? 'This is the 90-day Fat loss plan, with training at ' + where + '.'
          : planKey === '6_months'
            ? 'This is Fat loss + muscle gain, with training at ' + where + '.'
            : 'Athletic body is 12 months — fat loss, muscle, and stamina, with training at ' + where + '.';
      return { planKey: planKey, why: why, goalLabel: winner };
    }

    function planUrl(plan) {
      return planBase + '/' + plan.path;
    }

    function showResult() {
      var rec = recommend();
      var plan = plans[rec.planKey];
      var url = planUrl(plan);
      quizEl.hidden = true;
      if (headerEl) headerEl.hidden = true;
      resultEl.hidden = false;
      titleEl.textContent = plan.label;
      priceEl.textContent = plan.price + ' · ' + plan.per;
      whyEl.textContent = rec.why;
      bulletsEl.innerHTML = '';
      (plan.bullets || []).forEach(function (line) {
        var li = document.createElement('li');
        li.textContent = line;
        bulletsEl.appendChild(li);
      });
      if (compareEl && compareListEl) {
        var rows = contrast[rec.planKey] || [];
        compareListEl.innerHTML = '';
        rows.forEach(function (row) {
          var li = document.createElement('li');
          li.className = row.kind === 'pick' ? 'is-pick' : 'is-miss';
          li.textContent = row.text;
          compareListEl.appendChild(li);
        });
        compareEl.hidden = rows.length === 0;
      }
      checkoutEl.href = url;
      checkoutLabelEl.textContent =
        rec.planKey === '12_months' ? 'See Athletic body' : 'See this plan';
      if (upgradeEl) {
        upgradeEl.hidden = rec.planKey === '12_months';
        upgradeEl.href = planBase + '/12-months';
      }
      try {
        resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (e) {
        try {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (e2) {}
      }
    }

    function renderStep() {
      var step = steps[stepIndex];
      var total = steps.length;
      stepLabelEl.textContent = stepIndex === 0 ? 'Tap an answer to continue' : 'Keep going';
      progressEl.style.width = ((stepIndex + 1) / total) * 100 + '%';
      questionEl.textContent = step.q;
      optionsEl.innerHTML = '';
      backEl.hidden = stepIndex === 0;

      step.options.forEach(function (opt) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'lx-pf__option';
        btn.textContent = opt.label;
        if (answers[step.key] && answers[step.key].id === opt.id) {
          btn.classList.add('is-selected');
        }
        btn.addEventListener('click', function () {
          answers[step.key] = opt;
          Array.prototype.forEach.call(optionsEl.children, function (el) {
            el.classList.remove('is-selected');
          });
          btn.classList.add('is-selected');
          window.setTimeout(function () {
            if (stepIndex >= steps.length - 1) {
              showResult();
            } else {
              stepIndex += 1;
              renderStep();
            }
          }, 160);
        });
        optionsEl.appendChild(btn);
      });
    }

    backEl.addEventListener('click', function () {
      if (stepIndex <= 0) return;
      stepIndex -= 1;
      renderStep();
    });

    restartEl.addEventListener('click', function () {
      answers = {};
      stepIndex = 0;
      resultEl.hidden = true;
      if (headerEl) headerEl.hidden = false;
      quizEl.hidden = false;
      renderStep();
    });

    renderStep();
  })();
</script>

