{% doc %}
Renders a short LURVOX plan comparison table.
{% enddoc %}

<section class="lx-matrix" id="compare-inline" aria-labelledby="lx-matrix-title">
  <div class="lx-matrix__heading">
    <p>Compare plans</p>
    <h2 id="lx-matrix-title">3, 6, or 12 months. Pick a plan.</h2>
    <p class="lx-matrix__sub">Every plan includes workout, diet, a human coach, check-ins, trackers, chat, and plan updates.</p>
  </div>

  <aside class="lx-matrix__callout">Weekly coach phone call is 12-month only. 3 and 6 month plans still include coach chat and check-ins.</aside>

  <div class="lx-matrix__frame">
    <table class="lx-matrix__table">
      <thead>
        <tr>
          <th scope="col">Compare</th>
          <th scope="col">
            <span>Fat loss</span>
            <small>3 months</small>
            <strong>₹1,999</strong>
          </th>
          <th scope="col">
            <span>Fat loss + muscle gain</span>
            <small>6 months</small>
            <strong>₹3,499</strong>
          </th>
          <th scope="col" class="is-featured is-best">
            <small>Recommended</small>
            <span>Athletic body</span>
            <small>12 months</small>
            <strong>₹5,999</strong>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Best for</th>
          <td>90-day fat loss</td>
          <td>Fat loss + muscle</td>
          <td class="is-featured is-best">Athletic body</td>
        </tr>
        <tr>
          <th scope="row">Workout, diet, coach, check-ins, trackers, chat</th>
          <td><span class="lx-matrix__yes" aria-label="Included">✓</span></td>
          <td><span class="lx-matrix__yes" aria-label="Included">✓</span></td>
          <td class="is-featured"><span class="lx-matrix__yes" aria-label="Included">✓</span></td>
        </tr>
        <tr>
          <th scope="row">Plan updates</th>
          <td>Every 14 days</td>
          <td>Every week</td>
          <td class="is-featured">Every week</td>
        </tr>
        <tr>
          <th scope="row">Weekly coach phone call</th>
          <td>Chat + check-ins</td>
          <td>Chat + check-ins</td>
          <td class="is-featured is-best">Weekly call</td>
        </tr>
      </tbody>
      <tfoot>
        <tr>
          <th scope="row"><span class="visually-hidden">Choose a plan</span></th>
          <td><a href="https://app.lurvox.in/plans/3-months">Start</a></td>
          <td><a href="https://app.lurvox.in/plans/6-months">Start</a></td>
          <td class="is-featured is-best"><a class="is-best" href="https://app.lurvox.in/plans/12-months">Start</a></td>
        </tr>
      </tfoot>
    </table>
  </div>
</section>

{% stylesheet %}
  .lx-matrix {
    width: min(100%, 980px);
    margin: 0 auto;
    padding: 28px 0 42px;
    color: #f7f4ee;
  }

  .lx-matrix__heading {
    margin-bottom: 14px;
  }

  .lx-matrix__heading p:first-child {
    margin: 0 0 7px;
    color: #ff6200;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lx-matrix__heading h2 {
    max-width: 18em;
    margin: 0 0 8px;
    color: #fff;
    font-size: clamp(1.45rem, 3.6vw, 2.05rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .lx-matrix__sub {
    margin: 0;
    max-width: 38em;
    color: rgba(255,255,255,0.68);
    font-size: 0.92rem;
    line-height: 1.45;
    letter-spacing: 0;
    text-transform: none;
    font-weight: 500;
  }

  .lx-matrix__callout {
    margin: 0 0 16px;
    padding: 12px 14px;
    border: 1px solid rgba(255, 98, 0, 0.42);
    border-radius: 12px;
    background: rgba(255, 98, 0, 0.08);
    color: #ffd7bf;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .lx-matrix__frame {
    overflow: hidden;
    border: 1px solid rgba(255, 98, 0, 0.36);
    border-radius: 18px;
    background: rgba(10, 10, 12, 0.96);
  }

  .lx-matrix__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .lx-matrix__table th,
  .lx-matrix__table td {
    border-bottom: 1px solid rgba(255, 255, 255, 0.075);
  }

  .lx-matrix__table thead th {
    padding: 16px 8px 14px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-align: center;
    vertical-align: bottom;
  }

  .lx-matrix__table thead th:first-child,
  .lx-matrix__table tbody th {
    width: 38%;
    text-align: left;
  }

  .lx-matrix__table thead th span,
  .lx-matrix__table thead th strong {
    display: block;
  }

  .lx-matrix__table thead th strong {
    margin-top: 5px;
    color: #ff6200;
    font-size: 0.95rem;
    letter-spacing: 0;
  }

  .lx-matrix__table thead small {
    display: inline-flex;
    margin: 6px 0 0;
    padding: 3px 6px;
    border-radius: 999px;
    background: rgba(255, 98, 0, 0.16);
    color: #ffb17a;
    font-size: 0.55rem;
    letter-spacing: 0.04em;
  }

  .lx-matrix__table tbody th {
    padding: 13px 14px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.28;
  }

  .lx-matrix__table tbody td {
    padding: 11px 4px;
    text-align: center;
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .lx-matrix__table .is-featured,
  .lx-matrix__table .is-best {
    background: rgba(255, 98, 0, 0.07);
  }

  .lx-matrix__yes,
  .lx-matrix__no {
    display: inline-grid;
    width: 22px;
    height: 22px;
    place-items: center;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 900;
    line-height: 1;
  }

  .lx-matrix__yes {
    background: #20b86a;
    color: #fff;
  }

  .lx-matrix__no {
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.7);
  }

  .lx-matrix__table tfoot th,
  .lx-matrix__table tfoot td {
    padding: 15px 4px;
    border-bottom: 0;
    text-align: center;
  }

  .lx-matrix__table tfoot a {
    display: inline-flex;
    min-height: 32px;
    padding: 0 11px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    color: #fff;
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .lx-matrix__table tfoot a.is-best {
    border-color: #ff6200;
    background: #ff6200;
    color: #1a0900;
  }

  @media (max-width: 640px) {
    .lx-matrix {
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: 20px 12px 28px;
      box-sizing: border-box;
    }

    .lx-matrix__heading h2 {
      max-width: none;
      font-size: 1.35rem;
    }

    .lx-matrix__table thead th:first-child,
    .lx-matrix__table tbody th,
    .lx-matrix__table tfoot th {
      width: 34%;
    }

    .lx-matrix__table thead th {
      padding: 12px 3px 10px;
      font-size: 0.58rem;
      word-break: break-word;
    }

    .lx-matrix__table tbody th {
      padding: 10px 8px 10px 10px;
      font-size: 0.7rem;
      overflow-wrap: anywhere;
    }

    .lx-matrix__yes,
    .lx-matrix__no {
      width: 18px;
      height: 18px;
      font-size: 0.58rem;
    }

    .lx-matrix__table tfoot a {
      width: calc(100% - 4px);
      font-size: 0.55rem;
    }
  }
{% endstylesheet %}
