{% comment %}
  Instant-style coaching plan cards — yellow prices, green CTAs, glow.
{% endcomment %}
<section class="lx-plans" id="plans" aria-labelledby="lx-plans-title">
  <div class="lx-plans__inner">
    <p class="lx-plans__eyebrow">Choose your plan</p>
    <h2 class="lx-plans__title" id="lx-plans-title">Simple plans. Real coaching.</h2>
    <p class="lx-plans__lede">The price is for a <strong>new weekly plan</strong> plus trackers, coach chat, and Journey already unlocked — not a one-time PDF.</p>
    <div class="lx-plans__stack">
      <article class="lx-plans__card lx-plans__card--fat">
        <span class="lx-plans__dur">90 days</span>
        <h3>Fat loss</h3>
        <p class="lx-plans__price">₹599</p>
        <p class="lx-plans__meta">3 months · ≈ ₹200/mo</p>
        <ul class="lx-plans__bullets">
          <li>New workout + diet each week</li>
          <li>Trackers unlocked</li>
          <li>Coach chat unlocked</li>
          <li>Journey unlocked</li>
          <li>Weekly check-ins</li>
          <li>Progress photos</li>
        </ul>
        <a class="lx-plans__cta" href="https://app.lurvox.in/checkout?plan=3_months">Get Fat loss</a>
      </article>

      <article class="lx-plans__card lx-plans__card--popular">
        <p class="lx-plans__tag">Most popular</p>
        <span class="lx-plans__dur">6 months</span>
        <h3>Fat loss + muscle</h3>
        <p class="lx-plans__price">₹999</p>
        <p class="lx-plans__meta">≈ ₹167/mo</p>
        <p class="lx-plans__note">Everything in Fat loss, plus muscle programmed in for 6 months.</p>
        <ul class="lx-plans__bullets">
          <li>New workout + diet each week</li>
          <li>Trackers, coach chat, Journey unlocked</li>
          <li>Weekly check-ins</li>
          <li>Progress photos</li>
          <li>Fat loss and muscle in one plan</li>
          <li>Longer runway to keep results</li>
        </ul>
        <div class="lx-plans__extras">
          <p class="lx-plans__extras-title"><span>INCLUDED</span> At no extra cost</p>
          <ul>
            <li><em>PLUS</em> Muscle programming</li>
            <li><em>PLUS</em> Weekly plan updates</li>
          </ul>
        </div>
        <a class="lx-plans__cta" href="https://app.lurvox.in/checkout?plan=6_months">Get this plan</a>
      </article>

      <article class="lx-plans__card lx-plans__card--athletic">
        <p class="lx-plans__tag lx-plans__tag--best">Best value</p>
        <span class="lx-plans__dur">12 months</span>
        <h3>Athletic body</h3>
        <p class="lx-plans__price">₹1,699</p>
        <p class="lx-plans__meta">≈ ₹142/mo · lowest monthly cost</p>
        <p class="lx-plans__note lx-plans__note--gold">Full year of coaching. Fat loss, muscle, and stamina in one plan.</p>
        <ul class="lx-plans__bullets">
          <li>New workout + diet each week</li>
          <li>Trackers, coach chat, Journey unlocked</li>
          <li>Weekly check-ins all year</li>
          <li>Progress photos + plan tweaks</li>
          <li>Fat loss, muscle, and stamina</li>
          <li>Longest runway to keep results</li>
        </ul>
        <div class="lx-plans__extras lx-plans__extras--gold">
          <p class="lx-plans__extras-title"><span>PLUS</span> 12-month athletic runway</p>
          <ul>
            <li><em>PLUS</em> Stamina programming</li>
            <li><em>PLUS</em> Lowest ₹/month</li>
          </ul>
        </div>
        <a class="lx-plans__cta" href="https://app.lurvox.in/checkout?plan=12_months">Get Athletic body</a>
      </article>
    </div>
  </div>
</section>
<style>
  .lx-plans {
    --yellow: #fbbf24;
    --orange: #ff6200;
    --green: #22c55e;
    --green-deep: #16a34a;
    --blue: #3b82f6;
    background: transparent;
    color: #f8fafc;
    padding: 40px 16px 36px;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  .lx-plans__inner { max-width: 1080px; margin: 0 auto; }
  .lx-plans__eyebrow {
    margin: 0;
    color: var(--yellow);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
  }
  .lx-plans__title {
    margin: 8px 0 0;
    text-align: center;
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: #fff;
  }
  .lx-plans__lede {
    margin: 10px auto 0;
    max-width: 36rem;
    text-align: center;
    color: #cbd5e1;
    font-size: 15px;
    line-height: 1.5;
  }
  .lx-plans__lede strong { color: #fff; }
  .lx-plans__stack {
    margin-top: 28px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    align-items: stretch;
  }
  .lx-plans__card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #1c1917;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 22px;
    padding: 22px 20px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
    overflow: hidden;
  }
  .lx-plans__card--fat {
    border-color: rgba(255, 98, 0, 0.45);
    background:
      radial-gradient(ellipse 80% 60% at 0% -10%, rgba(255, 98, 0, 0.28), transparent 55%),
      #1c1917;
  }
  .lx-plans__card--popular {
    border: 2px solid var(--yellow);
    transform: none;
    box-shadow:
      0 0 0 1px rgba(251, 191, 36, 0.2),
      0 18px 44px rgba(251, 191, 36, 0.18);
    background:
      radial-gradient(ellipse 90% 70% at 100% -20%, rgba(251, 191, 36, 0.28), transparent 50%),
      radial-gradient(ellipse 70% 50% at 0% 110%, rgba(34, 197, 94, 0.18), transparent 50%),
      #241f1c;
  }
  .lx-plans__card--athletic {
    border: 2px solid #f59e0b;
    background:
      radial-gradient(ellipse 90% 70% at 100% -20%, rgba(251, 191, 36, 0.32), transparent 50%),
      radial-gradient(ellipse 70% 50% at 0% 110%, rgba(59, 130, 246, 0.22), transparent 50%),
      #241f1c;
    box-shadow:
      0 0 0 1px rgba(251, 191, 36, 0.22),
      0 18px 44px rgba(245, 158, 11, 0.22);
  }
  .lx-plans__tag {
    display: inline-flex;
    align-self: flex-start;
    margin: 0 0 10px;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--yellow);
    color: #1c1400;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .lx-plans__tag--best {
    background: linear-gradient(90deg, #fbbf24, #fb7185);
    color: #1c0a00;
  }
  .lx-plans__dur {
    display: inline-flex;
    align-self: flex-start;
    margin: 0 0 10px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .lx-plans__card--fat .lx-plans__dur {
    color: #ffd4a8;
    background: rgba(255, 98, 0, 0.18);
    border: 1px solid rgba(255, 98, 0, 0.45);
  }
  .lx-plans__card--popular .lx-plans__dur {
    color: #fde68a;
    background: rgba(251, 191, 36, 0.16);
    border: 1px solid rgba(251, 191, 36, 0.4);
  }
  .lx-plans__card--athletic .lx-plans__dur {
    color: #fde68a;
    background: rgba(245, 158, 11, 0.18);
    border: 1px solid rgba(251, 191, 36, 0.45);
  }
  .lx-plans__card h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .lx-plans__price {
    margin: 12px 0 0;
    color: var(--yellow);
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .lx-plans__meta {
    margin: 4px 0 0;
    color: #cbd5e1;
    font-size: 14px;
    font-weight: 600;
  }
  .lx-plans__note {
    margin: 12px 0 0;
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(34, 197, 94, 0.16);
    color: #bbf7d0;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.45;
  }
  .lx-plans__note--gold {
    background: rgba(251, 191, 36, 0.16);
    color: #fde68a;
  }
  .lx-plans__bullets {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 9px;
    flex: 1;
  }
  .lx-plans__bullets li {
    position: relative;
    padding-left: 22px;
    color: #e2e8f0;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
  }
  .lx-plans__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.15em;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path fill='%2322c55e' d='M6.2 11.2 3.4 8.4l1.1-1.1 1.7 1.7 4.4-4.4 1.1 1.1z'/></svg>")
      center / 16px 16px no-repeat;
  }
  .lx-plans__extras {
    margin-top: 14px;
    padding: 12px;
    border-radius: 14px;
    border: 1px solid rgba(34, 197, 94, 0.4);
    background:
      radial-gradient(ellipse 80% 70% at 0% 0%, rgba(34, 197, 94, 0.22), transparent 60%),
      rgba(0, 0, 0, 0.22);
  }
  .lx-plans__extras--blue {
    border-color: rgba(59, 130, 246, 0.45);
    background:
      radial-gradient(ellipse 80% 70% at 0% 0%, rgba(59, 130, 246, 0.22), transparent 60%),
      rgba(0, 0, 0, 0.22);
  }
  .lx-plans__extras--gold {
    border-color: rgba(251, 191, 36, 0.5);
    background:
      radial-gradient(ellipse 80% 70% at 0% 0%, rgba(251, 191, 36, 0.22), transparent 60%),
      rgba(0, 0, 0, 0.22);
  }
  .lx-plans__extras-title {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 800;
    color: #bbf7d0;
  }
  .lx-plans__extras--blue .lx-plans__extras-title { color: #bfdbfe; }
  .lx-plans__extras--gold .lx-plans__extras-title { color: #fde68a; }
  .lx-plans__extras-title span {
    display: inline-flex;
    padding: 3px 8px;
    border-radius: 999px;
    background: #22c55e;
    color: #052e16;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }
  .lx-plans__extras--blue .lx-plans__extras-title span {
    background: #3b82f6;
    color: #fff;
  }
  .lx-plans__extras--gold .lx-plans__extras-title span {
    background: #fbbf24;
    color: #1c1400;
  }
  .lx-plans__extras ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .lx-plans__extras li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 650;
    color: #f8fafc;
  }
  .lx-plans__extras em {
    flex-shrink: 0;
    display: inline-flex;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(251, 191, 36, 0.2);
    border: 1px solid rgba(251, 191, 36, 0.45);
    color: #fde68a;
    font-size: 10px;
    font-style: normal;
    font-weight: 900;
    letter-spacing: 0.06em;
  }
  .lx-plans__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 18px;
    min-height: 50px;
    padding: 14px 18px;
    border-radius: 14px;
    background: var(--green-deep);
    color: #fff !important;
    font-weight: 800;
    font-size: 15px;
    text-decoration: none !important;
    border: 1px solid rgba(251, 191, 36, 0.4);
    box-shadow: 0 10px 22px rgba(22, 163, 74, 0.28);
    box-sizing: border-box;
  }
  .lx-plans__card--fat .lx-plans__cta {
    background: linear-gradient(180deg, #ff7a1a 0%, #ff6200 100%);
    color: #1c0a00 !important;
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow: 0 10px 22px rgba(255, 98, 0, 0.32);
  }
  .lx-plans__card--athletic .lx-plans__cta {
    background: linear-gradient(180deg, #fbbf24 0%, #f59e0b 100%);
    color: #1c1400 !important;
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: 0 10px 22px rgba(245, 158, 11, 0.38);
  }
  .lx-plans__cta:hover { filter: brightness(1.06); }
  @media screen and (min-width: 860px) {
    .lx-plans__stack {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
    .lx-plans__card--popular { transform: translateY(-8px); }
    .lx-plans__card--athletic { transform: translateY(-10px); }
  }
</style>
