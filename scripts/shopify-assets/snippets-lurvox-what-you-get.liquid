{% doc %}
  Homepage “What you get on the platform” feature cards.
  @example
  {% render 'lurvox-what-you-get' %}
{% enddoc %}

<section class="lx-wyg" id="what-you-get" aria-labelledby="lx-wyg-title">
  <div class="lx-wyg__inner">
    <header class="lx-wyg__header">
      <p class="lx-wyg__eyebrow">Included</p>
      <h2 class="lx-wyg__title" id="lx-wyg-title">What you get</h2>
    </header>

    <ul class="lx-wyg__grid">
      <li class="lx-wyg__card">
        <span class="lx-wyg__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 9v6M19 9v6M3 11v2M21 11v2M5 12h14M7.5 8.5v7M16.5 8.5v7"/>
          </svg>
        </span>
        <h3>Workout + diet</h3>
      </li>
      <li class="lx-wyg__card">
        <span class="lx-wyg__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="3.25"/>
            <path d="M5.5 19.5c1.1-3.2 3.5-4.8 6.5-4.8s5.4 1.6 6.5 4.8"/>
          </svg>
        </span>
        <h3>Human coach</h3>
      </li>
      <li class="lx-wyg__card">
        <span class="lx-wyg__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3.5" y="5" width="17" height="15" rx="2"/>
            <path d="M8 3.5v3.5M16 3.5v3.5M3.5 10h17"/>
          </svg>
        </span>
        <h3>Weekly check-ins</h3>
      </li>
      <li class="lx-wyg__card">
        <span class="lx-wyg__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19V5M4 19h16"/>
            <path d="M8 15v-3.5M12 15V9M16 15V7"/>
          </svg>
        </span>
        <h3>Daily trackers</h3>
      </li>
      <li class="lx-wyg__card">
        <span class="lx-wyg__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 8.5h3.2l1.3-2h7l1.3 2H20v10.5H4V8.5z"/>
            <circle cx="12" cy="13.5" r="3.1"/>
          </svg>
        </span>
        <h3>Progress photos</h3>
      </li>
      <li class="lx-wyg__card">
        <span class="lx-wyg__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.6 6.4a4.2 4.2 0 1 0-5.2 5.2L5 16l3 3 4.4-4.4a4.2 4.2 0 0 0 5.2-5.2L15.4 11l-2.4-2.4 1.6-2.2z"/>
          </svg>
        </span>
        <h3>Plan tweaks</h3>
      </li>
    </ul>
  </div>
</section>

<style>
  .lx-wyg {
    --lx-wyg-accent: #ff6200;
    --lx-wyg-ink: #f5f5f5;
    position: relative;
    color: var(--lx-wyg-ink);
    background: #070707;
    padding: 28px 16px 24px;
  }

  .lx-wyg__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .lx-wyg__header {
    text-align: center;
    margin: 0 auto 18px;
  }

  .lx-wyg__eyebrow {
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lx-wyg-accent);
  }

  .lx-wyg__title {
    margin: 0;
    font-size: clamp(1.4rem, 5.5vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .lx-wyg__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .lx-wyg__card {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 12px;
    align-items: center;
    min-height: 56px;
    padding: 10px 12px;
    border: 1px solid rgba(255, 98, 0, 0.28);
    border-radius: 14px;
    background: #0c0c0c;
  }

  .lx-wyg__icon {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    color: var(--lx-wyg-accent);
    background: rgba(255, 98, 0, 0.14);
  }

  .lx-wyg__icon svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .lx-wyg__card h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--lx-wyg-ink);
  }

  @media screen and (min-width: 750px) {
    .lx-wyg {
      padding: 40px 24px 36px;
    }

    .lx-wyg__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
  }
</style>
