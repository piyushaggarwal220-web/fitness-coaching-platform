{% comment %} LURVOX plan comparison table — place after plans, before client results {% endcomment %}
<section class="lx-plan-compare" id="compare-plans">
  <div class="lx-plan-compare__glow" aria-hidden="true"></div>
  <div class="lx-plan-compare__inner">
    <p class="lx-plan-compare__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="lx-plan-compare__headline">{{ section.settings.headline }}</h2>
    {% if section.settings.subheadline != blank %}
      <p class="lx-plan-compare__sub">{{ section.settings.subheadline }}</p>
    {% endif %}

    <div class="lx-plan-compare__scroll">
      <table class="lx-plan-compare__table">
        <thead>
          <tr>
            <th scope="col" class="lx-plan-compare__feature-head">Product details</th>
            <th scope="col" class="lx-plan-compare__plan-head">
              <span class="lx-plan-compare__plan-label">{{ section.settings.col_1_label }}</span>
              <span class="lx-plan-compare__plan-price">{{ section.settings.col_1_price }}</span>
            </th>
            <th scope="col" class="lx-plan-compare__plan-head is-featured">
              <span class="lx-plan-compare__popular">Popular</span>
              <span class="lx-plan-compare__plan-label">{{ section.settings.col_2_label }}</span>
              <span class="lx-plan-compare__plan-price">{{ section.settings.col_2_price }}</span>
            </th>
            <th scope="col" class="lx-plan-compare__plan-head">
              <span class="lx-plan-compare__plan-label">{{ section.settings.col_3_label }}</span>
              <span class="lx-plan-compare__plan-price">{{ section.settings.col_3_price }}</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'heading' %}
              <tr class="lx-plan-compare__group" {{ block.shopify_attributes }}>
                <th scope="colgroup" colspan="4">{{ block.settings.heading }}</th>
              </tr>
            {% else %}
              <tr {{ block.shopify_attributes }}>
                <th scope="row" class="lx-plan-compare__feature">{{ block.settings.feature }}</th>
                <td class="lx-plan-compare__cell" data-plan="{{ section.settings.col_1_label }}">
                  {% if block.settings.plan_3_text != blank %}
                    <span class="lx-plan-compare__note">{{ block.settings.plan_3_text }}</span>
                  {% elsif block.settings.plan_3 %}
                    <span class="lx-plan-compare__mark is-yes" aria-label="Included">✓</span>
                  {% else %}
                    <span class="lx-plan-compare__mark is-no" aria-label="Not included">×</span>
                  {% endif %}
                </td>
                <td class="lx-plan-compare__cell is-featured" data-plan="{{ section.settings.col_2_label }}">
                  {% if block.settings.plan_6_text != blank %}
                    <span class="lx-plan-compare__note">{{ block.settings.plan_6_text }}</span>
                  {% elsif block.settings.plan_6 %}
                    <span class="lx-plan-compare__mark is-yes" aria-label="Included">✓</span>
                  {% else %}
                    <span class="lx-plan-compare__mark is-no" aria-label="Not included">×</span>
                  {% endif %}
                </td>
                <td class="lx-plan-compare__cell" data-plan="{{ section.settings.col_3_label }}">
                  {% if block.settings.plan_12_text != blank %}
                    <span class="lx-plan-compare__note">{{ block.settings.plan_12_text }}</span>
                  {% elsif block.settings.plan_12 %}
                    <span class="lx-plan-compare__mark is-yes" aria-label="Included">✓</span>
                  {% else %}
                    <span class="lx-plan-compare__mark is-no" aria-label="Not included">×</span>
                  {% endif %}
                </td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
        <tfoot>
          <tr>
            <td class="lx-plan-compare__feature"></td>
            <td class="lx-plan-compare__cell">
              <a class="lx-plan-compare__view" href="{{ section.settings.col_1_link }}">See plan</a>
            </td>
            <td class="lx-plan-compare__cell is-featured">
              <a class="lx-plan-compare__view is-featured" href="{{ section.settings.col_2_link }}">See plan</a>
            </td>
            <td class="lx-plan-compare__cell">
              <a class="lx-plan-compare__view" href="{{ section.settings.col_3_link }}">See plan</a>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="lx-plan-compare__mobile" aria-label="Plan comparison">
      <article class="lx-plan-compare__mobile-card">
        <div class="lx-plan-compare__mobile-head">
          <div>
            <span class="lx-plan-compare__mobile-label">{{ section.settings.col_1_label }}</span>
            <strong class="lx-plan-compare__mobile-price">{{ section.settings.col_1_price }}</strong>
          </div>
          <a class="lx-plan-compare__mobile-cta" href="{{ section.settings.col_1_link }}">See plan</a>
        </div>
        <ul class="lx-plan-compare__mobile-list">
          {% for block in section.blocks %}
            {% if block.type == 'heading' %}
              <li class="lx-plan-compare__mobile-group">{{ block.settings.heading }}</li>
            {% else %}
              <li>
                <span>{{ block.settings.feature }}</span>
                {% if block.settings.plan_3_text != blank %}
                  <span class="lx-plan-compare__note">{{ block.settings.plan_3_text }}</span>
                {% elsif block.settings.plan_3 %}
                  <span class="lx-plan-compare__mark is-yes" aria-label="Included">✓</span>
                {% else %}
                  <span class="lx-plan-compare__mark is-no" aria-label="Not included">×</span>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </article>

      <article class="lx-plan-compare__mobile-card is-featured">
        <div class="lx-plan-compare__mobile-head">
          <div>
            <span class="lx-plan-compare__popular">Popular</span>
            <span class="lx-plan-compare__mobile-label">{{ section.settings.col_2_label }}</span>
            <strong class="lx-plan-compare__mobile-price">{{ section.settings.col_2_price }}</strong>
          </div>
          <a class="lx-plan-compare__mobile-cta is-featured" href="{{ section.settings.col_2_link }}">See plan</a>
        </div>
        <ul class="lx-plan-compare__mobile-list">
          {% for block in section.blocks %}
            {% if block.type == 'heading' %}
              <li class="lx-plan-compare__mobile-group">{{ block.settings.heading }}</li>
            {% else %}
              <li>
                <span>{{ block.settings.feature }}</span>
                {% if block.settings.plan_6_text != blank %}
                  <span class="lx-plan-compare__note">{{ block.settings.plan_6_text }}</span>
                {% elsif block.settings.plan_6 %}
                  <span class="lx-plan-compare__mark is-yes" aria-label="Included">✓</span>
                {% else %}
                  <span class="lx-plan-compare__mark is-no" aria-label="Not included">×</span>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </article>

      <article class="lx-plan-compare__mobile-card">
        <div class="lx-plan-compare__mobile-head">
          <div>
            <span class="lx-plan-compare__mobile-label">{{ section.settings.col_3_label }}</span>
            <strong class="lx-plan-compare__mobile-price">{{ section.settings.col_3_price }}</strong>
          </div>
          <a class="lx-plan-compare__mobile-cta" href="{{ section.settings.col_3_link }}">See plan</a>
        </div>
        <ul class="lx-plan-compare__mobile-list">
          {% for block in section.blocks %}
            {% if block.type == 'heading' %}
              <li class="lx-plan-compare__mobile-group">{{ block.settings.heading }}</li>
            {% else %}
              <li>
                <span>{{ block.settings.feature }}</span>
                {% if block.settings.plan_12_text != blank %}
                  <span class="lx-plan-compare__note">{{ block.settings.plan_12_text }}</span>
                {% elsif block.settings.plan_12 %}
                  <span class="lx-plan-compare__mark is-yes" aria-label="Included">✓</span>
                {% else %}
                  <span class="lx-plan-compare__mark is-no" aria-label="Not included">×</span>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </article>
    </div>

    <div class="lx-plan-compare__footer">
      <a class="lx-plan-compare__quiz" href="{{ section.settings.find_url | default: '/pages/find-your-plan' }}">
        <span class="lx-plan-compare__quiz-main">Tap to know which plan is best for you</span>
        <span class="lx-plan-compare__quiz-sub">Quick quiz · no payment</span>
      </a>
      <a class="lx-plan-compare__home" href="{{ section.settings.home_url | default: '/#plans' }}">Back to home plans</a>
    </div>
  </div>
</section>

<style>
  .lx-plan-compare {
    position: relative;
    overflow: hidden;
    padding: 64px 20px 72px;
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 98, 0, 0.11), transparent 38%),
      #050505;
    color: #f5f5f5;
  }
  .lx-plan-compare__glow {
    position: absolute;
    top: -180px;
    left: 50%;
    width: 520px;
    height: 320px;
    border-radius: 50%;
    background: rgba(255, 98, 0, 0.12);
    filter: blur(90px);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .lx-plan-compare__inner {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
  }
  .lx-plan-compare__eyebrow {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff6200;
  }
  .lx-plan-compare__headline {
    margin: 0 0 8px;
    font-size: clamp(1.75rem, 4vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: #fff;
    text-shadow:
      0 0 22px rgba(255, 255, 255, 0.12),
      0 0 36px rgba(255, 98, 0, 0.16);
  }
  .lx-plan-compare__sub {
    margin: 0 0 24px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255,255,255,0.65);
    max-width: 36em;
  }
  .lx-plan-compare__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    background: rgba(12, 12, 14, 0.88);
    box-shadow: 0 24px 70px rgba(0,0,0,0.38);
  }
  .lx-plan-compare__group th {
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.68rem;
    font-weight: 800;
    color: #ff6200;
    background: rgba(255, 98, 0, 0.07);
    padding: 14px 18px 10px;
    border-bottom: 1px solid rgba(255, 98, 0, 0.22);
  }
  .lx-plan-compare__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .lx-plan-compare__feature-head,
  .lx-plan-compare__feature {
    text-align: left;
    font-weight: 600;
    font-size: 0.78rem;
    color: #f5f5f5;
    width: 46%;
    padding: 11px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .lx-plan-compare__feature-head {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
    color: rgba(255,255,255,0.5);
  }
  .lx-plan-compare__plan-head {
    position: relative;
    text-align: center;
    padding: 22px 10px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    vertical-align: bottom;
  }
  .lx-plan-compare__plan-head.is-featured,
  .lx-plan-compare__cell.is-featured {
    background: rgba(255, 98, 0, 0.055);
    box-shadow: inset 1px 0 rgba(255, 98, 0, 0.12), inset -1px 0 rgba(255, 98, 0, 0.12);
  }
  .lx-plan-compare__popular {
    display: inline-flex;
    margin-bottom: 7px;
    padding: 3px 7px;
    border-radius: 999px;
    background: #ff6200;
    color: #120700;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lx-plan-compare__plan-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #fff;
  }
  .lx-plan-compare__plan-price {
    display: block;
    margin-top: 4px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #ff6200;
    text-shadow: 0 0 16px rgba(255, 98, 0, 0.38);
  }
  .lx-plan-compare__cell {
    text-align: center;
    padding: 10px 8px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .lx-plan-compare__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
  }
  .lx-plan-compare__mark.is-yes {
    background: #1f8f4e;
    color: #fff;
  }
  .lx-plan-compare__mark.is-no {
    background: #2a2a2a;
    color: #f5f5f5;
  }
  .lx-plan-compare__view {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 0 13px;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .lx-plan-compare__view.is-featured {
    border-color: #ff6200;
    background: #ff6200;
    color: #160800;
  }
  .lx-plan-compare__view:hover { color: #ff6200; }
  tfoot .lx-plan-compare__cell,
  tfoot .lx-plan-compare__feature {
    border-bottom: none;
    padding-top: 18px;
  }
  .lx-plan-compare__mobile {
    display: none;
  }
  @media (max-width: 640px) {
    .lx-plan-compare {
      padding: 48px 12px 56px;
    }
    .lx-plan-compare__headline {
      max-width: 13em;
      font-size: 1.8rem;
    }
    .lx-plan-compare__sub {
      margin-bottom: 20px;
      font-size: 0.88rem;
    }
    .lx-plan-compare__scroll {
      display: none;
    }
    .lx-plan-compare__mobile {
      display: grid;
      gap: 14px;
    }
    .lx-plan-compare__mobile-card {
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 18px;
      background: rgba(13, 13, 15, 0.94);
      box-shadow: 0 18px 44px rgba(0,0,0,0.28);
    }
    .lx-plan-compare__mobile-card.is-featured {
      border-color: rgba(255,98,0,0.48);
      background:
        linear-gradient(145deg, rgba(255,98,0,0.09), transparent 48%),
        rgba(13, 13, 15, 0.96);
      box-shadow: 0 20px 50px rgba(255,98,0,0.1);
    }
    .lx-plan-compare__mobile-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 18px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .lx-plan-compare__mobile-head > div {
      display: grid;
      justify-items: start;
      gap: 4px;
    }
    .lx-plan-compare__mobile-label {
      color: rgba(255,255,255,0.72);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.08em;
    }
    .lx-plan-compare__mobile-price {
      color: #ff6200;
      font-size: 1.5rem;
      line-height: 1;
      text-shadow: 0 0 18px rgba(255,98,0,0.3);
    }
    .lx-plan-compare__mobile-head .lx-plan-compare__popular {
      margin: 0 0 2px;
      font-size: 0.5rem;
    }
    .lx-plan-compare__mobile-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 38px;
      padding: 0 13px;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 999px;
      color: #fff;
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-decoration: none;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .lx-plan-compare__mobile-cta.is-featured {
      border-color: #ff6200;
      background: #ff6200;
      color: #180900;
    }
    .lx-plan-compare__mobile-list {
      margin: 0;
      padding: 4px 16px 10px;
      list-style: none;
    }
    .lx-plan-compare__mobile-list li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 14px;
      min-height: 45px;
      border-bottom: 1px solid rgba(255,255,255,0.065);
      color: rgba(255,255,255,0.86);
      font-size: 0.78rem;
      font-weight: 600;
      line-height: 1.3;
    }
    .lx-plan-compare__mobile-list li:last-child {
      border-bottom: 0;
    }
    .lx-plan-compare__mobile-group {
      display: block;
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 14px 0 6px;
      color: #ff6200;
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .lx-plan-compare__mobile-list .lx-plan-compare__mark {
      width: 21px;
      height: 21px;
      font-size: 0.68rem;
    }
  }

  .lx-plan-compare__footer {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .lx-plan-compare__quiz {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: min(100%, 420px);
    text-decoration: none;
    color: #0a0a0a;
    background: #ff6200;
    border-radius: 999px;
    padding: 14px 18px;
    text-align: center;
  }
  .lx-plan-compare__quiz-main {
    font-size: 0.95rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }
  .lx-plan-compare__quiz-sub {
    font-size: 0.75rem;
    opacity: 0.72;
  }
  .lx-plan-compare__note {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: #ffb07a;
    line-height: 1.25;
    text-align: center;
    max-width: 9.5em;
  }
  .lx-plan-compare__home {
    color: rgba(245,245,245,0.55);
    font-size: 0.88rem;
    text-decoration: none;
  }
</style>

{% schema %}
{
  "name": "LURVOX plan compare",
  "tag": "section",
  "class": "section-lx-plan-compare",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare plans" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Fat loss starts you. Recomp adds muscle. Aesthetic is the full stack." },
    { "type": "textarea", "id": "subheadline", "label": "Subheadline", "default": "Every fuller goal includes everything below it. Weekly coach phone call is aesthetic / 12 months only." },
    { "type": "text", "id": "col_1_label", "label": "Column 1 label", "default": "Fat loss" },
    { "type": "text", "id": "col_1_price", "label": "Column 1 price", "default": "₹999" },
    { "type": "text", "id": "col_1_link", "label": "Column 1 link", "default": "https://app.lurvox.in/plans/3-months" },
    { "type": "text", "id": "col_2_label", "label": "Column 2 label", "default": "Fat loss + muscle" },
    { "type": "text", "id": "col_2_price", "label": "Column 2 price", "default": "₹1,699" },
    { "type": "text", "id": "col_2_link", "label": "Column 2 link", "default": "https://app.lurvox.in/plans/6-months" },
    { "type": "text", "id": "col_3_label", "label": "Column 3 label", "default": "Aesthetic body" },
    { "type": "text", "id": "col_3_price", "label": "Column 3 price", "default": "₹2,999" },
    { "type": "text", "id": "col_3_link", "label": "Column 3 link", "default": "https://app.lurvox.in/plans/12-months" },
    { "type": "text", "id": "find_url", "label": "Find plan quiz URL", "default": "/pages/find-your-plan" },
    { "type": "text", "id": "home_url", "label": "Home plans URL", "default": "/#plans" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Group heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Coaching rhythm" }
      ]
    },
    {
      "type": "row",
      "name": "Feature row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Personal workout plan" },
        { "type": "checkbox", "id": "plan_3", "label": "3 months", "default": true },
        { "type": "text", "id": "plan_3_text", "label": "3 months text (overrides tick)" },
        { "type": "checkbox", "id": "plan_6", "label": "6 months", "default": true },
        { "type": "text", "id": "plan_6_text", "label": "6 months text (overrides tick)" },
        { "type": "checkbox", "id": "plan_12", "label": "12 months", "default": true },
        { "type": "text", "id": "plan_12_text", "label": "12 months text (overrides tick)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LURVOX plan compare",
      "blocks": [
        { "type": "heading", "settings": { "heading": "Opens with 3 months" } },
        { "type": "row", "settings": { "feature": "Best for", "plan_3": true, "plan_6": true, "plan_12": true, "plan_3_text": "Looking lean for a big day. Not recommended for long-term results.", "plan_6_text": "Advanced athletes already under 12% body fat, with good muscle.", "plan_12_text": "Beginners and intermediates who have plateaued, or want to start fresh." } },
        { "type": "row", "settings": { "feature": "Core coaching (workout, diet, coach, 2 check ins, trackers, photos)", "plan_3": true, "plan_6": true, "plan_12": true } },
        { "type": "row", "settings": { "feature": "Plan updates", "plan_3": true, "plan_6": true, "plan_12": true, "plan_3_text": "Every 14 days", "plan_6_text": "Every week", "plan_12_text": "Every week" } },
        { "type": "heading", "settings": { "heading": "More with 6 months" } },
        { "type": "row", "settings": { "feature": "Fuller stack (weekly updates, cardio, supplements, journey, plateau coaching)", "plan_3": false, "plan_6": true, "plan_12": true } },
        { "type": "heading", "settings": { "heading": "Everything with 12 months" } },
        { "type": "row", "settings": { "feature": "Weekly coach phone call", "plan_3": false, "plan_6": false, "plan_12": true } },
