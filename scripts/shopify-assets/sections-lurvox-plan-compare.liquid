{% comment %} Plan picker + short what-you-get table. {% endcomment %}
<section class="lx-pick" id="compare-plans">
  <div class="lx-pick__inner">
    <p class="lx-pick__eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="lx-pick__title">{{ section.settings.headline }}</h1>
    {% if section.settings.subheadline != blank %}
      <p class="lx-pick__sub">{{ section.settings.subheadline }}</p>
    {% endif %}

    <div class="lx-pick__table-wrap" role="region" aria-label="What each plan includes">
      <table class="lx-pick__table">
        <thead>
          <tr>
            <th scope="col">What you get</th>
            <th scope="col">
              <span>{{ section.settings.col_1_duration }}</span>
              <strong>{{ section.settings.col_1_price }}</strong>
            </th>
            <th scope="col">
              <span>{{ section.settings.col_2_duration }}</span>
              <strong>{{ section.settings.col_2_price }}</strong>
            </th>
            <th scope="col" class="is-best">
              <em>Best</em>
              <span>{{ section.settings.col_3_duration }}</span>
              <strong>{{ section.settings.col_3_price }}</strong>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Personal workout + diet</th>
            <td><span class="lx-pick__yes" aria-label="Included">✓</span></td>
            <td><span class="lx-pick__yes" aria-label="Included">✓</span></td>
            <td class="is-best"><span class="lx-pick__yes" aria-label="Included">✓</span></td>
          </tr>
          <tr>
            <th scope="row">1-to-1 coaching, chat, weekly check-ins</th>
            <td><span class="lx-pick__yes" aria-label="Included">✓</span></td>
            <td><span class="lx-pick__yes" aria-label="Included">✓</span></td>
            <td class="is-best"><span class="lx-pick__yes" aria-label="Included">✓</span></td>
          </tr>
          <tr>
            <th scope="row">Daily trackers + progress photos</th>
            <td><span class="lx-pick__yes" aria-label="Included">✓</span></td>
            <td><span class="lx-pick__yes" aria-label="Included">✓</span></td>
            <td class="is-best"><span class="lx-pick__yes" aria-label="Included">✓</span></td>
          </tr>
          <tr>
            <th scope="row">Plan updates</th>
            <td>14 days</td>
            <td>Weekly</td>
            <td class="is-best">Weekly</td>
          </tr>
          <tr>
            <th scope="row">Weekly coach phone call</th>
            <td><span class="lx-pick__no" aria-label="Not included">—</span></td>
            <td><span class="lx-pick__no" aria-label="Not included">—</span></td>
            <td class="is-best"><span class="lx-pick__yes" aria-label="Included">✓</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="lx-pick__grid">
      <article class="lx-pick__card">
        <h2>{{ section.settings.col_1_label }}</h2>
        <p class="lx-pick__len">{{ section.settings.col_1_duration }}</p>
        <p class="lx-pick__price">{{ section.settings.col_1_price }}</p>
        {% if section.settings.col_1_note != blank %}
          <p class="lx-pick__note">{{ section.settings.col_1_note }}</p>
        {% endif %}
        <a href="{{ section.settings.col_1_link }}">Start</a>
      </article>
      <article class="lx-pick__card">
        <h2>{{ section.settings.col_2_label }}</h2>
        <p class="lx-pick__len">{{ section.settings.col_2_duration }}</p>
        <p class="lx-pick__price">{{ section.settings.col_2_price }}</p>
        {% if section.settings.col_2_note != blank %}
          <p class="lx-pick__note">{{ section.settings.col_2_note }}</p>
        {% endif %}
        <a href="{{ section.settings.col_2_link }}">Start</a>
      </article>
      <article class="lx-pick__card is-best">
        <p class="lx-pick__rec">Recommended</p>
        <h2>{{ section.settings.col_3_label }}</h2>
        <p class="lx-pick__len">{{ section.settings.col_3_duration }}</p>
        <p class="lx-pick__price">{{ section.settings.col_3_price }}</p>
        {% if section.settings.col_3_note != blank %}
          <p class="lx-pick__note">{{ section.settings.col_3_note }}</p>
        {% endif %}
        <a class="is-best" href="{{ section.settings.col_3_link }}">Start</a>
      </article>
    </div>

    <p class="lx-pick__help">
      Not sure?
      <a href="{{ section.settings.find_url | default: '/pages/choose-your-plan' }}">Find your plan</a>
    </p>
  </div>
</section>

<style>
  .lx-pick {
    padding: 40px 16px 56px;
    background: #050505;
    color: #fff;
  }
  .lx-pick__inner {
    max-width: 920px;
    margin: 0 auto;
  }
  .lx-pick__eyebrow {
    margin: 0 0 8px;
    color: #ff6200;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .lx-pick__title {
    margin: 0 0 8px;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }
  .lx-pick__sub {
    margin: 0 0 18px;
    max-width: 34em;
    color: rgba(255,255,255,0.68);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .lx-pick__table-wrap {
    margin: 0 0 20px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid rgba(255, 98, 0, 0.32);
    border-radius: 16px;
    background: #0b0b0b;
  }
  .lx-pick__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .lx-pick__table th,
  .lx-pick__table td {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .lx-pick__table thead th {
    padding: 11px 4px 10px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-align: center;
    vertical-align: bottom;
  }
  .lx-pick__table thead th:first-child,
  .lx-pick__table tbody th {
    width: 34%;
    text-align: left;
  }
  .lx-pick__table thead th span,
  .lx-pick__table thead th strong,
  .lx-pick__table thead th em {
    display: block;
  }
  .lx-pick__table thead th em {
    margin-bottom: 3px;
    color: #ff6200;
    font-size: 0.52rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .lx-pick__table thead th strong {
    margin-top: 3px;
    color: #ff6200;
    font-size: 0.78rem;
    letter-spacing: -0.02em;
  }
  .lx-pick__table tbody th {
    padding: 10px 6px 10px 10px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .lx-pick__table tbody td {
    padding: 10px 3px;
    text-align: center;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.64rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .lx-pick__table tbody tr:last-child th,
  .lx-pick__table tbody tr:last-child td {
    border-bottom: 0;
  }
  .lx-pick__table .is-best {
    background: rgba(255, 98, 0, 0.08);
  }
  .lx-pick__yes,
  .lx-pick__no {
    display: inline-grid;
    width: 18px;
    height: 18px;
    place-items: center;
    border-radius: 5px;
    font-size: 0.65rem;
    font-weight: 900;
    line-height: 1;
  }
  .lx-pick__yes {
    background: #20b86a;
    color: #fff;
  }
  .lx-pick__no {
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: rgba(255, 255, 255, 0.45);
  }
  .lx-pick__grid {
    display: grid;
    gap: 12px;
  }
  .lx-pick__card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 16px 16px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
    background: #0b0b0b;
  }
  .lx-pick__card.is-best {
    border-color: rgba(255, 98, 0, 0.55);
    background:
      radial-gradient(ellipse 80% 80% at 100% 0%, rgba(255, 98, 0, 0.16), transparent 55%),
      #0d0b09;
  }
  .lx-pick__rec {
    margin: 0 0 4px;
    color: #ff6200;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .lx-pick__card h2 {
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .lx-pick__len {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin: 6px 0 0;
    padding: 4px 10px;
    border-radius: 999px;
    background: #ff6200;
    color: #140900;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .lx-pick__price {
    margin: 8px 0 2px;
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .lx-pick__note {
    margin: 0 0 12px;
    color: rgba(255,255,255,0.7);
    font-size: 0.88rem;
    line-height: 1.35;
  }
  .lx-pick__card a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: auto;
    padding: 0 16px;
    border: 1px solid #ff6200;
    border-radius: 999px;
    background: #ff6200;
    color: #140900 !important;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none !important;
  }
  .lx-pick__card a.is-best {
    background: #ff6200;
    border-color: #ff6200;
    color: #140900 !important;
  }
  .lx-pick__help {
    margin: 20px 0 0;
    color: rgba(255,255,255,0.58);
    font-size: 0.9rem;
    text-align: center;
  }
  .lx-pick__help a {
    color: #ff8a3d !important;
    font-weight: 700;
    text-decoration: none !important;
  }
  @media screen and (min-width: 750px) {
    .lx-pick {
      padding: 52px 24px 72px;
    }
    .lx-pick__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    .lx-pick__table thead th {
      padding: 14px 10px 12px;
      font-size: 0.72rem;
    }
    .lx-pick__table thead th strong {
      font-size: 0.95rem;
    }
    .lx-pick__table tbody th {
      padding: 12px 12px 12px 14px;
      font-size: 0.82rem;
    }
    .lx-pick__table tbody td {
      padding: 12px 8px;
      font-size: 0.74rem;
    }
    .lx-pick__yes,
    .lx-pick__no {
      width: 22px;
      height: 22px;
      font-size: 0.75rem;
    }
  }
</style>

{% schema %}
{
  "name": "LURVOX plan compare",
  "tag": "section",
  "class": "section-lx-plan-compare",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Plans" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "3, 6, or 12 months" },
    { "type": "textarea", "id": "subheadline", "label": "Subheadline", "default": "Workout, diet, and 1-to-1 coaching on every plan. Weekly phone call on 12 months only." },
    { "type": "textarea", "id": "callout", "label": "Unused callout" },
    { "type": "text", "id": "col_1_label", "label": "Column 1 label", "default": "Fat loss" },
    { "type": "text", "id": "col_1_duration", "label": "Column 1 duration", "default": "3 months" },
    { "type": "text", "id": "col_1_price", "label": "Column 1 price", "default": "₹599" },
    { "type": "text", "id": "col_1_note", "label": "Column 1 note", "default": "90-day fat loss" },
    { "type": "text", "id": "col_1_link", "label": "Column 1 link", "default": "https://app.lurvox.in/plans/3-months" },
    { "type": "text", "id": "col_2_label", "label": "Column 2 label", "default": "Fat loss + muscle gain" },
    { "type": "text", "id": "col_2_duration", "label": "Column 2 duration", "default": "6 months" },
    { "type": "text", "id": "col_2_price", "label": "Column 2 price", "default": "₹999" },
    { "type": "text", "id": "col_2_note", "label": "Column 2 note", "default": "Lose fat and build muscle" },
    { "type": "text", "id": "col_2_link", "label": "Column 2 link", "default": "https://app.lurvox.in/plans/6-months" },
    { "type": "text", "id": "col_3_label", "label": "Column 3 label", "default": "Athletic body" },
    { "type": "text", "id": "col_3_duration", "label": "Column 3 duration", "default": "12 months" },
    { "type": "text", "id": "col_3_price", "label": "Column 3 price", "default": "₹1,699" },
    { "type": "text", "id": "col_3_note", "label": "Column 3 note", "default": "Includes a weekly coach phone call" },
    { "type": "text", "id": "col_3_link", "label": "Column 3 link", "default": "https://app.lurvox.in/plans/12-months" },
    { "type": "text", "id": "find_url", "label": "Find plan quiz URL", "default": "/pages/choose-your-plan" },
    { "type": "text", "id": "consult_url", "label": "Talk to a coach URL", "default": "/pages/talk-to-a-coach" },
    { "type": "text", "id": "home_url", "label": "Home plans URL", "default": "/#plans" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Group heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" }
      ]
    },
    {
      "type": "row",
      "name": "Feature row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature" },
        { "type": "checkbox", "id": "plan_3", "label": "3 months", "default": true },
        { "type": "text", "id": "plan_3_text", "label": "3 months text" },
        { "type": "checkbox", "id": "plan_6", "label": "6 months", "default": true },
        { "type": "text", "id": "plan_6_text", "label": "6 months text" },
        { "type": "checkbox", "id": "plan_12", "label": "12 months", "default": true },
        { "type": "text", "id": "plan_12_text", "label": "12 months text" }
      ]
    }
  ],
  "presets": [{ "name": "LURVOX plan compare" }]
}
{% endschema %}
