{% comment %}
  LURVOX — dual floating CTA: Find your plan + Talk to a coach.
  One bar, two actions. Hide each button on its own page.
{% endcomment %}

{%- assign find_url = '/pages/choose-your-plan' -%}
{%- assign talk_url = '/pages/talk-to-a-coach' -%}
{%- assign on_finder = false -%}
{%- assign on_talk = false -%}
{%- if request.page_type == 'page' and page.handle == 'choose-your-plan' -%}
  {%- assign on_finder = true -%}
{%- endif -%}
{%- if request.page_type == 'page' and page.handle == 'talk-to-a-coach' -%}
  {%- assign on_talk = true -%}
{%- endif -%}

{%- unless on_finder and on_talk -%}
  <div class="lx-find-float" data-lx-find-float aria-label="Quick actions">
    <div class="lx-find-float__row">
      {%- unless on_finder -%}
        <a class="lx-find-float__btn lx-find-float__btn--plan" href="{{ find_url }}">
          <span class="lx-find-float__main">
            <span class="lx-find-float__full">Find your plan</span>
            <span class="lx-find-float__short">Find plan</span>
          </span>
          <span class="lx-find-float__sub">Quick quiz · no payment</span>
        </a>
      {%- endunless -%}
      {%- unless on_talk -%}
        <a class="lx-find-float__btn lx-find-float__btn--talk" href="{{ talk_url }}">
          <span class="lx-find-float__main">
            <span class="lx-find-float__full">Talk to a coach</span>
            <span class="lx-find-float__short">Talk</span>
          </span>
          <span class="lx-find-float__sub">Free consult</span>
        </a>
      {%- endunless -%}
    </div>
  </div>

  <style id="lx-find-float-css">
    .lx-find-float {
      position: fixed;
      left: 50%;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      transform: translateX(-50%);
      z-index: 2147483000;
      width: min(560px, calc(100vw - 16px));
      max-width: calc(100vw - 14px);
      pointer-events: none;
      box-sizing: border-box;
    }

    body:has(#PBarNextFrameWrapper) .lx-find-float,
    body:has([id*="PBar"]) .lx-find-float,
    html:has(.preview-bar) .lx-find-float {
      bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    }

    .lx-find-float.is-hidden {
      opacity: 0;
      pointer-events: none !important;
      transform: translateX(-50%) translateY(12px);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .lx-find-float__row {
      pointer-events: none;
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 8px;
      width: 100%;
      align-items: stretch;
    }

    .lx-find-float__row:has(> :only-child) {
      grid-template-columns: 1fr;
    }

    .lx-find-float__btn {
      pointer-events: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      width: 100%;
      min-height: 52px;
      padding: 10px 12px;
      box-sizing: border-box;
      text-align: center;
      text-decoration: none !important;
      border-radius: 14px;
      -webkit-tap-highlight-color: transparent;
    }

    .lx-find-float__btn--plan {
      color: #0a0a0a !important;
      background: linear-gradient(180deg, #ff8a3d 0%, #ff6200 55%, #f05500 100%) !important;
      border: 1px solid rgba(255, 255, 255, 0.18);
      box-shadow:
        0 12px 28px rgba(0, 0, 0, 0.42),
        0 0 0 1px rgba(255, 98, 0, 0.3);
    }

    .lx-find-float__btn--talk {
      color: #f5f5f5 !important;
      background: linear-gradient(180deg, #2a2a2a 0%, #141414 100%) !important;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.38);
    }

    .lx-find-float__main {
      font-size: 0.92rem;
      font-weight: 850;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .lx-find-float__btn--plan .lx-find-float__main { color: #0a0a0a !important; }
    .lx-find-float__btn--talk .lx-find-float__main { color: #f5f5f5 !important; }

    .lx-find-float__full { display: inline; }
    .lx-find-float__short { display: none; }

    .lx-find-float__sub {
      font-size: 0.7rem;
      font-weight: 650;
      white-space: nowrap;
    }

    .lx-find-float__btn--plan .lx-find-float__sub { color: rgba(10, 10, 10, 0.72) !important; }
    .lx-find-float__btn--talk .lx-find-float__sub { color: rgba(245, 245, 245, 0.72) !important; }

    body.lx-has-find-float {
      padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px)) !important;
    }

    .lx-flow:not(.lx-flow--after) {
      display: none !important;
    }

    @media screen and (max-width: 749px) {
      .lx-find-float {
        width: calc(100vw - 12px);
        max-width: calc(100vw - 12px);
        bottom: calc(10px + env(safe-area-inset-bottom, 0px));
      }

      body:has(#PBarNextFrameWrapper) .lx-find-float,
      body:has([id*="PBar"]) .lx-find-float {
        bottom: calc(70px + env(safe-area-inset-bottom, 0px));
      }

      .lx-find-float__row { gap: 7px; }

      .lx-find-float__btn {
        min-height: 50px;
        padding: 9px 10px;
        border-radius: 13px;
      }

      .lx-find-float__main { font-size: 0.86rem; }
      .lx-find-float__sub { font-size: 0.66rem; }
    }

    @media screen and (max-width: 380px) {
      .lx-find-float__full { display: none; }
      .lx-find-float__short { display: inline; }
      .lx-find-float__main { font-size: 0.94rem; }
      .lx-find-float__sub { font-size: 0.64rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      .lx-find-float__btn { transition: none; }
    }
  </style>
  <script>
    (function () {
      function place() {
        var el = document.querySelector('[data-lx-find-float]');
        if (!el) return;
        document.body.classList.add('lx-has-find-float');
        el.classList.remove('is-hidden');
        el.setAttribute('aria-hidden', 'false');

        var bar =
          document.getElementById('PBarNextFrameWrapper') ||
          document.querySelector('[id*="PBar"], .preview-bar, #preview-bar-iframe');
        var gap = 10;
        var lift = 0;
        if (bar) {
          lift = Math.ceil(bar.getBoundingClientRect().height || 64);
        }
        el.style.bottom = 'calc(' + (lift + gap) + 'px + env(safe-area-inset-bottom, 0px))';

        var h = Math.ceil(el.getBoundingClientRect().height || 52);
        var pad = lift + gap + h + 18;
        document.body.style.paddingBottom = 'calc(' + pad + 'px + env(safe-area-inset-bottom, 0px))';
      }

      place();
      window.addEventListener('resize', place);
      window.addEventListener('orientationchange', place);
      setTimeout(place, 300);
      setTimeout(place, 1000);
    })();
  </script>
{%- endunless -%}
