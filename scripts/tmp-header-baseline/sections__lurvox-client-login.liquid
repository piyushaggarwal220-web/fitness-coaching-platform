{%- if section.settings.enabled -%}
  {%- assign show_login = true -%}
  {%- if section.settings.homepage_only and request.page_type != 'index' -%}
    {%- assign show_login = false -%}
  {%- endif -%}

  {%- if show_login -%}
    <aside
      class="lurvox-client-login"
      style="--lurvox-login-accent: {{ section.settings.accent_color }};"
      aria-label="Client account access"
    >
      <div class="lurvox-client-login__inner">
        <span class="lurvox-client-login__prompt">{{ section.settings.prompt }}</span>
        <a class="lurvox-client-login__link" href="{{ section.settings.login_url }}">
          <span>{{ section.settings.label }}</span>
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
            <path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </aside>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
    .lurvox-client-login {
      --lurvox-login-accent: #ff6200;
      width: 100%;
      color: #ffffff;
      background:
        radial-gradient(circle at 76% 0%, color-mix(in srgb, var(--lurvox-login-accent) 16%, transparent), transparent 42%),
        #0b0b0b;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .lurvox-client-login__inner {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      min-height: 52px;
      max-width: 1200px;
      margin: 0 auto;
      padding: 4px max(20px, env(safe-area-inset-right)) 4px max(20px, env(safe-area-inset-left));
      box-sizing: border-box;
    }

    .lurvox-client-login__prompt {
      color: rgba(255, 255, 255, 0.78);
      font-size: 14px;
      font-weight: 500;
      line-height: 1.3;
    }

    .lurvox-client-login__link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 40px;
      padding: 0 17px;
      color: #ffffff;
      background: linear-gradient(180deg, color-mix(in srgb, var(--lurvox-login-accent) 86%, #ffffff) 0%, var(--lurvox-login-accent) 100%);
      border: 1px solid color-mix(in srgb, var(--lurvox-login-accent) 65%, #ffffff);
      border-radius: 999px;
      box-shadow: 0 8px 24px color-mix(in srgb, var(--lurvox-login-accent) 24%, transparent);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1;
      text-decoration: none;
      transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
      -webkit-tap-highlight-color: transparent;
    }

    .lurvox-client-login__link svg {
      width: 18px;
      height: 18px;
      flex: 0 0 18px;
    }

    .lurvox-client-login__link:hover {
      filter: brightness(1.08);
      transform: translateY(-1px);
      box-shadow: 0 10px 28px color-mix(in srgb, var(--lurvox-login-accent) 32%, transparent);
    }

    .lurvox-client-login__link:active {
      transform: translateY(0);
    }

    .lurvox-client-login__link:focus-visible {
      outline: 3px solid #ffffff;
      outline-offset: 2px;
    }

    /* lurvox-login-header-clean-v2 — quiet text strip above logo */
    @media screen and (max-width: 749px) {
      .lurvox-client-login {
        background: #050505;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      }

      .lurvox-client-login__inner {
        justify-content: center;
        gap: 0;
        min-height: 28px;
        padding-block: 5px;
        padding-inline: 16px;
      }

      .lurvox-client-login__prompt {
        display: none;
      }

      .lurvox-client-login__link {
        flex: 0 0 auto;
        width: auto;
        max-width: none;
        min-height: 0;
        padding: 2px 0;
        font-size: 11.5px;
        font-weight: 550;
        letter-spacing: 0.02em;
        border-radius: 0;
        box-shadow: none;
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.62);
      }

      .lurvox-client-login__link span {
        border-bottom: 1px solid rgba(255, 138, 61, 0.45);
        padding-bottom: 1px;
      }

      .lurvox-client-login__link svg {
        width: 12px;
        height: 12px;
        flex-basis: 12px;
        color: rgba(255, 138, 61, 0.85);
      }

      .lurvox-client-login__link:hover {
        filter: none;
        transform: none;
        background: transparent;
        box-shadow: none;
        color: #ff8a3d;
      }
    }

    @media screen and (max-width: 480px) {
      .lurvox-client-login__inner {
        justify-content: center;
      }

      .lurvox-client-login__prompt {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .lurvox-client-login__link {
        transition: none;
      }
    }
{% endstylesheet %}

{% schema %}
{
  "name": "Client login CTA",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show client login",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "homepage_only",
      "label": "Show on homepage only",
      "default": true
    },
    {
      "type": "text",
      "id": "prompt",
      "label": "Prompt",
      "default": "Already training with LURVOX?"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Existing client? Log in"
    },
    {
      "type": "text",
      "id": "login_url",
      "label": "Login URL",
      "default": "https://app.lurvox.in/login"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#FF6200"
    }
  ]
}
{% endschema %}
