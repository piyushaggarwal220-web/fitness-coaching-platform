{% doc %}
  @prompt
    Create a premium mobile-first transformation gallery called:
    
    CLIENT RESULTS
    
    Use ONLY ONE IMAGE per transformation.
    
    The uploaded image already contains BOTH before and after photos inside a single image.
    
    Do NOT create:
    
    • before image field
    • after image field
    • comparison slider
    • split layout
    • dual image containers
    • reveal effects
    
    Each card contains ONE image upload field only.
    
    Display image exactly as uploaded.
    
    Never crop.
    Never zoom.
    Never split.
    
    Never use:
    object-fit: cover;
    
    Use:
    object-fit: contain;
    width: 100%;
    height: auto;
    
    ━━━━━━━━━━━━━━
    
    HEADER
    
    Label:
    REAL CLIENT RESULTS
    
    Headline:
    Built By Consistency.
    
    Subheadline:
    Real people.
    Real transformations.
    Real accountability.
    
    Max width:
    280px
    
    Center aligned.
    
    Typography must fit mobile screens.
    
    No oversized text.
    No clipping.
    No overflow.
    
    ━━━━━━━━━━━━━━
    
    BACKGROUND
    
    Do NOT use plain black.
    
    Base:
    #050505
    
    Add:
    graphite texture:
    rgba(255,255,255,0.015)
    
    orange ambient glow:
    rgba(255,98,0,0.03)
    
    Place glows behind cards only.
    
    No gradients.
    No neon.
    No gaming aesthetics.
    
    Atmosphere must feel expensive and premium.
    
    ━━━━━━━━━━━━━━
    
    CARD DESIGN
    
    Width:
    86vw
    
    Spacing:
    16px
    
    Neighbour cards partially visible.
    
    Enable:
    horizontal swipe
    CSS scroll snap
    
    Card:
    
    background:
    rgba(255,255,255,0.025)
    
    border:
    1px solid rgba(255,255,255,0.06)
    
    radius:
    28px
    
    padding:
    16px
    
    overflow:
    hidden
    
    ━━━━━━━━━━━━━━
    
    IMAGE CONTAINER
    
    Hero element.
    
    Display uploaded image immediately.
    
    No placeholder.
    No empty container.
    No fixed height.
    
    Height adapts automatically to uploaded image.
    
    If image missing:
    hide entire card.
    
    Never show empty black boxes.
    
    ━━━━━━━━━━━━━━
    
    TRANSPARENT ARROWS
    
    Display floating navigation arrows inside the image container.
    
    Arrow position:
    vertically centered.
    
    Left arrow:
    12px from left edge.
    
    Right arrow:
    12px from right edge.
    
    Arrow style:
    
    background:
    rgba(255,255,255,0.08)
    
    backdrop blur:
    20px
    
    border:
    1px solid rgba(255,255,255,0.10)
    
    size:
    48px
    
    radius:
    999px
    
    icon color:
    #FFFFFF
    
    Arrows must feel premium and minimal.
    
    ━━━━━━━━━━━━━━
    
    TOP IMAGE BADGE
    
    Replace:
    
    CLIENT RESULT
    
    With:
    
    BEFORE → AFTER
    
    Badge position:
    top left of image.
    
    Badge style:
    
    background:
    rgba(255,255,255,0.10)
    
    backdrop blur:
    20px
    
    border:
    1px solid rgba(255,255,255,0.16)
    
    height:
    30px
    
    padding:
    0 14px
    
    radius:
    999px
    
    font-size:
    12px
    
    font-weight:
    700
    
    letter spacing:
    0.08em
    
    The badge must feel thin, premium and elegant.
    
    ━━━━━━━━━━━━━━
    
    RESULT HEADLINE
    
    Examples:
    
    Waist Down. Confidence Up.
    Strength Up. Fat Down.
    Built Visible Abs.
    Lean Without Extremes.
    
    Typography:
    
    serif italic
    22px
    Luxury editorial style.
    
    ━━━━━━━━━━━━━━
    
    DESCRIPTION
    
    Maximum:
    2 lines
    
    Examples:
    
    Structured training.
    Predictable progress.
    Consistency replaced guesswork.
    
    Use:
    rgba(255,255,255,0.72)
    
    ━━━━━━━━━━━━━━
    
    CLIENT FOOTER
    
    Left:
    
    Initials inside premium circular avatar.
    
    Under:
    Name
    City
    
    Right:
    
    ✓ Verified Result
    
    Small premium badge.
    
    ━━━━━━━━━━━━━━
    
    ACTIVE CARD
    
    Selected:
    
    scale: 1
    
    border glow:
    rgba(255,98,0,0.12)
    
    Inactive:
    
    opacity: 0.75
    scale: 0.96
    
    ━━━━━━━━━━━━━━
    
    PERFORMANCE
    
    Mobile first.
    iPhone Safari optimized.
    
    No layout shifts.
    No oversized typography.
    No text clipping.
    No image overflow.
    No blank containers.
    
    Hide cards automatically if image upload is missing.
    
    ━━━━━━━━━━━━━━
    
    Final result should feel like a premium fitness campaign rather than a Shopify testimonial section.
    
    Visual inspiration:
    
    Nike × Gymshark × Apple., MAKE BEFORE/AFTER BADGE THIN, REDUCE THE SIDE OF ARROWS AND KEEP THEM OUT OF IMAGE COMTAINER, KEEP TOP AND BOTTOM PADDIN 0x, MAKE BEFORE/AFTER BADGE THIN, REDUCE THE SIDE OF ARROWS AND KEEP THEM OUT OF IMAGE COMTAINER, KEEP TOP AND BOTTOM PADDIN 0x, KEEP TOP AND BOTTOM PADDIN 0x, KEEP THE COLOR THEME OF THE BLOCK SAME AS THE WHOLE WEBSITE
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-client-results-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: #000000;
    position: relative;
    overflow: hidden;
    padding: 0;
  }

  .ai-client-results-header-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    text-align: center;
    margin: 0 auto 32px;
    max-width: 280px;
    padding: 0 20px;
  }

  .ai-client-results-label-{{ ai_gen_id }} {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FF6200;
    margin: 0 0 12px;
  }

  .ai-client-results-headline-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 300;
    font-family: san-serif;
    line-height: 1.1;
    color: rgba(255, 255, 255, 0.81);
    margin: 0 0 12px;
  }

  .ai-client-results-subheadline-{{ ai_gen_id }} {
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 254, 254, 0.81);
    margin: 0;
  }

  .ai-client-results-gallery-wrapper-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    padding-bottom: 0;
  }

  .ai-client-results-gallery-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0 7vw;
  }

  .ai-client-results-gallery-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-client-results-card-{{ ai_gen_id }} {
    flex: 0 0 86vw;
    scroll-snap-align: center;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 28px;
    padding: 16px;
    overflow: visible;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.75;
    transform: scale(0.96);
    position: relative;
  }

  .ai-client-results-card-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1);
    border-color: rgba(0, 0, 0, 0.81);
  }

  .ai-client-results-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    margin-bottom: 20px;
    border-radius: 20px;
    overflow: hidden;
  }

  .ai-client-results-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .ai-client-results-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(255, 255, 255, 0.10);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    height: 22px;
    padding: 0 10px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #ffffff;
    text-transform: uppercase;
    z-index: 2;
  }

  .ai-client-results-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
  }

  .ai-client-results-nav-{{ ai_gen_id }}:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .ai-client-results-nav-left-{{ ai_gen_id }} {
    left: -16px;
  }

  .ai-client-results-nav-right-{{ ai_gen_id }} {
    right: -16px;
  }

  .ai-client-results-nav-{{ ai_gen_id }} svg {
    width: 14px;
    height: 14px;
    stroke: #ffffff;
    stroke-width: 2;
    fill: none;
  }

  .ai-client-results-content-{{ ai_gen_id }} {
    padding: 0 4px;
  }

  .ai-client-results-title-{{ ai_gen_id }} {
    font-size: 22px;
    font-style: italic;
    line-height: 1.3;
    color: rgba(255, 254, 254, 0.81);
    margin: 0 0 12px;
    font-family: Georgia, serif;
  }

  .ai-client-results-description-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 254, 254, 0.81);
    margin: 0 0 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-client-results-footer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ai-client-results-client-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-client-results-avatar-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: rgba(255, 254, 254, 0.81);
    flex-shrink: 0;
  }

  .ai-client-results-client-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-client-results-client-name-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 254, 254, 0.81);
    line-height: 1.2;
  }

  .ai-client-results-client-city-{{ ai_gen_id }} {
    font-size: 12px;
    color: rgba(255, 254, 254, 0.81);
    line-height: 1.2;
  }

  .ai-client-results-verified-{{ ai_gen_id }} {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 999px;
    padding: 6px 12px;
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 254, 254, 0.81);
    flex-shrink: 0;
  }

  .ai-client-results-verified-{{ ai_gen_id }}::before {
    content: '✓';
    font-size: 12px;
    font-weight: 700;
  }
{% endstyle %}

<client-results-{{ ai_gen_id }} class="ai-client-results-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-client-results-header-{{ ai_gen_id }}">
    <div class="ai-client-results-label-{{ ai_gen_id }}">Transformations</div>
    <h2 class="ai-client-results-headline-{{ ai_gen_id }}">7,000+ People Have Already Transformed with LURVOX</h2>
    <p class="ai-Real peopleclient-results-subheadline-{{ ai_gen_id }}">
    </p>
  </div>

  <div class="ai-client-results-gallery-wrapper-{{ ai_gen_id }}">
    <div class="ai-client-results-gallery-{{ ai_gen_id }}" data-gallery>
      {% for i in (1..25) %}
        {% liquid
          assign image_key = 'transformation_image_' | append: i
          assign title_key = 'result_title_' | append: i
          assign description_key = 'description_' | append: i
          assign initials_key = 'client_initials_' | append: i
          assign name_key = 'client_name_' | append: i
          assign city_key = 'client_city_' | append: i

          assign transformation_image = block.settings[image_key]
          assign result_title = block.settings[title_key]
          assign description = block.settings[description_key]
          assign client_initials = block.settings[initials_key]
          assign client_name = block.settings[name_key]
          assign client_city = block.settings[city_key]
        %}

        {% if transformation_image != blank %}
          <div class="ai-client-results-card-{{ ai_gen_id }}" data-card>
            <button class="ai-client-results-nav-{{ ai_gen_id }} ai-client-results-nav-left-{{ ai_gen_id }}" data-nav="prev" aria-label="Previous">
              <svg viewBox="0 0 24 24">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            
            <button class="ai-client-results-nav-{{ ai_gen_id }} ai-client-results-nav-right-{{ ai_gen_id }}" data-nav="next" aria-label="Next">
              <svg viewBox="0 0 24 24">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>

            <div class="ai-client-results-image-container-{{ ai_gen_id }}">
              <div class="ai-client-results-badge-{{ ai_gen_id }}">Before → After</div>
              
              <img
                src="{{ transformation_image | image_url: width: 800 }}"
                alt="{{ result_title | escape }}"
                class="ai-client-results-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ transformation_image.width }}"
                height="{{ transformation_image.height }}"
              >
            </div>

            <div class="ai-client-results-content-{{ ai_gen_id }}">
              {% if result_title != blank %}
                <h3 class="ai-client-results-title-{{ ai_gen_id }}">{{ result_title }}</h3>
              {% endif %}

              {% if description != blank %}
                <p class="ai-client-results-description-{{ ai_gen_id }}">{{ description }}</p>
              {% endif %}

              <div class="ai-client-results-footer-{{ ai_gen_id }}">
                <div class="ai-client-results-client-{{ ai_gen_id }}">
                  <div class="ai-client-results-avatar-{{ ai_gen_id }}">
                    {% if client_initials != blank %}
                      {{ client_initials }}
                    {% else %}
                      ?
                    {% endif %}
                  </div>
                  <div class="ai-client-results-client-info-{{ ai_gen_id }}">
                    {% if client_name != blank %}
                      <div class="ai-client-results-client-name-{{ ai_gen_id }}">{{ client_name }}</div>
                    {% endif %}
                    {% if client_city != blank %}
                      <div class="ai-client-results-client-city-{{ ai_gen_id }}">{{ client_city }}</div>
                    {% endif %}
                  </div>
                </div>
                <div class="ai-client-results-verified-{{ ai_gen_id }}">Verified Result</div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</client-results-{{ ai_gen_id }}>

<script>
  (function() {
    class ClientResults{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.gallery = this.querySelector('[data-gallery]');
        this.cards = this.querySelectorAll('[data-card]');
        this.navButtons = this.querySelectorAll('[data-nav]');

        if (!this.gallery || this.cards.length === 0) return;

        this.setupIntersectionObserver();
        this.setupNavigation();
      }

      setupIntersectionObserver() {
        const options = {
          root: this.gallery,
          threshold: 0.6
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.cards.forEach((card) => card.classList.remove('active'));
              entry.target.classList.add('active');
            }
          });
        }, options);

        this.cards.forEach((card) => observer.observe(card));
      }

      setupNavigation() {
        this.navButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            e.preventDefault();
            const direction = button.dataset.nav;
            this.navigate(direction);
          });
        });
      }

      navigate(direction) {
        const activeCard = this.querySelector('[data-card].active');
        if (!activeCard) return;

        const currentIndex = Array.from(this.cards).indexOf(activeCard);
        let nextIndex;

        if (direction === 'next') {
          nextIndex = currentIndex + 1 >= this.cards.length ? 0 : currentIndex + 1;
        } else {
          nextIndex = currentIndex - 1 < 0 ? this.cards.length - 1 : currentIndex - 1;
        }

        const nextCard = this.cards[nextIndex];
        if (nextCard) {
          nextCard.scrollIntoView({
            behavior: 'smooth',
            block: 'nearest',
            inline: 'center'
          });
        }
      }
    }

    customElements.define('client-results-{{ ai_gen_id }}', ClientResults{{ ai_gen_id }});
  })();
</script>

